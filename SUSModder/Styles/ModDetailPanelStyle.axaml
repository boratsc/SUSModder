<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <LinearGradientBrush x:Key="ModDetailBorderGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#663B9EFF" Offset="0"/>
            <GradientStop Color="#402A4A6B" Offset="0.45"/>
            <GradientStop Color="#553D4A63" Offset="1"/>
        </LinearGradientBrush>
    </Styles.Resources>

    <Style Selector="Border.mod-detail-host">
        <Setter Property="Margin" Value="0,10,10,10"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModDetailBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="CornerRadius" Value="12,0,0,12"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BoxShadow" Value="-4 4 24 0 #30000000"/>
    </Style>

    <Style Selector="Border.mod-detail-panel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,14,16,16"/>
    </Style>

    <Style Selector="Border.mod-detail-glass-shine">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>

    <Style Selector="Border.mod-detail-header">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModDetailBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="BoxShadow" Value="0 2 12 0 #28000000"/>
    </Style>

    <Style Selector="TextBlock.inspector-section-title">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,4,0,6"/>
    </Style>

    <Style Selector="Border.mod-detail-section">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="Ellipse.mod-detail-icon-glow">
        <Setter Property="Fill" Value="#1A3B9EFF"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Border.mod-detail-sticky-cta">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Button.inspector-expander-header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.inspector-expander-header:pointerover">
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style Selector="SplitButton.mod-detail-split">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.mod-detail-action-tile">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,10"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.mod-detail-action-tile:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button.mod-detail-action-tile:pressed">
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <Style Selector="Button.mod-detail-action-tile.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style Selector="Border.mod-detail-version-flyout">
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="BoxShadow" Value="0 8 28 0 #40000000"/>
    </Style>

    <!-- Domyślny chrome FlyoutPresenter (szare tło) — wyłączony; styluje tylko Border.mod-detail-version-flyout -->
    <Style Selector="FlyoutPresenter.mod-detail-version-flyout-presenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="FlyoutPresenter.mod-detail-version-flyout-presenter /template/ Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="Button.mod-detail-version-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.mod-detail-version-item:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style Selector="Button.mod-detail-version-item:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

</Styles>
