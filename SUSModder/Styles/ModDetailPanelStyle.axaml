<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <LinearGradientBrush x:Key="ModDetailBorderGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#663B9EFF" Offset="0"/>
            <GradientStop Color="#402A4A6B" Offset="0.45"/>
            <GradientStop Color="#553D4A63" Offset="1"/>
        </LinearGradientBrush>
    </Styles.Resources>

    <Style Selector="Border.mod-detail-host">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModDetailBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
        <Setter Property="CornerRadius" Value="12,0,0,12"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BoxShadow" Value="-4 4 24 0 #30000000"/>
    </Style>

    <Style Selector="Border.mod-detail-panel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,14,16,16"/>
    </Style>

    <Style Selector="Border.mod-detail-glass-shine">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>

    <Style Selector="Border.mod-detail-header">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModDetailBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="BoxShadow" Value="0 2 12 0 #28000000"/>
    </Style>

    <Style Selector="Border.mod-detail-section">
        <Setter Property="Background" Value="{DynamicResource SurfaceGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="Ellipse.mod-detail-icon-glow">
        <Setter Property="Fill" Value="#1A3B9EFF"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

</Styles>
