<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4.0: dolny pasek statusu usunięty (status API/dysku/modów w menu „Więcej”).
         Zostają style współdzielone: przycisk zamykania modali i overlay/card modali. -->

    <Style Selector="Button.statusbar-toggle-button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.statusbar-toggle-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
    </Style>

    <Style Selector="Border.tool-modal-overlay">
        <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.tool-modal-card">
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="760"/>
        <Setter Property="MaxWidth" Value="860"/>
        <Setter Property="MaxHeight" Value="700"/>
        <Setter Property="MinHeight" Value="280"/>
        <Setter Property="BoxShadow" Value="0 12 32 0 #60000000"/>
    </Style>

</Styles>
