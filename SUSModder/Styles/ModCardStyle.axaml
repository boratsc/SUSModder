<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SUSModder.Converters">

    <!-- Konwertery potrzebne dla stylu karty moda -->
    <Styles.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
    </Styles.Resources>

    <!-- Styl dla pojedynczej karty moda -->
    <Style Selector="Border.mod-card">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="140"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RenderTransform" Value="scale(1.0)"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #20000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                    <TransformOperationsTransition.Easing>
                        <CubicEaseOut/>
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>

    <!-- Styl dla ikony moda w karcie -->
    <Style Selector="Image.mod-icon">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Styl dla nazwy moda w karcie -->
    <Style Selector="TextBlock.mod-name">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Style dla zaznaczonego elementu w ListBox -->
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Gdy element jest zaznaczony (selected) -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Border wewnątrz zaznaczonego ListBoxItem -->
    <Style Selector="ListBoxItem:selected Border.mod-card">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="BoxShadow" Value="0 0 15 2 #80FF6B6B"/>
    </Style>

    <!-- Hover effect dla karty moda -->
    <Style Selector="ListBoxItem:pointerover Border.mod-card">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="RenderTransform" Value="scale(1.03)"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
    </Style>

</Styles>
