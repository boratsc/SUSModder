<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styl dla przycisków w menu bocznym (SplitView.Pane) -->
    <Style Selector="Button.menu-button">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Styl dla przycisku hamburger menu -->
    <Style Selector="Button.hamburger-button">
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Styl dla ikony i tekstu w przycisku menu -->
    <Style Selector="StackPanel.menu-item">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <!-- Styl dla ikony emoji w menu -->
    <Style Selector="TextBlock.menu-icon">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Styl dla tekstu w menu -->
    <Style Selector="TextBlock.menu-text">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
