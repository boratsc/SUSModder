<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styl dla przycisków w menu bocznym (SplitView.Pane) -->
    <Style Selector="Button.menu-button">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Styl dla przycisku menu w stanie pressed -->
    <Style Selector="Button.menu-button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
    </Style>

    <!-- Styl dla przycisku menu w stanie disabled -->
    <Style Selector="Button.menu-button:disabled">
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Cursor" Value="No"/>
    </Style>

    <!-- Styl dla przycisku hamburger menu -->
    <Style Selector="Button.hamburger-button">
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Hamburger button pressed state -->
    <Style Selector="Button.hamburger-button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
    </Style>

    <!-- Hamburger button disabled state -->
    <Style Selector="Button.hamburger-button:disabled">
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Cursor" Value="No"/>
    </Style>

    <!-- Styl dla ikony i tekstu w przycisku menu -->
    <Style Selector="StackPanel.menu-item">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <!-- Styl dla ikony emoji w menu -->
    <Style Selector="TextBlock.menu-icon">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Styl dla tekstu w menu -->
    <Style Selector="TextBlock.menu-text">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
