<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:converters="using:SUSModder.Converters"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:SUSModder.Behaviors"
             x:Class="SUSModder.Controls.PackInstanceCard"
             x:DataType="vm:ModInstanceItem"
             x:CompileBindings="False"
             ToolTip.ShowDelay="300">
    <UserControl.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
    </UserControl.Resources>

    <Border Classes="browser-card mod-card"
            Classes.bulk-checked="{Binding IsCheckedForBulk}">
        <i:Interaction.Behaviors>
            <behaviors:DoubleClickBehavior
                DoubleClickCommand="{Binding $parent[Window].DataContext.PackInstanceDoubleClickCommand}"
                CommandParameter="{Binding}"
                DoubleClickInterval="300"/>
        </i:Interaction.Behaviors>

        <Panel>
            <Border Classes="browser-card-shine"/>
            <Grid RowDefinitions="*,3">
            <Border Width="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource SelectionBarBrush}"
                    CornerRadius="12,0,0,12"
                    IsVisible="False"
                    Classes="browser-selection-bar"
                    Grid.RowSpan="2"/>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Image Grid.Column="0"
                       Classes="browser-card-icon"
                       Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="browser-card-title" Text="{Binding DisplayName}"/>
                    <Button Classes="browser-card-primary"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SuccessBrush}"
                            Content="{loc:Localize UI.Buttons.Launch}"
                            Command="{Binding $parent[Window].DataContext.PackInstanceDoubleClickCommand}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Classes="browser-card-subtitle" Text="{Binding Subtitle}"/>
                    <TextBlock Classes="browser-card-meta" Text="{Binding ContentsSummary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="6" HorizontalAlignment="Right">
                    <CheckBox IsChecked="{Binding IsCheckedForBulk}"
                              IsVisible="{Binding $parent[Window].DataContext.IsBulkSelectionMode}"
                              IsEnabled="{Binding IsBulkEligible}"
                              VerticalAlignment="Top"/>
                    <Border Classes="browser-type-badge browser-status-badge-update"
                            IsVisible="{Binding ShowStatusUpdate}">
                        <TextBlock Classes="browser-type-badge-text"
                                   Text="{loc:Localize UI.ModStatus.UpdateAvailable}"/>
                    </Border>
                    <Border Classes="browser-type-badge browser-status-badge-installed"
                            IsVisible="{Binding ShowStatusInstalled}">
                        <TextBlock Classes="browser-type-badge-text"
                                   Text="{loc:Localize UI.ModStatus.Installed}"/>
                    </Border>
                    <Panel Width="10" Height="10">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource StatusBusyBrush}"
                                 IsVisible="{Binding ShowStatusBusy}"/>
                    </Panel>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="3"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Margin="0,6,0,0"
                         CornerRadius="2"
                         Background="#30FFFFFF"
                         Foreground="{DynamicResource StatusBusyBrush}"
                         IsVisible="{Binding IsBusy}"/>
            </Grid>
        </Panel>
    </Border>
</UserControl>
