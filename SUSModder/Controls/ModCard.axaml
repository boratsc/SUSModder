<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:converters="using:SUSModder.Converters"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:SUSModder.Behaviors"
             x:Class="SUSModder.Controls.ModCard"
             x:DataType="vm:ModItem"
             x:CompileBindings="False"
             ToolTip.ShowDelay="300">
    <UserControl.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
    </UserControl.Resources>

    <Border Classes="browser-card mod-card"
            Classes.bulk-checked="{Binding IsCheckedForBulk}">
        <i:Interaction.Behaviors>
            <behaviors:DoubleClickBehavior
                DoubleClickCommand="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
                CommandParameter="{Binding}"
                DoubleClickInterval="300"/>
        </i:Interaction.Behaviors>

        <Panel>
            <Border Classes="browser-card-shine"/>
            <Grid RowDefinitions="*,3">
            <Border Width="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource SelectionBarBrush}"
                    CornerRadius="12,0,0,12"
                    IsVisible="False"
                    Classes="browser-selection-bar"
                    Grid.RowSpan="2"/>

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Panel Grid.Column="0" Width="52" Height="52">
                    <Image Classes="browser-card-icon"
                           Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
                           Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
                </Panel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Classes="browser-card-title"
                               Text="{Binding Name}"
                               Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
                    <Button Classes="browser-card-primary"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SuccessBrush}"
                            Content="{loc:Localize UI.Buttons.Launch}"
                            IsVisible="{Binding IsInstalled}"
                            Command="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="browser-card-primary"
                            HorizontalAlignment="Left"
                            Content="{loc:Localize UI.Buttons.Install}"
                            IsVisible="{Binding CanInstall}"
                            Command="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Classes="browser-card-subtitle"
                               Text="{Binding BrowserSubtitle}"/>
                    <TextBlock Classes="browser-card-meta"
                               Text="{Binding Description}"
                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="6" HorizontalAlignment="Right">
                    <CheckBox IsChecked="{Binding IsCheckedForBulk}"
                              IsVisible="{Binding $parent[Window].DataContext.IsBulkSelectionMode}"
                              IsEnabled="{Binding IsBulkEligible}"
                              VerticalAlignment="Top"/>
                    <Border Classes="browser-type-badge">
                        <TextBlock Classes="browser-type-badge-text"
                                   Text="{Binding TypeBadge}"/>
                    </Border>
                    <Panel Width="10" Height="10">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource StatusBusyBrush}"
                                 IsVisible="{Binding ShowStatusBusy}"/>
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource StatusUpdateBrush}"
                                 IsVisible="{Binding ShowStatusUpdate}"/>
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource StatusInstalledBrush}"
                                 IsVisible="{Binding ShowStatusInstalled}"/>
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource StatusNotInstalledBrush}"
                                 IsVisible="{Binding ShowStatusNotInstalled}"/>
                    </Panel>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="3"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding InstallProgress}"
                         Margin="0,6,0,0"
                         CornerRadius="2"
                         Background="#30FFFFFF"
                         Foreground="{DynamicResource StatusBusyBrush}"
                         IsVisible="{Binding IsInstalling}"/>
            </Grid>
        </Panel>
    </Border>
</UserControl>
