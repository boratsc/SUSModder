<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SUSModder"
             x:Class="SUSModder.App"
             RequestedThemeVariant="Dark">
	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>
	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="/Styles/ScrollViewerStyles.axaml"/>
		<StyleInclude Source="/Styles/AnimationStyles.axaml"/>
		<StyleInclude Source="/Styles/ListBoxStyles.axaml"/>
		<StyleInclude Source="/Styles/LinkButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/FabButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/TooltipStyle.axaml"/>
		<StyleInclude Source="/Controls/SkeletonCard.axaml"/>

		<!-- Flyouty są poza drzewem MainWindow — styl presenterów musi być globalny -->
		<Style Selector="FlyoutPresenter.mod-detail-version-flyout-presenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="FlyoutPresenter.mod-detail-version-flyout-presenter /template/ Border#LayoutRoot">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="BoxShadow" Value="none"/>
		</Style>
		<Style Selector="FlyoutPresenter.mod-detail-version-flyout-presenter /template/ Border">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BoxShadow" Value="none"/>
		</Style>
	</Application.Styles>
</Application>