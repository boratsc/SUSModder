<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.ChangelogDialog"
        Title="{loc:Localize Changelog.WindowTitle}"
        Width="550" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <FluentTheme />

    <!-- Fade-in dla całego okna -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla ikony/header -->
    <Style Selector="Border.changelog-header-icon">
      <Style.Animations>
        <Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="-20"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla contentu -->
    <Style Selector="StackPanel.content-panel">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Styl dla sekcji changeloga -->
    <Style Selector="Border.changelog-section">
      <Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Styl dla itemu listy -->
    <Style Selector="TextBlock.changelog-item">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
  </Window.Styles>

  <Border Margin="0,30,0,0">
    <Grid Margin="24,10,24,24" RowDefinitions="Auto,Auto,Auto,Auto">

      <!-- Header z ikoną (E6) -->
      <Border Grid.Row="0"
              Classes="modal-icon changelog-header-icon"
              Margin="0,0,0,16">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}"/>
      </Border>

      <!-- Tytuł + subtitle -->
      <StackPanel Grid.Row="1"
                  Classes="content-panel"
                  Spacing="6"
                  Margin="0,0,0,16">
        <StackPanel.RenderTransform>
          <TranslateTransform/>
        </StackPanel.RenderTransform>

        <TextBlock Text="{loc:Localize Changelog.WindowTitle}" Classes="modal-title"/>

        <TextBlock x:Name="VersionDateText" Classes="modal-message" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- Sekcje changeloga (ScrollViewer) -->
      <ScrollViewer Grid.Row="2"
                    MaxHeight="240"
                    Margin="0,0,0,16">
        <StackPanel x:Name="SectionsContainer"
                    Classes="content-panel"
                    Spacing="0">
          <StackPanel.RenderTransform>
            <TranslateTransform/>
          </StackPanel.RenderTransform>
          <!-- Sekcje dodawane dynamicznie z kodu -->
        </StackPanel>
      </ScrollViewer>

      <!-- Przyciski -->
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="12">
        <Button x:Name="CloseButton"
                Classes="modal-primary"
                Content="{loc:Localize Changelog.CloseButton}"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseButtonClick"/>

        <Button x:Name="GitHubButton"
                Classes="modal-secondary"
                Content="{loc:Localize Changelog.GitHubButton}"
                Click="OnGitHubButtonClick"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
