<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             x:Class="SUSModder.Views.ModPackCodeEntryView"
             x:DataType="vm:ModPackCodeEntryViewModel"
             Background="{DynamicResource CardBackgroundBrush}">

	<UserControl.Styles>
		<Style Selector="UserControl">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>

	<Grid Margin="24" RowDefinitions="Auto,Auto,Auto">
		<TextBlock Grid.Row="0"
		           Text="{Binding Prompt}"
		           FontSize="14"
		           Foreground="{DynamicResource TextSecondaryBrush}"
		           TextWrapping="Wrap"
		           Margin="0,0,0,12"/>

		<TextBox Grid.Row="1"
		         Text="{Binding CodeText, Mode=TwoWay}"
		         Watermark="{Binding Placeholder}"
		         FontSize="16"
		         HorizontalAlignment="Stretch"/>

		<StackPanel Grid.Row="2"
		            Orientation="Horizontal"
		            HorizontalAlignment="Center"
		            Spacing="12"
		            Margin="0,20,0,0">
			<Button Content="{Binding CancelButton}"
			        MinWidth="110"
			        Padding="16,10"
			        CornerRadius="8"
			        Command="{Binding CancelCommand}"/>
			<Button Content="{Binding OkButton}"
			        MinWidth="110"
			        Padding="16,10"
			        CornerRadius="8"
			        Background="{DynamicResource AccentBrush}"
			        Foreground="White"
			        BorderThickness="0"
			        Command="{Binding OkCommand}"/>
		</StackPanel>
	</Grid>
</UserControl>
