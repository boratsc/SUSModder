<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.ModPackResultDialog"
        Title="{loc:Localize ModPacks.CreatedTitle}"
        Width="500" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.2" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<Border Margin="0,30,0,0">
		<Grid Margin="24,10,24,24" RowDefinitions="Auto,Auto,Auto,*">
			<TextBlock Grid.Row="0" Text="{loc:Localize ModPacks.CreatedTitle}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

			<StackPanel Grid.Row="1" Spacing="8">
				<TextBlock Text="{loc:Localize ModPacks.PackCodeLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="CodeTextBox" IsReadOnly="True" FontSize="16"/>
				<TextBlock Text="{loc:Localize ModPacks.ShareLinkLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="LinkTextBox" IsReadOnly="True"/>
			</StackPanel>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0">
				<Button Content="{loc:Localize ModPacks.CopyCode}" Click="CopyCode_Click"/>
				<Button Content="{loc:Localize ModPacks.CopyLink}" Click="CopyLink_Click"/>
			</StackPanel>

			<Button Grid.Row="3" Content="{loc:Localize UI.Buttons.Close}" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,16,0,0" Click="CloseButton_Click"/>
		</Grid>
	</Border>
</Window>
