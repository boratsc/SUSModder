<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.VelopackUpdateDialog"
        Title="{loc:Localize Updates.UpdateAvailable}"
        Width="550" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <FluentTheme />

    <!-- Animacja fade-in dla całego okna -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla ikony -->
    <Style Selector="Border.update-icon">
      <Style.Animations>
        <Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="-20"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla contentu -->
    <Style Selector="StackPanel.content-panel">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <!-- E6 / makieta 10: ikona + tytuł + zdanie, GOLD „Aktualizuj” + outlined „Później”.
       Wersje pod „Szczegóły”; pasek postępu pobierania zawsze widoczny. -->
  <Border Margin="0,30,0,0">
    <Grid Margin="30,10,30,24" RowDefinitions="Auto,*,Auto">

      <Border Grid.Row="0"
              Classes="modal-icon update-icon"
              Margin="0,0,0,16">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSync}"/>
      </Border>

      <StackPanel Grid.Row="1"
                  Classes="content-panel"
                  Spacing="12">
        <StackPanel.RenderTransform>
          <TranslateTransform/>
        </StackPanel.RenderTransform>

        <TextBlock Text="{loc:Localize Updates.NewVersionAvailable}" Classes="modal-title"/>

        <TextBlock Text="{loc:Localize Updates.DownloadAndInstallQuestion}"
                   Classes="modal-message"
                   MaxWidth="420"
                   Margin="0,0,0,4"/>

        <Expander Classes="modal-details" Header="{loc:Localize UI.Inspector.Details}">
          <Border Classes="modal-info-row" Margin="0,8,0,0">
            <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{loc:Localize Updates.CurrentVersion}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Row="0" Grid.Column="1"
                         x:Name="CurrentVersionText"
                         Text="2.1.4"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>

              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{loc:Localize Updates.NewVersion}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Grid.Column="1"
                         x:Name="NewVersionText"
                         Text="2.1.5"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Expander>

        <!-- Progress panel -->
        <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="8" Margin="0,8,0,0">
          <TextBlock x:Name="ProgressText"
                     Text="{loc:Localize Updates.DownloadingUpdate}"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ProgressBar x:Name="ProgressBar"
                       Height="6"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       CornerRadius="3"
                       Background="{DynamicResource SecondaryBackgroundBrush}"
                       Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2" Classes="modal-actions" Margin="0,16,0,0">
        <Button x:Name="YesButton"
                Classes="modal-primary"
                Content="{loc:Localize Updates.YesUpdate}"
                IsDefault="True"
                Click="YesButton_Click"/>
        <Button x:Name="NoButton"
                Classes="modal-secondary"
                Content="{loc:Localize Updates.NoLater}"
                IsCancel="True"
                Click="NoButton_Click"/>
      </StackPanel>

    </Grid>
  </Border>
</Window>
