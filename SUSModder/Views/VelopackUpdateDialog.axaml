<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.VelopackUpdateDialog"
        Width="550" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <FluentTheme />
    
    <!-- Animacja fade-in dla całego okna -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Animacja dla ikony -->
    <Style Selector="Border.update-icon">
      <Style.Animations>
        <Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="-20"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Animacja dla contentu -->
    <Style Selector="StackPanel.content-panel">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Hover effect dla przycisku aktualizacji -->
    <Style Selector="Button.update-button:pointerover">
      <Setter Property="Background" Value="#3B82F6"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
    </Style>
    
    <Style Selector="Button.update-button:pressed">
      <Setter Property="Background" Value="#2563EB"/>
    </Style>
    
    <!-- Hover effect dla przycisku anuluj -->
    <Style Selector="Button.cancel-button:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>

  <Border Margin="0,30,0,0">
    <Grid Margin="30,10,30,30" RowDefinitions="Auto,Auto,Auto">

      <!-- Ikona aktualizacji z tłem -->
      <Border Grid.Row="0"
              Classes="update-icon"
              Width="80" Height="80"
              CornerRadius="40"
              Background="#203B82F6"
              BorderBrush="#3B82F6"
              BorderThickness="2"
              HorizontalAlignment="Center"
              Margin="0,0,0,20">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <TextBlock Text="🚀" 
                   FontSize="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <!-- Zawartość -->
      <StackPanel Grid.Row="1"
                  Classes="content-panel"
                  Spacing="12"
                  MinHeight="160">
        <StackPanel.RenderTransform>
          <TranslateTransform/>
        </StackPanel.RenderTransform>
        
        <!-- Tytuł -->
        <TextBlock Text="{loc:Localize Updates.NewVersionAvailable}"
                   FontSize="20" 
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <!-- Wiadomość główna -->
        <TextBlock Text="{loc:Localize Updates.DownloadAndInstallQuestion}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="420"
                   Margin="0,0,0,8"/>
        
        <!-- Panel informacji o wersjach -->
        <Border Background="{DynamicResource ModCardBackgroundBrush}"
                BorderBrush="{DynamicResource ModCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,4,0,4">
          <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,*">
            <!-- Obecna wersja -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:Localize Updates.CurrentVersion}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       x:Name="CurrentVersionText"
                       Text="2.1.4"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            
            <!-- Nowa wersja -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{loc:Localize Updates.NewVersion}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1"
                       x:Name="NewVersionText"
                       Text="2.1.5"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- Progress panel -->
        <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="8" Margin="0,8,0,0">
          <TextBlock x:Name="ProgressText"
                     Text="{loc:Localize Updates.DownloadingUpdate}"
                     FontSize="12"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ProgressBar x:Name="ProgressBar"
                       Height="6"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       CornerRadius="3"
                       Background="{DynamicResource ModCardBackgroundBrush}"
                       Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
      </StackPanel>

      <!-- Przyciski -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="12"
                  Margin="0,20,0,0">
        <Button x:Name="YesButton"
                Classes="update-button"
                Content="{loc:Localize Updates.YesUpdate}"
                Width="150"
                Height="40"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#3B82F6"
                BorderBrush="#2563EB"
                BorderThickness="1"
                CornerRadius="8"
                Foreground="White"
                Click="YesButton_Click"
                Cursor="Hand">
        </Button>

        <Button x:Name="NoButton"
                Classes="cancel-button"
                Content="{loc:Localize Updates.NoLater}"
                Width="150"
                Height="40"
                FontSize="14"
                Background="Transparent"
                BorderBrush="{DynamicResource ModCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Click="NoButton_Click"
                Cursor="Hand">
        </Button>
      </StackPanel>

    </Grid>
  </Border>
</Window>
