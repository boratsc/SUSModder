<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.StorageOverviewDialog"
        x:DataType="vm:StorageOverviewViewModel"
        x:CompileBindings="False"
        Title="{loc:Localize UI.Storage.Overview.Title}"
        Width="680" Height="620"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        AutomationProperties.Name="{loc:Localize UI.Storage.Overview.Title}"
        ToolTip.ShowDelay="300">

  <Window.Styles>
    <FluentTheme />

    <!-- Fade-in dla całego okna -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Karta sekcji -->
    <Style Selector="Border.overview-card">
      <Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Nagłówki -->
    <Style Selector="TextBlock.overview-heading">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.overview-value">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.overview-note">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- Banner informacyjny: tylko pomiar -->
    <Style Selector="Border.measurement-only-banner">
      <Setter Property="Background" Value="{DynamicResource InfoChipFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InfoChipBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style Selector="Button.overview-button:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>

  <Border Margin="0,30,0,0">
    <Grid Margin="24,10,24,20" RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- R0: nagłówek + ścieżka biblioteki + status -->
      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
        <TextBlock Classes="overview-heading"
                   FontSize="16"
                   Text="{loc:Localize UI.Storage.Overview.Title}"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="overview-value"
                     Text="{loc:Localize UI.Storage.Overview.LibraryPathHeader}"/>
          <TextBlock Classes="overview-value"
                     Text="{Binding LibraryPathText}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding LibraryPathText}"
                     MaxWidth="420"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <ProgressBar IsIndeterminate="True"
                       Width="120"
                       Height="6"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsMeasuring}"/>
          <TextBlock Classes="overview-note"
                     Text="{Binding StatusText}"
                     IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </StackPanel>

      <!-- R1: suma biblioteki + miejsce na wolumenie -->
      <Border Grid.Row="1" Classes="overview-card" Margin="0,0,0,10"
              AutomationProperties.Name="{loc:Localize UI.Storage.Overview.SummarySection}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">

          <TextBlock Grid.Row="0" Grid.Column="0" Classes="overview-heading"
                     Text="{loc:Localize UI.Storage.Overview.TotalHeader}"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="overview-value"
                     FontWeight="SemiBold"
                     Text="{Binding TotalMeasuredText}"
                     HorizontalAlignment="Right"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Classes="overview-note"
                     Text="{Binding TotalNoteText}"
                     IsVisible="{Binding TotalNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="overview-value"
                     Text="{loc:Localize UI.Storage.Overview.DriveFreeHeader}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="overview-value"
                     Text="{Binding DriveFreeText}"
                     HorizontalAlignment="Right"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="overview-value"
                     Text="{loc:Localize UI.Storage.Overview.DriveTotalHeader}"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="overview-value"
                     Text="{Binding DriveTotalText}"
                     HorizontalAlignment="Right"/>
        </Grid>
      </Border>

      <!-- R2: banner „tylko pomiar” — decyzja bezpieczeństwa 3.1: brak akcji kasowania -->
      <Border Grid.Row="2" Classes="measurement-only-banner" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="🧮" FontSize="16" VerticalAlignment="Top"
                     AutomationProperties.Name="{loc:Localize UI.Storage.Overview.MeasurementOnlyBanner}"/>
          <StackPanel Spacing="2" MaxWidth="560">
            <TextBlock Classes="overview-heading"
                       Text="{loc:Localize UI.Storage.Overview.MeasurementOnlyBanner}"
                       TextWrapping="Wrap"/>
            <TextBlock Classes="overview-note"
                       Text="{loc:Localize UI.Storage.Overview.NoCleanupExplanation}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- R3: kategorie + ostatni pomiar -->
      <Grid Grid.Row="3" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Margin="0,0,0,4"
                      VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="{loc:Localize UI.Storage.Overview.CategoriesList}">
          <ItemsControl ItemsSource="{Binding Categories}"
                        AutomationProperties.Name="{loc:Localize UI.Storage.Overview.CategoriesList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="overview-card" Margin="0,0,0,6"
                        AutomationProperties.Name="{Binding AutomationName}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="overview-heading" Text="{Binding Name}"/>
                      <TextBlock Classes="overview-note" Text="{Binding CountText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="overview-value"
                               FontWeight="SemiBold"
                               Text="{Binding SizeText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="overview-note"
                               Text="{Binding ClassificationText}"
                               ToolTip.Tip="{Binding Explanation}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="overview-note"
                               HorizontalAlignment="Right"
                               Text="{loc:Localize UI.Storage.Overview.LogicalUnitNote}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Classes="overview-note"
                   HorizontalAlignment="Right"
                   Margin="0,0,2,8"
                   Text="{Binding LastMeasuredText}"
                   IsVisible="{Binding LastMeasuredText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </Grid>

      <!-- R4: przyciski -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="overview-button"
                MinWidth="120" Height="36"
                Content="{loc:Localize UI.Storage.Overview.Cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsMeasuring}"
                AutomationProperties.Name="{loc:Localize UI.Storage.Overview.Cancel}"/>
        <Button Classes="overview-button"
                MinWidth="140" Height="36"
                Content="{loc:Localize UI.Storage.Overview.Refresh}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsMeasuring, Converter={x:Static BoolConverters.Not}}"
                AutomationProperties.Name="{loc:Localize UI.Storage.Overview.Refresh}"/>
        <Button Classes="overview-button"
                MinWidth="110" Height="36"
                Content="{loc:Localize UI.Storage.Overview.Close}"
                Command="{Binding CloseCommand}"
                IsDefault="True"
                AutomationProperties.Name="{loc:Localize UI.Storage.Overview.Close}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
