<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SUSModder.Views.AppUpdateDialog"
        Title="Aktualizacja aplikacji"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Ikona i tytuł -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
			<TextBlock Text="🔄" FontSize="32" VerticalAlignment="Center" Margin="0,0,15,0"/>
			<TextBlock Text="Dostępna jest nowa wersja!"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
		</StackPanel>

		<!-- Informacje o wersji -->
		<StackPanel Grid.Row="1" Margin="0,0,0,20">
			<TextBlock x:Name="CurrentVersionText"
                       Text="Obecna wersja: 1.0.0"
                       FontSize="14"
                       Margin="0,0,0,5"/>
			<TextBlock x:Name="NewVersionText"
                       Text="Nowa wersja: 1.1.0"
                       FontSize="14"
                       FontWeight="SemiBold"/>
		</StackPanel>

		<!-- Pytanie -->
		<TextBlock Grid.Row="2"
                   Text="Czy chcesz pobrać i zainstalować aktualizację?"
                   FontSize="14"
                   Margin="0,0,0,20"/>

		<!-- Progress bar (ukryty domyślnie) -->
		<StackPanel Grid.Row="3" x:Name="ProgressPanel" IsVisible="False">
			<TextBlock x:Name="ProgressText"
                       Text="Pobieranie aktualizacji..."
                       FontSize="12"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>
			<ProgressBar x:Name="ProgressBar"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
		</StackPanel>

		<!-- Przyciski -->
		<StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
			<Button x:Name="YesButton"
                    Content="Tak, aktualizuj"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="YesButton_Click"/>
			<Button x:Name="NoButton"
                    Content="Nie teraz"
                    Width="100"
                    Height="35"
                    Click="NoButton_Click"/>
		</StackPanel>
	</Grid>
</Window>