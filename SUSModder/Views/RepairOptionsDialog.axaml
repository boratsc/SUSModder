<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.RepairOptionsDialog"
        Title="{loc:Localize UI.Repair.DialogTitle}"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Styles>
        <FluentTheme />
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">

        <!-- Nagłówek z ikoną -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,0,0,24">
            <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Wrench}" FontSize="28" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{loc:Localize UI.Repair.DialogTitle}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Opcje naprawy -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

            <!-- Opcja 1: Napraw czarny ekran -->
            <Button x:Name="BlackScreenButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand"
                    Click="OnBlackScreenClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                    </Style>
                </Button.Styles>
                
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" 
                            Width="48" Height="48" 
                            CornerRadius="8"
                            Background="{DynamicResource AccentBrush}"
                            Margin="0,0,16,0">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Desktop}" FontSize="24" Foreground="White"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Localize UI.Repair.BlackScreen.Title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Localize UI.Repair.BlackScreen.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Opcja 2: Napraw certyfikaty -->
            <Button x:Name="CertificatesButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand"
                    Click="OnCertificatesClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                    </Style>
                </Button.Styles>
                
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" 
                            Width="48" Height="48" 
                            CornerRadius="8"
                            Background="#0288D1"
                            Margin="0,0,16,0">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Certificate}" FontSize="24" Foreground="White"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Localize UI.Repair.Certificates.Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- Badge wymagający administratora -->
                            <Border Background="#FF5722" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ic:SymbolIcon Symbol="{x:Static fic:Symbol.ShieldKeyhole}" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{loc:Localize UI.Repair.Certificates.AdminRequired}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Localize UI.Repair.Certificates.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Opcja 3: Napraw regiony -->
            <Button x:Name="RegionsButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand"
                    Click="OnRegionsClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                    </Style>
                </Button.Styles>
                
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" 
                            Width="48" Height="48" 
                            CornerRadius="8"
                            Background="#4CAF50"
                            Margin="0,0,16,0">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Globe}" FontSize="24" Foreground="White"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Localize UI.Repair.Regions.Title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Localize UI.Repair.Regions.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            
            <!-- Opcja 4: Wyjątki Firewall (tylko Steam) -->
            <Button x:Name="FirewallButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand"
                    Click="OnFirewallClick">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Button:disabled">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Style>
                </Button.Styles>
                
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" 
                            Width="48" Height="48" 
                            CornerRadius="8"
                            Background="#9C27B0"
                            Margin="0,0,16,0">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.ShieldKeyhole}" FontSize="24" Foreground="White"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Localize UI.Repair.Firewall.Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- Badge wymagający administratora -->
                            <Border Background="#FF5722" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ic:SymbolIcon Symbol="{x:Static fic:Symbol.ShieldKeyhole}" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="{loc:Localize UI.Repair.Certificates.AdminRequired}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Badge Steam only -->
                            <Border Background="#1976D2" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Steam"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Localize UI.Repair.Firewall.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            
            <!-- Opcja 5: Epic Games Authentication (tylko Epic) -->
            <Border x:Name="EpicAuthSection"
                    HorizontalAlignment="Stretch"
                    Padding="16"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Styles>
                    <Style Selector="Border.epic-auth:disabled">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Style>
                </Border.Styles>
                
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Nagłówek z ikoną i opisem -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" 
                                Width="48" Height="48" 
                                CornerRadius="8"
                                Background="#E91E63"
                                Margin="0,0,16,0">
                            <ic:SymbolIcon Symbol="{x:Static fic:Symbol.PersonKey}" FontSize="24" Foreground="White"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{loc:Localize UI.Repair.EpicAuth.Title}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <!-- Badge Epic only -->
                                <Border Background="#E91E63" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Epic"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{loc:Localize UI.Repair.EpicAuth.Description}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Przyciski Wyloguj / Zaloguj -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="0,12,0,0">
                        <Button x:Name="EpicLogoutButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="36"
                                Background="#D32F2F"
                                Foreground="White"
                                CornerRadius="6"
                                Cursor="Hand"
                                Click="OnEpicLogoutClick">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#B71C1C"/>
                                </Style>
                                <Style Selector="Button:disabled">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="{x:Static fic:Symbol.SignOut}" FontSize="16" Foreground="White"/>
                                <TextBlock Text="{loc:Localize UI.Repair.EpicAuth.Logout}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="EpicLoginButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="36"
                                Background="#4CAF50"
                                Foreground="White"
                                CornerRadius="6"
                                Cursor="Hand"
                                Click="OnEpicLoginClick">
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Style>
                                <Style Selector="Button:disabled">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="{x:Static fic:Symbol.PersonAdd}" FontSize="16" Foreground="White"/>
                                <TextBlock Text="{loc:Localize UI.Repair.EpicAuth.Login}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- Przycisk Anuluj -->
        <Button Grid.Row="2"
                x:Name="CancelButton"
                Content="{loc:Localize UI.Buttons.Cancel}"
                HorizontalAlignment="Center"
                Width="140" Height="36"
                Margin="0,20,0,0"
                Background="{DynamicResource ModCardBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource ModCardBorderBrush}"
                CornerRadius="6"
                Click="OnCancelClick"/>
    </Grid>
</Window>
