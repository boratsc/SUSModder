<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SUSModder.Core.Configuration;assembly=SUSModder.Core"
             xmlns:vm="clr-namespace:SUSModder.ViewModels"
             xmlns:local="clr-namespace:SUSModder.Converters;assembly=SUSModder"
             xmlns:localize="using:SUSModder.Services.Localization"
             x:DataType="vm:DllModSelectionViewModel"
             x:Class="SUSModder.Views.DllModSelectionView">
    <UserControl.Resources>
        <local:GreaterThanConverter x:Key="GreaterThanConverter"/>
    </UserControl.Resources>
    
    <Grid RowDefinitions="*,Auto">
        <!-- Lista modów DLL -->
        <Grid Grid.Row="0">
			<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding DllMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ModConfiguration">
                                <Border Background="{DynamicResource ModCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource ModCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,10"
                                        Padding="15">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,15,0"
                                                  VerticalAlignment="Center"/>
                                        
                                        <!-- Emoji kompatybilności -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CompatibilityEmoji}"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   ToolTip.Tip="{Binding CompatibilityDescription}"/>
                                        
                                        <!-- Informacje o modzie -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ModName}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{localize:Localize DllManager.StatusInstalled}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#4CAF50"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           IsVisible="{Binding IsInstalled}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="400"/>
                                            <TextBlock Text="{Binding ModVersion}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0"/>
                                            <!-- Ostrzeżenie o kompatybilności -->
                                            <TextBlock Text="{Binding CompatibilityWarning}"
                                                       FontSize="11"
                                                       Foreground="#FF9800"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       IsVisible="{Binding CompatibilityWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </StackPanel>
                                        
                                        <!-- Status kompatybilności (tekst) -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CompatibilityDescription}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="120"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Komunikat gdy brak modów -->
            <Border Background="{DynamicResource ModCardBackgroundBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !DllMods.Count}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🤷‍♂️"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{localize:Localize DllManager.NoAvailableMods}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{localize:Localize DllManager.CheckConnection}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Stopka z przyciskiem instalacji -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,15,0,0"
                Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{localize:Localize DllManager.ApplyChangesHint}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Grid.Column="1"
                        Content="{Binding ActionButtonText}"
                        Command="{Binding ApplyChangesCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Padding="15,10"
                        CornerRadius="6"
                        FontWeight="SemiBold"/>
            </Grid>
        </Border>
        
        <!-- Panel potwierdzenia instalacji - na samym końcu -->
        <Grid IsVisible="{Binding IsInstallationComplete}"
              Background="#99000000"
              ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 4 16 0 #20000000"
                    Width="500"
                    Height="300"
                    Padding="20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{localize:Localize DllManager.OperationsComplete}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    
                    <Border Grid.Row="1"
                            Background="{DynamicResource ModCardBackgroundBrush}"
                            BorderBrush="{DynamicResource ModCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">
                        <ScrollViewer>
                            <TextBlock Text="{Binding InstallationSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                    
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">
                        <Button Content="{localize:Localize DllManager.BackButton}"
                                Command="{Binding OkCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Padding="20,10"
                                CornerRadius="6"
                                Margin="0,0,10,0"/>
                        <Button Content="{localize:Localize DllManager.CloseButton}"
                                Command="{Binding CloseCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                Padding="20,10"
                                CornerRadius="6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
