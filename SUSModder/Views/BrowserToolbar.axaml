<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.BrowserToolbar"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="glass-top-bar">
        <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,0" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsCatalogTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.Catalog}"
                        Content="{loc:Localize UI.Tabs.Catalog}"/>
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsMyPacksTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.MyPacks}"
                        Content="{loc:Localize UI.Tabs.MyPacks}"/>
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsDllAddonsTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.DllAddons}"
                        Content="{loc:Localize UI.Tabs.DllAddons}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="browser-search-box"
                    MinWidth="220"
                    MaxWidth="320"
                    Padding="8,4">
                <Grid ColumnDefinitions="Auto,*">
                    <ic:SymbolIcon Grid.Column="0"
                                   Symbol="{x:Static fic:Symbol.Search}"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding BrowserSearchText}"
                             PlaceholderText="{loc:Localize UI.Browser.SearchPlaceholder}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
