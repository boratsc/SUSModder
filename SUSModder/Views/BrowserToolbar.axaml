<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
              x:Class="SUSModder.Views.BrowserToolbar"
              x:Name="ToolbarRoot"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Button.browser-tab">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="glass-top-bar">
        <Grid Margin="12,8,12,4">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsCatalogTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.Catalog}"
                        AutomationProperties.Name="{loc:Localize UI.Tabs.Catalog}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Grid}" FontSize="16"/>
                        <TextBlock Text="{loc:Localize UI.Tabs.Catalog}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsMyPacksTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.MyPacks}"
                        AutomationProperties.Name="{loc:Localize UI.Tabs.MyPacks}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Box}" FontSize="16"/>
                        <TextBlock Text="{loc:Localize UI.Tabs.MyPacks}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="browser-tab"
                        Classes.active="{Binding IsDllAddonsTab}"
                        Command="{Binding SelectBrowserTabCommand}"
                        CommandParameter="{x:Static vm:MainWindowViewModel+ModBrowserTab.DllAddons}"
                        AutomationProperties.Name="{loc:Localize UI.Tabs.DllAddons}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.PuzzlePiece}" FontSize="16"/>
                        <TextBlock Text="{loc:Localize UI.Tabs.DllAddons}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
