<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.AmongUsNotFoundView"
             x:DataType="vm:AmongUsNotFoundViewModel"
             Background="Transparent">

	<!-- E6 / makieta 09: „Pierwsze uruchomienie” + zdanie + 3 numerowane kroki,
	     GOLD „Wybierz folder gry” + outlined „Pomiń na teraz”.
	     Wybór języka i platformy pozostaje w osobnych dialogach startowych
	     (LanguageSelectionDialog / PlatformSelectionDialog), autodetekcja bez zmian.
	     Pełna instrukcja ręczna pod „Szczegóły”. Fade-in: wrapper w MainWindow. -->

	<StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center"
	            MaxWidth="520" Margin="30">

		<Border Classes="modal-icon">
			<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Folder}"/>
		</Border>

		<TextBlock Classes="modal-title" Text="{Binding Title}"/>

		<TextBlock Classes="modal-message"
		           Text="{loc:Localize Dialogs.AmongUsNotFound.FirstRunMessage}"/>

		<Border Classes="modal-hairline" Margin="0,4"/>

		<StackPanel Spacing="14">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
				<Border Classes="modal-step-number">
					<TextBlock Text="1"/>
				</Border>
				<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
					<TextBlock Classes="modal-step-title"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step1Title}"/>
					<TextBlock Classes="modal-step-desc"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step1Desc}"/>
				</StackPanel>
			</Grid>
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
				<Border Classes="modal-step-number">
					<TextBlock Text="2"/>
				</Border>
				<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
					<TextBlock Classes="modal-step-title"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step2Title}"/>
					<TextBlock Classes="modal-step-desc"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step2Desc}"/>
				</StackPanel>
			</Grid>
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
				<Border Classes="modal-step-number">
					<TextBlock Text="3"/>
				</Border>
				<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
					<TextBlock Classes="modal-step-title"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step3Title}"/>
					<TextBlock Classes="modal-step-desc"
					           Text="{loc:Localize Dialogs.AmongUsNotFound.Step3Desc}"/>
				</StackPanel>
			</Grid>
		</StackPanel>

		<StackPanel Classes="modal-actions">
			<Button Classes="modal-primary" Command="{Binding BrowseCommand}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Folder}" FontSize="16"
					               Foreground="{DynamicResource OnAccentTextBrush}"/>
					<TextBlock Text="{Binding BrowseButton}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button Classes="modal-secondary"
			        Command="{Binding CloseCommand}"
			        Content="{Binding CloseButton}"/>
		</StackPanel>

		<Expander Classes="modal-details" Header="{loc:Localize UI.Inspector.Details}">
			<TextBlock Margin="0,8,0,0"
			           FontSize="13"
			           Foreground="{DynamicResource TextSecondaryBrush}"
			           TextWrapping="Wrap"
			           Text="{Binding Message}"/>
		</Expander>

	</StackPanel>
</UserControl>
