<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:local="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.UninstallConfirmDialog"
        Width="480" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />

		<!-- Animacja fade-in dla całego okna -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla ikony kosza -->
		<Style Selector="Border.trash-icon">
			<Style.Animations>
				<Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="-20"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla contentu -->
		<Style Selector="StackPanel.content-panel">
			<Style.Animations>
				<Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="10"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<!-- E6 / makieta 12: ikona danger + pytanie + zdanie konsekwencji,
	     DANGER „Usuń mod” + outlined „Anuluj”. Rozmiar jako drugorzędny wiersz. -->
	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,24" RowDefinitions="Auto,*,Auto">

			<Border Grid.Row="0"
					Classes="modal-icon danger trash-icon"
					Margin="0,0,0,16">
				<Border.RenderTransform>
					<TranslateTransform/>
				</Border.RenderTransform>
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Delete}"/>
			</Border>

			<StackPanel Grid.Row="1"
						Classes="content-panel"
						Spacing="12">
				<StackPanel.RenderTransform>
					<TranslateTransform/>
				</StackPanel.RenderTransform>

				<TextBlock x:Name="TitleText" Classes="modal-title"/>

				<TextBlock x:Name="MessageText"
						   Classes="modal-message"
						   MaxWidth="380"
						   Margin="0,0,0,4"/>

				<!-- Info o rozmiarze (opcjonalne) -->
				<Border x:Name="SizeInfoBorder"
						Classes="modal-info-row"
						HorizontalAlignment="Center"
						IsVisible="False">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}" FontSize="14"
						               Foreground="{DynamicResource TextSecondaryBrush}"/>
						<TextBlock x:Name="SizeInfoText"
								   FontSize="13"
								   Foreground="{DynamicResource TextSecondaryBrush}"/>
					</StackPanel>
				</Border>
			</StackPanel>

			<StackPanel Grid.Row="2" Classes="modal-actions" Margin="0,16,0,0">
				<Button x:Name="ConfirmButton"
						Classes="modal-danger"
						Content="{local:Localize Dialogs.Uninstall.ConfirmButton}"
						Click="ConfirmButton_Click">
					<i:Interaction.Behaviors>
						<behaviors:ShakeOnLoadBehavior
							Intensity="8"
							RepeatCount="2"
							Delay="0:0:0.6" />
					</i:Interaction.Behaviors>
					<Button.RenderTransform>
						<TranslateTransform/>
					</Button.RenderTransform>
				</Button>
				<Button x:Name="CancelButton"
						Classes="modal-secondary"
						Content="{local:Localize Dialogs.Uninstall.CancelButton}"
						IsCancel="True"
						Click="CancelButton_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
