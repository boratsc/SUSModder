<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        x:Class="SUSModder.Views.SUStatsConfigWindow"
        x:DataType="vm:SUStatsConfigViewModel"
        Title="SUStats - Konfiguracja"
        Width="600" Height="800"
        MinWidth="450" MinHeight="350"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<Design.DataContext>
		<vm:SUStatsConfigViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*,Auto" Margin="25">

		<!-- Header -->
		<Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,25">
			<StackPanel Orientation="Horizontal" Spacing="15">
				<TextBlock Text="📊" FontSize="32" VerticalAlignment="Center"/>
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="SUStats - Konfiguracja"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
					<TextBlock Text="Skonfiguruj rejestrowanie wyników gry"
                               FontSize="14"
                               Foreground="#E0FFFFFF"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Główna zawartość -->
		<Border Grid.Row="1"
                Background="{DynamicResource ModCardBackgroundBrush}"
                BorderBrush="{DynamicResource ModCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="25">

			<StackPanel Spacing="25">

				<!-- Sekcja hasła -->
				<StackPanel Spacing="12">
					<TextBlock Text="🔐 Hasło dostępu"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

					<TextBlock Text="Wprowadź hasło aby uzyskać dostęp do konfiguracji SUStats:"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>

					<Grid ColumnDefinitions="*,Auto">
						<TextBox Grid.Column="0"
                                 x:Name="PasswordTextBox"
                                 Text="{Binding EnteredPassword}"
                                 PasswordChar="•"
                                 Watermark="Wprowadź hasło..."
                                 FontSize="14"
                                 Padding="12,10"
                                 CornerRadius="6"
                                 Background="{DynamicResource SecondaryBackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Margin="0,0,10,0"/>

						<Button Grid.Column="1"
                                Content="Sprawdź"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                Padding="20,10"
                                CornerRadius="6"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Command="{Binding CheckPasswordCommand}"
                                IsEnabled="{Binding IsCheckingPassword, Converter={x:Static BoolConverters.Not}}"/>
					</Grid>

					<!-- Status sprawdzania hasła -->
					<TextBlock Text="{Binding PasswordStatusMessage}"
                               Foreground="{Binding PasswordStatusColor}"
                               FontSize="12"
                               Margin="0,5,0,0"
                               IsVisible="{Binding PasswordStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

					<!-- Checkbox zapamiętaj logowanie -->
					<CheckBox IsChecked="{Binding RememberLogin}"
                              Content="Zapamiętaj logowanie"
                              FontSize="13"
                              Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
				</StackPanel>

				<!-- Separator -->
				<Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        IsVisible="{Binding IsPasswordValid}"/>

				<!-- Sekcja konfiguracji (widoczna tylko po poprawnym haśle) -->
				<StackPanel Spacing="15" IsVisible="{Binding IsPasswordValid}">

					<!-- Informacja o serwerze -->
					<Border Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15">
						<StackPanel Spacing="8">
							<TextBlock Text="🖥️ Połączono z serwerem"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>

							<TextBlock Text="{Binding ValidatedServerName}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>


						</StackPanel>
					</Border>

					<!-- Switch włączania rejestrowania -->
					<Border Background="{DynamicResource TertiaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20">
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Text="📈 Włącz rejestrowanie wyników gry"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="Wyniki Twoich gier będą zapisywane na serwerze SUStats"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"/>
							</StackPanel>

							<ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding IsStatsEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="15,0,0,0"/>
						</Grid>
					</Border>

					<!-- Status rejestrowania -->
					<Border Background="{Binding StatsStatusBackgroundBrush}"
                            BorderBrush="{Binding StatsStatusBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            IsVisible="{Binding ShowStatsStatus}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="{Binding StatsStatusIcon}"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
							<TextBlock Text="{Binding StatsStatusMessage}"
                                       Foreground="{Binding StatsStatusTextBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</StackPanel>

			</StackPanel>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,20,0,0"
                Margin="0,25,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">

				<!-- Przycisk wylogowania (widoczny tylko gdy hasło jest poprawne) -->
				<Button Content="� Wyloguj"
                        Padding="15,10"
                        CornerRadius="6"
                        FontSize="14"
                        Background="{DynamicResource ModCardBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource ModCardBorderBrush}"
                        BorderThickness="1"
                        Command="{Binding ResetCommand}"
                        IsVisible="{Binding IsPasswordValid}"/>

				<Button Content="Zamknij"
                        Padding="20,10"
                        CornerRadius="6"
                        FontSize="14"
                        Background="{DynamicResource ModCardBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource ModCardBorderBrush}"
                        BorderThickness="1"
                        Click="CloseButton_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
