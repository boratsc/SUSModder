<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:config="using:SUSModder.Core.Configuration"
        xmlns:models="using:SUSModder.Core.Models"
        xmlns:local="clr-namespace:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.DllUpdateConfirmDialog"
        Width="600" Height="470"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />

		<!-- Animacja fade-in dla całego okna -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla ikony aktualizacji -->
		<Style Selector="Border.update-icon">
			<Style.Animations>
				<Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="-20"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla contentu -->
		<Style Selector="StackPanel.content-panel">
			<Style.Animations>
				<Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="10"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<!-- E6 / makieta 10 (aktualizacja = akcja niedestrukcyjna → GOLD):
	     ikona + tytuł + nazwa DLL + nowa wersja; lista lokalizacji pod „Szczegóły”. -->
	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,24" RowDefinitions="Auto,*,Auto">

			<Border Grid.Row="0"
					Classes="modal-icon update-icon"
					Margin="0,0,0,16">
				<Border.RenderTransform>
					<TranslateTransform/>
				</Border.RenderTransform>
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSync}"/>
			</Border>

			<ScrollViewer Grid.Row="1"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled"
						  MaxHeight="300">
				<StackPanel Classes="content-panel" Spacing="12">
					<StackPanel.RenderTransform>
						<TranslateTransform/>
					</StackPanel.RenderTransform>

					<TextBlock x:Name="TitleText"
							   Text="{local:Localize DllManager.UpdateConfirm.Title}"
							   Classes="modal-title"/>

					<TextBlock x:Name="DllModNameText"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource AccentBrush}"
							   HorizontalAlignment="Center"
							   TextAlignment="Center"/>

					<!-- Informacja o nowej wersji -->
					<Border Classes="modal-info-row" HorizontalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{local:Localize DllManager.UpdateConfirm.NewVersionAvailable}"
									   FontSize="13"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   VerticalAlignment="Center"/>
							<TextBlock x:Name="NewVersionText"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="{DynamicResource AccentBrush}"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<Expander Classes="modal-details" Header="{local:Localize UI.Inspector.Details}">
						<!-- Lista modów FULL z ich wersjami -->
						<Border Classes="modal-info-row" Margin="0,8,0,0">
							<StackPanel>
								<TextBlock Text="{local:Localize DllManager.UpdateConfirm.UpdateInLocations}"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextPrimaryBrush}"
										   Margin="0,0,0,8"/>

								<ScrollViewer MaxHeight="200"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl x:Name="LocationsItemsControl">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:DllLocationUpdate">
												<Border Background="{DynamicResource SecondaryBackgroundBrush}"
														BorderBrush="{DynamicResource ModCardBorderBrush}"
														BorderThickness="1"
														CornerRadius="6"
														Padding="10,8"
														Margin="0,0,0,6">
													<Grid ColumnDefinitions="Auto,*,Auto">
														<ic:SymbolIcon Grid.Column="0"
																	   Symbol="{x:Static fic:Symbol.Folder}"
																	   FontSize="14"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   VerticalAlignment="Center"
																	   Margin="0,0,8,0"/>
														<TextBlock Grid.Column="1"
																   Text="{Binding FullMod.ModName}"
																   FontSize="13"
																   FontWeight="Medium"
																   Foreground="{DynamicResource TextPrimaryBrush}"
																   VerticalAlignment="Center"/>
														<StackPanel Grid.Column="2"
																	Orientation="Horizontal"
																	Spacing="6"
																	VerticalAlignment="Center">
															<TextBlock Text="{Binding CurrentVersion}"
																	   FontSize="12"
																	   Foreground="{DynamicResource TextSecondaryBrush}"/>
															<TextBlock Text="→"
																	   FontSize="12"
																	   Foreground="{DynamicResource AccentBrush}"/>
															<TextBlock Text="{Binding NewVersion}"
																	   FontSize="12"
																	   FontWeight="SemiBold"
																	   Foreground="{DynamicResource AccentBrush}"/>
														</StackPanel>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>

								<TextBlock x:Name="LocationCountText"
										   FontSize="12"
										   FontStyle="Italic"
										   Foreground="{DynamicResource TextSecondaryBrush}"
										   Margin="0,8,0,0"
										   HorizontalAlignment="Right"/>
							</StackPanel>
						</Border>
					</Expander>
				</StackPanel>
			</ScrollViewer>

			<StackPanel Grid.Row="2" Classes="modal-actions" Margin="0,16,0,0">
				<Button x:Name="ConfirmButton"
						Classes="modal-primary"
						Content="{local:Localize DllManager.UpdateConfirm.UpdateAllButton}"
						IsDefault="True"
						Click="ConfirmButton_Click">
					<i:Interaction.Behaviors>
						<behaviors:ShakeOnLoadBehavior
							Intensity="6"
							RepeatCount="2"
							Delay="0:0:0.6" />
					</i:Interaction.Behaviors>
					<Button.RenderTransform>
						<TranslateTransform/>
					</Button.RenderTransform>
				</Button>
				<Button x:Name="CancelButton"
						Classes="modal-secondary"
						Content="{local:Localize DllManager.UpdateConfirm.CancelButton}"
						IsCancel="True"
						Click="CancelButton_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
