<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SUSModder.Views.UpdateProgressDialog"
        Width="500" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />

		<!-- Animacja fade-in -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.2" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<!-- E6: wzorzec modalu, pasek GOLD (bez neonu/zieleni). Mechanika ProgressFill bez zmian. -->
	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,24" RowDefinitions="Auto,Auto,Auto,Auto">

			<!-- Procent w złotym okręgu -->
			<Border Grid.Row="0" Classes="modal-icon" Margin="0,0,0,16">
				<TextBlock x:Name="BigPercentText"
						   Text="0%"
						   FontSize="20"
						   FontWeight="Bold"/>
			</Border>

			<!-- Nazwa moda -->
			<TextBlock Grid.Row="1"
					   x:Name="ModNameText"
					   Classes="modal-title"
					   Margin="0,0,0,12"/>

			<!-- Status -->
			<TextBlock Grid.Row="2"
					   x:Name="StatusText"
					   Classes="modal-message"
					   Margin="0,0,0,10"/>

			<!-- Pasek postępu -->
			<Border Grid.Row="3" Classes="modal-info-row" Padding="15,12">
				<Grid RowDefinitions="Auto,8,Auto">
					<TextBlock Grid.Row="0"
							   x:Name="PercentText"
							   Text="0%"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   HorizontalAlignment="Center"/>

					<Border Grid.Row="2"
							Height="8"
							Background="{DynamicResource SecondaryBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="4"
							ClipToBounds="True">
						<Border x:Name="ProgressFill"
								Background="{DynamicResource AccentBrush}"
								CornerRadius="3"
								HorizontalAlignment="Left"
								Width="0"/>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
