<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SUSModder.Views.UpdateProgressDialog"
        Width="500" Height="270"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />
		
		<!-- Animacja fade-in -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.2" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,30" RowDefinitions="Auto,Auto,Auto,Auto">

			<!-- Procent w kółku -->
			<Border Grid.Row="0"
					Width="90" Height="90"
					CornerRadius="45"
					Background="#2010B981"
					BorderBrush="#10B981"
					BorderThickness="3"
					HorizontalAlignment="Center"
					Margin="0,0,0,20">
				<TextBlock x:Name="BigPercentText"
						   Text="0%"
						   FontSize="32"
						   FontWeight="Bold"
						   Foreground="#10B981"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
			</Border>

			<!-- Nazwa moda -->
			<TextBlock Grid.Row="1"
					   x:Name="ModNameText"
					   FontSize="18" 
					   FontWeight="Bold"
					   Foreground="{DynamicResource TextPrimaryBrush}"
					   HorizontalAlignment="Center"
					   TextAlignment="Center"
					   Margin="0,0,0,15"/>

			<!-- Status -->
			<TextBlock Grid.Row="2"
					   x:Name="StatusText"
					   FontSize="13"
					   Foreground="{DynamicResource TextSecondaryBrush}"
					   HorizontalAlignment="Center"
					   TextAlignment="Center"
					   Margin="0,0,0,10"/>

			<!-- Pasek postępu -->
			<Border Grid.Row="3"
					Background="{DynamicResource ModCardBackgroundBrush}"
					BorderBrush="{DynamicResource ModCardBorderBrush}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="15,12">
				<Grid RowDefinitions="Auto,8,Auto">
					<!-- Procent -->
					<TextBlock Grid.Row="0"
							   x:Name="PercentText"
							   Text="0%"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   HorizontalAlignment="Center"/>

					<!-- Progress bar -->
					<Border Grid.Row="2"
							Height="8"
							Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="4">
						<Border x:Name="ProgressFill"
								Background="#10B981"
								CornerRadius="3"
								HorizontalAlignment="Left"
								Width="0"/>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
