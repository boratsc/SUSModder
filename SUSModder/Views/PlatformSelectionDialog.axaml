<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        x:Class="SUSModder.Views.PlatformSelectionDialog"
        x:DataType="vm:PlatformSelectionViewModel"
        Title="Wybierz platformę"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Border CornerRadius="12"
            ClipToBounds="True"
            Background="#1A1A2E"
            BorderBrush="#00FFAA"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#00FFAA"
                            BlurRadius="20"
                            OffsetX="0"
                            OffsetY="0"
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto" Margin="30">
            <!-- Header with bilingual text -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30">
                <TextBlock Text="Wybierz platformę"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Choose platform"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="#CCCCCC"
                          HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Platform Selection Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,20,*" HorizontalAlignment="Center">
                <!-- Steam Button -->
                <Button Grid.Column="0"
                        Width="180"
                        Height="180"
                        Background="#2A2A3E"
                        BorderBrush="#00FFAA"
                        BorderThickness="2"
                        CornerRadius="12"
                        Command="{Binding SelectSteamCommand}"
                        Cursor="Hand"
                        Classes="platformButton">
                    <Button.Styles>
                        <Style Selector="Button.platformButton:pointerover">
                            <Setter Property="Background" Value="#3A3A4E"/>
                            <Setter Property="BorderBrush" Value="#00F5FF"/>
                        </Style>
                        <Style Selector="Button.platformButton:pressed">
                            <Setter Property="Background" Value="#4A4A5E"/>
                        </Style>
                    </Button.Styles>
                    <Button.Effect>
                        <DropShadowEffect Color="#00FFAA"
                                        BlurRadius="0"
                                        OffsetX="0"
                                        OffsetY="0"
                                        Opacity="0.3"/>
                    </Button.Effect>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- Steam Icon -->
                        <Border Width="100"
                                Height="100"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="/Assets/steam.png"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="Steam"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Epic Button -->
                <Button Grid.Column="2"
                        Width="180"
                        Height="180"
                        Background="#2A2A3E"
                        BorderBrush="#00FFAA"
                        BorderThickness="2"
                        CornerRadius="12"
                        Command="{Binding SelectEpicCommand}"
                        Cursor="Hand"
                        Classes="platformButton">
                    <Button.Effect>
                        <DropShadowEffect Color="#00FFAA"
                                        BlurRadius="0"
                                        OffsetX="0"
                                        OffsetY="0"
                                        Opacity="0.3"/>
                    </Button.Effect>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- Epic Icon -->
                        <Border Width="100"
                                Height="100"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="/Assets/epic.png"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="Epic Games"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Footer text -->
            <TextBlock Grid.Row="2"
                      Text="Możesz zmienić platformę później w ustawieniach / You can change platform later in settings"
                      FontSize="11"
                      Foreground="#888888"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
