<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.PlatformSelectionDialog"
        x:DataType="vm:PlatformSelectionViewModel"
        Title="{loc:Localize Dialogs.PlatformSelection.Title}"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <!-- E6: karta wg wspólnego wzorca (bez neonu). Wybór Steam/Epic bez zmian. -->
    <Border Classes="modal-card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto" Margin="30">
            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
                <TextBlock Text="{loc:Localize Dialogs.PlatformSelection.Header}"
                          Classes="modal-title"/>
            </StackPanel>

            <!-- Platform Selection Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,20,*" HorizontalAlignment="Center">
                <!-- Steam Button -->
                <Button Grid.Column="0"
                        Width="180"
                        Height="170"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Command="{Binding SelectSteamCommand}"
                        Cursor="Hand"
                        Classes="platformButton">
                    <Button.Styles>
                        <Style Selector="Button.platformButton:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                        </Style>
                        <Style Selector="Button.platformButton:pressed">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style Selector="Button.platformButton:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Styles>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- Steam Icon -->
                        <Border Width="100"
                                Height="100"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="/Assets/steam.png"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="{loc:Localize Dialogs.PlatformSelection.SteamLabel}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Epic Button -->
                <Button Grid.Column="2"
                        Width="180"
                        Height="170"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Command="{Binding SelectEpicCommand}"
                        Cursor="Hand"
                        Classes="platformButton">
                    <Button.Styles>
                        <Style Selector="Button.platformButton:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                        </Style>
                        <Style Selector="Button.platformButton:pressed">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style Selector="Button.platformButton:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Styles>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- Epic Icon -->
                        <Border Width="100"
                                Height="100"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Image Source="/Assets/epic.png"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="{loc:Localize Dialogs.PlatformSelection.EpicLabel}"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Footer text -->
            <TextBlock Grid.Row="2"
                      Text="{loc:Localize Dialogs.PlatformSelection.Footer}"
                      FontSize="11"
                      Foreground="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
