<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.PostInstallFailureView"
             x:DataType="vm:PostInstallFailureViewModel"
             Background="Transparent">

	<!-- E6 / makieta 11: ikona danger + tytuł + bezpieczna przyczyna,
	     GOLD „Spróbuj ponownie” + outlined „Wróć do katalogu”.
	     Surowy log i akcje diagnostyczne pod „Szczegóły”.
	     Fade-in zapewnia wrapper fade-in-panel w MainWindow. -->

	<StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center"
	            MaxWidth="520" Margin="30">

		<Border Classes="modal-icon danger">
			<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Warning}"/>
		</Border>

		<TextBlock Classes="modal-title" Text="{Binding TitleWithName}"/>

		<TextBlock Classes="modal-message" Text="{Binding Message}"/>

		<StackPanel Classes="modal-actions">
			<Button Classes="modal-primary" Command="{Binding RetryCommand}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSync}" FontSize="16"
					               Foreground="{DynamicResource OnAccentTextBrush}"/>
					<TextBlock Text="{Binding RetryButton}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button Classes="modal-secondary"
			        Command="{Binding CloseCommand}"
			        Content="{Binding CloseButton}"/>
		</StackPanel>

		<Expander Classes="modal-details" Header="{loc:Localize UI.Inspector.Details}">
			<StackPanel Spacing="10" Margin="0,8,0,0">
				<TextBlock Classes="modal-section-label" Text="{Binding LogLabel}"/>

				<Border Classes="modal-info-row" Padding="8" MaxHeight="220">
					<ScrollViewer HorizontalScrollBarVisibility="Auto"
					              VerticalScrollBarVisibility="Auto">
						<TextBox Text="{Binding LogText}"
						         IsReadOnly="True"
						         AcceptsReturn="True"
						         TextWrapping="Wrap"
						         FontFamily="Consolas,Courier New,monospace"
						         FontSize="11"
						         Background="Transparent"
						         BorderThickness="0"
						         MinHeight="120"/>
					</ScrollViewer>
				</Border>

				<TextBlock Classes="modal-section-label" Text="{Binding DiagnosticActionsTitle}"/>

				<StackPanel Orientation="Horizontal" Spacing="10">
					<Button Classes="modal-primary"
					        Command="{Binding OpenAiSupportCommand}"
					        Content="{Binding OpenAiSupportButton}"
					        FontSize="13" Padding="14,8" MinWidth="0"/>
					<Button Classes="modal-secondary"
					        Command="{Binding CopyLogCommand}"
					        Content="{Binding CopyLogButton}"
					        FontSize="13" Padding="14,8" MinWidth="0"/>
				</StackPanel>
			</StackPanel>
		</Expander>

	</StackPanel>
</UserControl>
