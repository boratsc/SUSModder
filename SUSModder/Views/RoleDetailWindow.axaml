<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SUSModder.Models"
        xmlns:local="clr-namespace:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.RoleDetailWindow"
        x:DataType="models:Role"
        Title="{local:Localize RoleDetail.WindowTitle}"
        Width="600" Height="800"
        MinWidth="500" MinHeight="400"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource PrimaryBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />

		<!-- Style dla różnych kategorii używając Tag -->
		<Style Selector="Border[Tag=Crewmate]">
			<Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
		</Style>
		<Style Selector="Border[Tag=Impostor]">
			<Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
		</Style>
		<Style Selector="Border[Tag=Neutral]">
			<Setter Property="Background" Value="#FFFF9800"/>
		</Style>
		<Style Selector="Border[Tag=Modifier]">
			<Setter Property="Background" Value="#FF9C27B0"/>
		</Style>
	</Window.Styles>

	<ScrollViewer Background="{DynamicResource PrimaryBackgroundBrush}"
	              HorizontalScrollBarVisibility="Disabled"
	              VerticalScrollBarVisibility="Auto"
	              HorizontalContentAlignment="Stretch">
		<StackPanel Margin="20" Spacing="16" HorizontalAlignment="Stretch">
			<!-- Header -->
			<Border CornerRadius="12"
			        Padding="20"
			        Tag="{Binding Category}"
			        HorizontalAlignment="Stretch">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
					<StackPanel Grid.Column="0" Spacing="4" MinWidth="0">
						<TextBlock x:Name="RoleName"
						           Text="{Binding Name}"
						           FontSize="28"
						           FontWeight="Bold"
						           Foreground="White"
						           TextWrapping="Wrap" />
						<TextBlock x:Name="RoleCategory"
						           Text="{Binding Category}"
						           FontSize="16"
						           Foreground="#E0FFFFFF"
						           TextWrapping="Wrap" />
					</StackPanel>

					<Border Grid.Column="1"
					        Background="rgba(255,255,255,0.2)"
					        CornerRadius="16"
					        Padding="12,6"
					        VerticalAlignment="Top">
						<TextBlock x:Name="RoleType"
						           Text="{Binding Category}"
						           FontSize="14"
						           Foreground="White"
						           FontWeight="SemiBold" />
					</Border>
				</Grid>
			</Border>

			<!-- Opis -->
			<Border Background="{DynamicResource ModCardBackgroundBrush}"
			        BorderBrush="{DynamicResource ModCardBorderBrush}"
			        BorderThickness="1"
			        CornerRadius="8"
			        Padding="20"
			        HorizontalAlignment="Stretch">
				<StackPanel Spacing="12" HorizontalAlignment="Stretch">
					<TextBlock Text="{local:Localize RoleDetail.DescriptionHeader}"
					           FontSize="18"
					           FontWeight="Bold"
					           Foreground="{DynamicResource AccentBrush}" />
					<TextBox x:Name="RoleDescription"
					         Text="{Binding Description}"
					         IsReadOnly="True"
					         AcceptsReturn="True"
					         TextWrapping="Wrap"
					         MaxHeight="300"
					         ScrollViewer.VerticalScrollBarVisibility="Auto"
					         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					         FontSize="14"
					         LineHeight="20"
					         Foreground="{DynamicResource TextPrimaryBrush}"
					         Background="Transparent"
					         BorderThickness="0"
					         Padding="0"
					         HorizontalAlignment="Stretch"
					         MinWidth="0" />
				</StackPanel>
			</Border>

			<!-- Abilities -->
			<Border x:Name="AbilitiesPanel"
			        Background="{DynamicResource ModCardBackgroundBrush}"
			        BorderBrush="{DynamicResource ModCardBorderBrush}"
			        BorderThickness="1"
			        CornerRadius="8"
			        Padding="20"
			        HorizontalAlignment="Stretch"
			        IsVisible="False">
				<StackPanel Spacing="12" HorizontalAlignment="Stretch">
					<TextBlock Text="{local:Localize RoleDetail.AbilitiesHeader}"
					           FontSize="18"
					           FontWeight="Bold"
					           Foreground="{DynamicResource AccentBrush}" />
					<ScrollViewer MaxHeight="400"
					              VerticalScrollBarVisibility="Auto"
					              HorizontalScrollBarVisibility="Disabled"
					              HorizontalContentAlignment="Stretch">
						<ItemsControl x:Name="AbilitiesItemsControl" ItemsSource="{Binding Abilities}">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="models:Ability">
									<Border Background="{DynamicResource SecondaryBackgroundBrush}"
									        BorderBrush="{DynamicResource BorderBrush}"
									        BorderThickness="1"
									        CornerRadius="8"
									        Padding="15">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
											<Border Grid.Column="0"
											        Background="{DynamicResource AccentBrush}"
											        CornerRadius="20"
											        Width="40"
											        Height="40">
												<TextBlock Text="⚡"
												           FontSize="20"
												           Foreground="White"
												           HorizontalAlignment="Center"
												           VerticalAlignment="Center" />
											</Border>

											<StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
												<TextBlock Text="{Binding Name}"
												           FontSize="16"
												           FontWeight="Bold"
												           Foreground="{DynamicResource TextPrimaryBrush}"
												           TextWrapping="Wrap" />
												<TextBlock Text="{Binding Description}"
												           FontSize="12"
												           Foreground="{DynamicResource TextSecondaryBrush}"
												           TextWrapping="Wrap"
												           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<!-- Mod info -->
			<Border Background="{DynamicResource TertiaryBackgroundBrush}"
			        BorderBrush="{DynamicResource BorderBrush}"
			        BorderThickness="1"
			        CornerRadius="8"
			        Padding="15"
			        HorizontalAlignment="Stretch">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<TextBlock Grid.Column="0"
					           Text="🧩"
					           FontSize="20"
					           VerticalAlignment="Center" />
					<StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
						<TextBlock Text="{local:Localize RoleDetail.ModHeader}"
						           FontSize="12"
						           Foreground="{DynamicResource TextSecondaryBrush}" />
						<TextBlock x:Name="ModName"
						           Text="{Binding ModName}"
						           FontSize="14"
						           FontWeight="SemiBold"
						           Foreground="{DynamicResource TextPrimaryBrush}"
						           TextWrapping="Wrap" />
					</StackPanel>
				</Grid>
			</Border>

			<!-- Przycisk zamknij -->
			<Button Content="{local:Localize RoleDetail.CloseButton}"
			        HorizontalAlignment="Center"
			        Padding="20,10"
			        CornerRadius="8"
			        FontSize="14"
			        FontWeight="SemiBold"
			        Background="{DynamicResource AccentBrush}"
			        Foreground="White"
			        Click="OnCloseClick" />
		</StackPanel>
	</ScrollViewer>
</Window>
