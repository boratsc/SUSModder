<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SUSModder.Views"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.PromptDialog"
        x:DataType="views:PromptDialog"
        Title="{Binding DialogTitle}"
        Width="600" Height="400"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<Grid Margin="20" RowDefinitions="Auto,*,Auto">
		<ScrollViewer Grid.Row="0" MaxHeight="150" Margin="0,0,0,15"
		              VerticalScrollBarVisibility="Auto">
			<TextBlock Text="{Binding Message}"
			           TextWrapping="Wrap"
			           Foreground="{DynamicResource TextPrimaryBrush}"/>
		</ScrollViewer>

		<Border Grid.Row="1"
		        BorderBrush="{DynamicResource BorderBrush}"
		        BorderThickness="1"
		        CornerRadius="4"
		        Background="{DynamicResource SecondaryBackgroundBrush}">
			<TextBox x:Name="InputTextBox"
			         Text="{Binding InputText}"
			         PlaceholderText="Wklej JSON, URL lub kod..."
			         AcceptsReturn="True"
			         TextWrapping="Wrap"
			         VerticalAlignment="Stretch"
			         VerticalContentAlignment="Top"
			         Background="Transparent"
			         Foreground="{DynamicResource TextPrimaryBrush}"
			         BorderThickness="0"
			         Padding="10"
			         FontFamily="Consolas, Courier New, monospace"/>
		</Border>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,15,0,0">
			<Button Content="{loc:Localize UI.Buttons.OK}"
                    Click="OnOkClick"
                    IsDefault="True"
                    MinWidth="80"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    Padding="10,8"
                    CornerRadius="4"/>
			<Button Content="{loc:Localize UI.Buttons.Cancel}"
                    Click="OnCancelClick"
                    IsCancel="True"
                    MinWidth="80"
                    Background="{DynamicResource ModCardBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource ModCardBorderBrush}"
                    BorderThickness="1"
                    Padding="10,8"
                    CornerRadius="4"/>
		</StackPanel>
	</Grid>
</Window>
