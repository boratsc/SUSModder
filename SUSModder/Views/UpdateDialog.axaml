<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.Views"
        xmlns:core="using:SUSModder.Core.GameIntegration"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.UpdateDialog"
        x:DataType="vm:UpdateDialog"
        Title="{loc:Localize Updates.ModUpdatesTitle}"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nagłówek -->
		<TextBlock Grid.Row="0"
                   Text="{loc:Localize Updates.AvailableModUpdates}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,10"/>

		<!-- Lista modów -->
		<ListBox Grid.Row="1"
                 Name="ModsListBox"
                 ItemsSource="{Binding AvailableUpdates}"
                 IsVisible="{Binding !IsUpdating}"
                 Background="{DynamicResource SecondaryBackgroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="core:ModUpdateInfo">
					<CheckBox IsChecked="{Binding IsSelected}"
                              Margin="5"
                              Foreground="{DynamicResource TextPrimaryBrush}">
						<StackPanel>
							<TextBlock Text="{Binding ModName}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="{Binding CurrentVersion, StringFormat='Obecna: {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding NewVersion, StringFormat='Nowa: {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}"/>
						</StackPanel>
					</CheckBox>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Panel aktualizacji -->
		<StackPanel Grid.Row="1"
                    IsVisible="{Binding IsUpdating}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource WindowBackgroundBrush}">

			<TextBlock Text="{loc:Localize Updates.UpdatingMods}"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

			<!-- Ogólny progress -->
			<StackPanel Margin="0,0,0,20">
				<TextBlock Text="{Binding OverallProgressText}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,5"/>
				<ProgressBar Value="{Binding OverallProgress}"
                             Maximum="100"
                             Height="20"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SecondaryBackgroundBrush}"
                             Margin="0,0,0,10"/>
			</StackPanel>

			<!-- Aktualny mod -->
			<StackPanel IsVisible="{Binding CurrentModName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
				<TextBlock Text="{Binding CurrentModName, StringFormat='Aktualizowanie: {0}'}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,5"/>
				<TextBlock Text="{Binding CurrentModStatus}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>
				<ProgressBar Value="{Binding CurrentModProgress}"
                             Maximum="100"
                             Height="15"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SecondaryBackgroundBrush}"/>
			</StackPanel>
		</StackPanel>
		<ScrollViewer Grid.Row="1"
					  IsVisible="{Binding ShowFinalMessage}"
					  VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="20" VerticalAlignment="Center">
				<!-- Owiń TextBlock w Border -->
				<Border Background="{DynamicResource SecondaryBackgroundBrush}"
						CornerRadius="5"
						Padding="15">
					<TextBlock Text="{Binding FinalMessage}"
							   FontSize="14"
							   TextWrapping="Wrap"
							   HorizontalAlignment="Left"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
				</Border>
			</StackPanel>
		</ScrollViewer>
		<!-- Separator -->
		<Border Grid.Row="2"
                Height="1"
                Background="{DynamicResource BorderBrush}"
                Margin="0,10"/>

		<!-- Przyciski -->
		<StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

			<Button Name="UpdateButton"
                    Content="{loc:Localize Updates.UpdateSelected}"
                    Click="UpdateButton_Click"
                    IsVisible="{Binding !IsUpdating}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Padding="10,5"/>

			<Button Name="CancelButton"
                    Content="{loc:Localize UI.Buttons.Cancel}"
                    Click="CancelButton_Click"
                    IsVisible="{Binding !IsUpdating}"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,10,0"
                    Padding="10,5"/>

			<Button Name="CloseButton"
                    Content="{loc:Localize UI.Buttons.Close}"
                    Click="CloseButton_Click"
                    IsVisible="{Binding IsUpdating}"
                    IsEnabled="{Binding UpdateCompleted}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    Padding="10,5"/>
		</StackPanel>
	</Grid>
</Window>
