<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.BulkUpdateSummaryDialog"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />

		<Style Selector="TextBlock.bulk-mod-name">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.bulk-mod-version">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.bulk-addon">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.bulk-addon.attention">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
		</Style>
	</Window.Styles>

	<Border Margin="0,24,0,0">
		<Grid Margin="24,10,24,24" RowDefinitions="Auto,Auto,Auto">

			<StackPanel Grid.Row="0" Spacing="10">
				<TextBlock x:Name="TitleText" Classes="modal-title"/>
				<TextBlock x:Name="HeaderText" Classes="modal-message"/>
				<TextBlock x:Name="WarningText"
						   FontSize="12"
						   Foreground="{DynamicResource DangerBrush}"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   TextWrapping="Wrap"
						   IsVisible="False"/>
			</StackPanel>

			<ScrollViewer Grid.Row="1"
						VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Disabled"
						MaxHeight="380"
						Margin="0,12,0,0">
				<StackPanel x:Name="ModsList" Spacing="12"/>
			</ScrollViewer>

			<StackPanel Grid.Row="2"
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						Spacing="12"
						Margin="0,16,0,0">
				<Button x:Name="ConfirmButton"
						Content="{loc:Localize Dialogs.UpdateMod.UpdateButton}"
						Classes="modal-primary"
						IsDefault="True"
						Click="ConfirmButton_Click"/>
				<Button x:Name="CancelButton"
						Content="{loc:Localize Dialogs.UpdateMod.CancelButton}"
						Classes="modal-secondary"
						IsCancel="True"
						Click="CancelButton_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
