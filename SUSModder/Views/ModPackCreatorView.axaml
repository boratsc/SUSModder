<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SUSModder.Services.Localization"
             x:Class="SUSModder.Views.ModPackCreatorView"
             x:Name="CreatorView"
             Background="{DynamicResource CardBackgroundBrush}">

	<UserControl.Styles>
		<Style Selector="UserControl">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>

	<Grid Margin="20" RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="10">
				<TextBlock x:Name="PackNameLabel" Text="{loc:Localize ModPacks.PackNameLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="PackNameBox"/>

				<StackPanel x:Name="ShareOnlyPanel" Spacing="10">
					<TextBlock Text="{loc:Localize ModPacks.CreatorNameLabel}" FontWeight="SemiBold"/>
					<TextBox x:Name="CreatorNameBox" PlaceholderText="{loc:Localize ModPacks.CreatorNameOptional}"/>

					<TextBlock Text="{loc:Localize ModPacks.DiscordLabel}" FontWeight="SemiBold"/>
					<TextBox x:Name="DiscordInviteBox" PlaceholderText="discord.gg/..."/>

					<TextBlock Text="{loc:Localize ModPacks.TtlLabel}" FontWeight="SemiBold"/>
					<ComboBox x:Name="TtlCombo" HorizontalAlignment="Stretch" SelectedIndex="1">
						<ComboBoxItem Content="{loc:Localize ModPacks.Ttl7Days}" Tag="7"/>
						<ComboBoxItem Content="{loc:Localize ModPacks.Ttl30Days}" Tag="30"/>
						<ComboBoxItem Content="{loc:Localize ModPacks.Ttl90Days}" Tag="90"/>
					</ComboBox>
				</StackPanel>

		<TextBlock x:Name="SourceLabel" Text="{loc:Localize ModPacks.FullModLabel}" FontWeight="SemiBold"/>
		<ComboBox x:Name="FullModCombo" HorizontalAlignment="Stretch"/>

		<StackPanel x:Name="VersionPanel" Spacing="4">
			<TextBlock Text="{loc:Localize ModPacks.VersionLabel}" FontWeight="SemiBold"/>
			<ComboBox x:Name="VersionCombo" HorizontalAlignment="Stretch" PlaceholderText="{loc:Localize ModPacks.VersionLatest}"/>
		</StackPanel>

		<CheckBox x:Name="UseCustomFullCheck"
		          Content="{loc:Localize ModPacks.CustomFull.Toggle}"
		          IsVisible="False"/>

		<Border x:Name="CustomFullPanel"
		        BorderBrush="{DynamicResource AccentBrush}"
		        BorderThickness="1"
		        CornerRadius="8"
		        Padding="10"
		        IsVisible="False">
			<StackPanel Spacing="8">
				<TextBlock Text="{loc:Localize ModPacks.CustomFull.Title}"
				           FontWeight="SemiBold"/>
				<TextBlock Text="{loc:Localize ModPacks.CustomFull.GitHubOnlyWarning}"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"/>
				<TextBlock Text="{loc:Localize ModPacks.CustomFull.NameLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="CustomFullNameBox"
				         PlaceholderText="{loc:Localize ModPacks.CustomFull.NamePlaceholder}"/>
				<TextBlock Text="{loc:Localize ModPacks.CustomFull.VersionLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="CustomFullVersionBox"
				         PlaceholderText="{loc:Localize ModPacks.CustomFull.VersionPlaceholder}"/>
				<TextBlock Text="{loc:Localize ModPacks.CustomFull.UrlLabel}" FontWeight="SemiBold"/>
				<TextBox x:Name="CustomFullUrlBox"
				         PlaceholderText="{loc:Localize ModPacks.CustomFull.UrlPlaceholder}"/>
				<TextBlock x:Name="CustomFullStatusText"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"
				           IsVisible="False"/>
			</StackPanel>
		</Border>

		<Border x:Name="CustomDllPanel"
		        BorderBrush="{DynamicResource AccentBrush}"
		        BorderThickness="2"
		        CornerRadius="8"
		        Padding="12"
		        IsVisible="False">
			<StackPanel Spacing="8">
			<TextBlock Text="{loc:Localize ModPacks.CustomDlls.Title}"
			           FontSize="15"
			           FontWeight="Bold"/>
			<TextBlock x:Name="CustomDllNoticeText"
			           Text="{loc:Localize ModPacks.CustomDlls.ServerScanNotice}"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"
				           Margin="0,0,0,4"/>
				<Button Content="{loc:Localize ModPacks.CustomDlls.AddFiles}"
				        HorizontalAlignment="Left"
				        Padding="12,8"
				        Click="AddCustomDllFiles_Click"/>
				<StackPanel x:Name="CustomDllFilesPanel" Spacing="4"/>
				<TextBlock x:Name="CustomDllStatusText"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"
				           IsVisible="False"/>
			</StackPanel>
		</Border>

		<CheckBox x:Name="UseGithubDllCheck"
		          Content="{loc:Localize ModPacks.CustomGitHub.Toggle}"
		          IsVisible="False"/>

		<Border x:Name="CustomGithubDllPanel"
		        BorderBrush="{DynamicResource BorderBrush}"
		        BorderThickness="1"
		        CornerRadius="8"
		        Padding="10"
		        IsVisible="False">
			<StackPanel Spacing="8">
				<TextBlock Text="{loc:Localize ModPacks.CustomGitHub.Title}"
				           FontWeight="SemiBold"/>
				<TextBlock Text="{loc:Localize ModPacks.CustomGitHub.GitHubOnlyWarning}"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"/>
				<Button x:Name="AddGithubDllButton"
				        Content="{loc:Localize ModPacks.CustomGitHub.AddDll}"
				        HorizontalAlignment="Left"
				        Padding="12,8"
				        Click="AddGithubDll_Click"/>
				<StackPanel x:Name="GithubDllEntriesPanel" Spacing="8"/>
				<TextBlock x:Name="GithubDllStatusText"
				           TextWrapping="Wrap"
				           FontSize="12"
				           Foreground="{DynamicResource TextSecondaryBrush}"
				           IsVisible="False"/>
			</StackPanel>
		</Border>

		<TextBlock Text="{loc:Localize ModPacks.DllModsLabel}" FontWeight="SemiBold"/>
		<StackPanel x:Name="DllModsPanel" Spacing="4"/>

				<CheckBox x:Name="IncludeTouCheck" Content="{loc:Localize ModPacks.TouConfigLabel}"/>
				<CheckBox x:Name="IncludeIntegrationCheck" Content="{loc:Localize ModPacks.IntegrationLabel}"/>

				<TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="False"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1"
		            Orientation="Horizontal"
		            HorizontalAlignment="Center"
		            Spacing="12"
		            Margin="0,16,0,0">
			<Button Content="{loc:Localize UI.Buttons.Cancel}"
			        MinWidth="110"
			        Padding="16,10"
			        CornerRadius="8"
			        Click="CancelButton_Click"/>
			<Button x:Name="CreateButton"
			        Content="{loc:Localize ModPacks.CreateButton}"
			        MinWidth="140"
			        Padding="16,10"
			        CornerRadius="8"
			        Background="{DynamicResource AccentBrush}"
			        Foreground="White"
			        BorderThickness="0"
			        Click="CreateButton_Click"/>
		</StackPanel>
	</Grid>
</UserControl>
