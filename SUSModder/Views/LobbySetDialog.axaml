<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.LobbySetDialog"
        Title="{loc:Localize Tools.SetLobbySize}"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<Grid Margin="20" RowDefinitions="Auto,*,Auto">

		<!-- Nagłówek (E6) -->
		<TextBlock Grid.Row="0"
                   Text="{loc:Localize Tools.SetLobbySizeHeader}"
                   Classes="modal-title"
                   Margin="0,0,0,20"/>

		<!-- Zawartość -->
		<StackPanel Grid.Row="1" Spacing="15">
			<TextBlock Text="{loc:Localize Tools.SetLobbySizePrompt}"
                       Classes="modal-message"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Left"/>

			<NumericUpDown x:Name="PlayerCountNumeric"
                          Minimum="4" Maximum="255"
                          Value="18"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ModCardBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Increment="1"
                          FormatString="F0"/>

			<TextBlock x:Name="ErrorMessage"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       IsVisible="False"
                       TextWrapping="Wrap"/>
		</StackPanel>

		<!-- Przyciski -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
			<Button Content="{loc:Localize UI.Buttons.OK}"
                    Classes="modal-primary"
                    IsDefault="True"
                    Click="OkButton_Click"/>
			<Button Content="{loc:Localize UI.Buttons.Cancel}"
                    Classes="modal-secondary"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
