<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
              x:Class="SUSModder.Views.BulkModeChip"
              x:Name="ActionsRoot"
              x:DataType="vm:MainWindowViewModel">
	<StackPanel Spacing="8">
	<Button Classes="bulk-mode-chip"
			Classes.active="{Binding IsBulkSelectionMode}"
			Command="{Binding ToggleBulkSelectionModeCommand}">
		<ToolTip.Tip>
			<TextBlock Text="{loc:Localize UI.Bulk.SelectModeHint}"
					   MaxWidth="280"
					   TextWrapping="Wrap"
					   FontSize="11"/>
		</ToolTip.Tip>
		<Panel Width="36" Height="36">
			<ic:SymbolIcon Symbol="{x:Static fic:Symbol.CheckboxChecked}"
						   FontSize="18"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   IsVisible="{Binding IsBulkSelectionMode, Converter={x:Static BoolConverters.Not}}"/>
			<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}"
						   FontSize="16"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   IsVisible="{Binding IsBulkSelectionMode}"/>
			<Border Classes="bulk-mode-chip-badge">
				<Border.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="IsBulkSelectionMode"/>
						<Binding Path="BulkSelectedCount"/>
					</MultiBinding>
				</Border.IsVisible>
				<TextBlock Text="{Binding BulkSelectedCount}"
						   FontSize="9"
						   FontWeight="Bold"
						   Foreground="{DynamicResource OnAccentTextBrush}"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
			</Border>
		</Panel>
	</Button>
	<Button Classes="bulk-mode-chip" Classes.active="{Binding BrowserFavoritesOnly}"
            Command="{Binding ToggleFavoritesFilterCommand}"
            IsVisible="{Binding IsMyPacksTab, Converter={x:Static BoolConverters.Not}}"
            AutomationProperties.Name="{loc:Localize UI.Favorites.Filter}"
            ToolTip.Tip="{loc:Localize UI.Favorites.Filter}">
        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Star}" FontSize="18"/>
    </Button>
    <Button x:Name="SearchButton" Classes="bulk-mode-chip"
            AutomationProperties.Name="{loc:Localize UI.Browser.SearchPlaceholder}"
            ToolTip.Tip="{loc:Localize UI.Browser.SearchPlaceholder}">
        <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Search}" FontSize="18"/>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard"
                    Opened="SearchFlyout_Opened" Closed="SearchFlyout_Closed">
                <TextBox x:Name="SearchTextBox" Width="300"
                         Text="{Binding #ActionsRoot.((vm:MainWindowViewModel)DataContext).BrowserSearchText, Mode=TwoWay}"
                         TextChanged="SearchTextBox_TextChanged"
                         PlaceholderText="{loc:Localize UI.Browser.SearchPlaceholder}"
                         AutomationProperties.Name="{loc:Localize UI.Browser.SearchPlaceholder}"/>
            </Flyout>
        </Button.Flyout>
    </Button>
	</StackPanel>
</UserControl>
