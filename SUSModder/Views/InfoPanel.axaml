<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             x:Class="SUSModder.Views.InfoPanel"
             x:DataType="vm:MainWindowViewModel">
	<UserControl.Styles>
		<Style Selector="Border.info-hero">
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BoxShadow" Value="0 8 24 0 #24000000"/>
		</Style>

		<Style Selector="Border.info-card">
			<Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="18"/>
			<Setter Property="BoxShadow" Value="0 4 14 0 #16000000"/>
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Border.info-card:pointerover">
			<Setter Property="RenderTransform" Value="translateY(-2px)"/>
		</Style>

		<Style Selector="Border.person-row">
			<Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12"/>
		</Style>

		<Style Selector="Border.thanks-chip">
			<Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="Margin" Value="0,0,8,8"/>
		</Style>

		<Style Selector="Button.contact-icon">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="13"/>
			<Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalAlignment="Stretch"
				 VerticalAlignment="Stretch"
				 Padding="0,0,10,0"
				 VerticalScrollBarVisibility="Auto">
		<StackPanel Spacing="14">
			<Border Classes="info-hero">
				<Border.Background>
					<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
						<GradientStop Color="#222B3A" Offset="0"/>
						<GradientStop Color="#1B1F2B" Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<StackPanel Spacing="4">
						<TextBlock Text="{loc:Localize About.AppName}"
								   FontSize="28"
								   FontWeight="Bold"
								   Foreground="White"/>
						<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
							<TextBlock Text="{Binding AppVersion, StringFormat='Wersja v{0}'}"
									   FontSize="13"
									   Foreground="#C7FFFFFF"
									   VerticalAlignment="Center"/>
							<Button Content="{loc:Localize UI.Menu.CheckAppUpdates}"
									Command="{Binding CheckForAppUpdatesCommand}"
									Background="#26FFFFFF"
									Foreground="White"
									BorderBrush="#44FFFFFF"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8,3"
									FontSize="11"/>
						</StackPanel>
					</StackPanel>
					<Border Grid.Column="1"
							Background="#26FFFFFF"
							CornerRadius="999"
							Padding="10,6"
							VerticalAlignment="Center">
						<TextBlock Text="Among Us Mod Manager"
								   FontSize="11"
								   FontWeight="SemiBold"
								   Foreground="White"/>
					</Border>
				</Grid>
			</Border>

			<Border Classes="info-card">
				<StackPanel Spacing="12">
					<TextBlock Text="{loc:Localize About.CreatorLabel} i {loc:Localize About.GraphicsLabel}"
							   FontSize="15"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
					<Border Classes="person-row">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Border Width="28"
									Height="28"
									Background="{DynamicResource AccentBrush}"
									CornerRadius="14"
									VerticalAlignment="Center">
								<TextBlock Text="👨‍💻" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
								<TextBlock Text="boracik"
										   FontSize="14"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="{loc:Localize About.CreatorLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							</StackPanel>
							<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
								<Button Classes="contact-icon" Click="OpenDiscord_Click" ToolTip.Tip="Discord">
									<Image Source="avares://SUSModder/Assets/discord.png" Width="14" Height="14"/>
								</Button>
								<Button Classes="contact-icon" Click="OpenMail_Click" ToolTip.Tip="Email">
									<TextBlock Text="@" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Button>
							</StackPanel>
						</Grid>
					</Border>

					<Border Classes="person-row">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Border Width="28"
									Height="28"
									Background="#3A4BA3"
									CornerRadius="14"
									VerticalAlignment="Center">
								<TextBlock Text="🎨" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
								<TextBlock Text="Pacia"
										   FontSize="14"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="{loc:Localize About.GraphicsLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							</StackPanel>
						</Grid>
					</Border>
				</StackPanel>
			</Border>

			<Border Classes="info-card">
				<StackPanel Spacing="10">
					<TextBlock Text="{loc:Localize About.SpecialThanksLabel}"
							   FontSize="15"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
					<TextBlock Text="Dzieki za pomoc przy testach, feedbacku i rozwoju projektu."
							   FontSize="12"
							   Foreground="{DynamicResource TextSecondaryBrush}"/>
					<WrapPanel Orientation="Horizontal">
						<Border Classes="thanks-chip"><TextBlock Text="notpe" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="ma1ked" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="bobofrucik" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="Pacia" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="Hefe" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="Sheep aka Syzyf" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="ananasia" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="tumcio13" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="Sylwex" FontSize="12"/></Border>
						<Border Classes="thanks-chip"><TextBlock Text="luki290" FontSize="12"/></Border>
					</WrapPanel>
				</StackPanel>
			</Border>

			<Border Classes="info-card" Padding="12" Margin="0,0,0,4">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<TextBlock Text="i" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1"
							   Text="{loc:Localize About.Copyright}"
							   FontSize="11"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"/>
				</Grid>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
