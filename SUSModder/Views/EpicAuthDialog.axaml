<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.EpicAuthDialog"
        x:DataType="vm:EpicAuthDialogViewModel"
        Title="Logowanie do Epic Games"
        Width="800" Height="750"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackgroundBrush}">

	<ScrollViewer VerticalScrollBarVisibility="Auto"
	              HorizontalScrollBarVisibility="Disabled">
		<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Header -->
			<RowDefinition Height="Auto"/>
			<!-- Info about legendary -->
			<RowDefinition Height="Auto"/>
			<!-- Instructions -->
			<RowDefinition Height="*"/>
			<!-- TextBox for input -->
			<RowDefinition Height="Auto"/>
			<!-- Countdown message -->
			<RowDefinition Height="Auto"/>
			<!-- Buttons -->
		</Grid.RowDefinitions>

		<!-- Header z ikoną Epic -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
			<TextBlock Text="🎮" FontSize="48" Margin="0,0,15,0"/>
			<StackPanel VerticalAlignment="Center">
				<TextBlock Text="Logowanie do Epic Games Store"
				           FontSize="22"
				           FontWeight="Bold"
				           Foreground="{DynamicResource TextPrimaryBrush}"/>
				<TextBlock Text="Wymagane do uruchomienia gry"
				           FontSize="14"
				           Foreground="{DynamicResource TextSecondaryBrush}"
				           Margin="0,5,0,0"/>
			</StackPanel>
		</StackPanel>

		<!-- Info o legendary -->
		<Border Grid.Row="1"
		        Background="{DynamicResource CardBackgroundBrush}"
		        BorderBrush="{DynamicResource BorderBrush}"
		        BorderThickness="1"
		        CornerRadius="8"
		        Padding="20"
		        Margin="0,0,0,20">
			<StackPanel>
				<TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
					<Run Text="ℹ️ "/>
					<Run Text="SUSModder używa narzędzia "/>
					<Run Text="Legendary" FontWeight="Bold"/>
					<Run Text=" do zarządzania grami Epic. Legendary to otwartoźródłowy,"/>
					<LineBreak/>
					<Run Text="darmowy launcher dla Epic Games Store."/>
				</TextBlock>

				<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
					<TextBlock Text="🔗 Więcej informacji: "
					           FontSize="12"
					           Foreground="{DynamicResource TextSecondaryBrush}"/>
					<TextBlock Text="github.com/derrod/legendary"
					           FontSize="12"
					           Foreground="{DynamicResource AccentBrush}"
					           TextDecorations="Underline"
					           Cursor="Hand"
					           PointerPressed="OnLegendaryLinkClick"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- Instrukcje krok po kroku -->
		<Border Grid.Row="2"
		        Background="{DynamicResource SecondaryBackgroundBrush}"
		        BorderBrush="{DynamicResource AccentBrush}"
		        BorderThickness="2"
		        CornerRadius="8"
		        Padding="20"
		        Margin="0,0,0,20">
			<StackPanel>
				<TextBlock Text="📋 INSTRUKCJE"
				           FontSize="16"
				           FontWeight="Bold"
				           Foreground="{DynamicResource AccentBrush}"
				           Margin="0,0,0,15"/>

				<TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{DynamicResource TextPrimaryBrush}">
					<Run Text="1️⃣  Za chwilę otworzy się przeglądarka z logowaniem Epic Games" FontWeight="SemiBold"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="2️⃣  Zaloguj się do swojego konta Epic Games" FontWeight="SemiBold"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="3️⃣  Po zalogowaniu zobaczysz stronę z KODEM JSON" FontWeight="SemiBold"/>
					<LineBreak/>
					<Run Text="     Przykład: [authorizationCode: 74f0bb..., ...]"
					     FontFamily="Consolas, Courier New, monospace"
					     FontSize="11"
					     Foreground="{DynamicResource TextSecondaryBrush}"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="4️⃣  ZAZNACZ CAŁY TEKST (Ctrl+A)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="5️⃣  SKOPIUJ (Ctrl+C)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="6️⃣  WKLEJ PONIŻEJ (Ctrl+V)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
					<LineBreak/>
					<LineBreak/>
					<Run Text="✅ Aplikacja automatycznie wyciągnie kod autoryzacji!"
					     FontWeight="Bold"
					     Foreground="#4ecca3"/>
				</TextBlock>
			</StackPanel>
		</Border>

		<!-- TextBox na wklejenie -->
		<Border Grid.Row="3"
		        BorderBrush="{DynamicResource BorderBrush}"
		        BorderThickness="2"
		        CornerRadius="8"
		        Background="{DynamicResource CardBackgroundBrush}"
		        Margin="0,0,0,20">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Label -->
				<TextBlock Grid.Row="0"
				           Text="📥 Wklej kod lub cały JSON tutaj:"
				           FontSize="14"
				           FontWeight="SemiBold"
				           Foreground="{DynamicResource TextPrimaryBrush}"
				           Margin="15,15,15,10"/>

				<!-- TextBox -->
				<TextBox Grid.Row="1"
				         x:Name="AuthCodeTextBox"
				         Text="{Binding AuthorizationInput}"
				         AcceptsReturn="True"
				         TextWrapping="Wrap"
				         VerticalAlignment="Stretch"
				         VerticalContentAlignment="Top"
				         Background="Transparent"
				         Foreground="{DynamicResource TextPrimaryBrush}"
				         BorderThickness="0"
				         Padding="15"
				         FontFamily="Consolas, Courier New, monospace"
				         FontSize="12"
				         Watermark="Wklej tutaj JSON lub kod autoryzacji..."/>
			</Grid>
		</Border>

		<!-- Auto-open countdown message -->
		<Border Grid.Row="4"
		        Background="{DynamicResource SecondaryBackgroundBrush}"
		        BorderBrush="{DynamicResource AccentBrush}"
		        BorderThickness="1"
		        CornerRadius="6"
		        Padding="15,10"
		        Margin="0,0,0,15">
			<TextBlock Text="{Binding AutoOpenMessage}"
			           FontSize="13"
			           FontWeight="SemiBold"
			           Foreground="{DynamicResource AccentBrush}"
			           TextAlignment="Center"
			           TextWrapping="Wrap"/>
		</Border>

		<!-- Przyciski -->
		<StackPanel Grid.Row="5"
		            Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Spacing="15">
			<Button Content="🌐 Otwórz przeglądarkę"
			        Command="{Binding OpenBrowserCommand}"
			        Classes="secondary-button"
			        MinWidth="180"
			        Padding="15,10"/>
			<Button Content="❌ Anuluj"
			        Command="{Binding CancelCommand}"
			        Classes="secondary-button"
			        MinWidth="120"
			        Padding="15,10"/>
			<Button Content="✅ Zaloguj"
			        Command="{Binding ConfirmCommand}"
			        IsDefault="True"
			        Classes="primary-button"
			        MinWidth="120"
			        Padding="15,10"/>
		</StackPanel>
		</Grid>
	</ScrollViewer>

	<Window.Styles>
		<Style Selector="Button.primary-button">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style Selector="Button.primary-button:pointerover">
			<Setter Property="Opacity" Value="0.9"/>
		</Style>

		<Style Selector="Button.primary-button:pressed">
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<Style Selector="Button.secondary-button">
			<Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style Selector="Button.secondary-button:pointerover">
			<Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
		</Style>

		<Style Selector="Button.secondary-button:pressed">
			<Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
		</Style>
	</Window.Styles>
</Window>
