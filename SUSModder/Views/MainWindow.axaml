<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Views"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:converters="using:SUSModder.Converters"
        xmlns:labs="using:Avalonia.Labs.Panels"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:controls="using:SUSModder.Controls"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        x:Class="SUSModder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="960"
        MinWidth="1180" MinHeight="720"
        KeyDown="MainWindow_KeyDown">
	<Window.Resources>
		<converters:StringNotNullOrEmptyToBoolConverter x:Key="StringNotNullOrEmptyToBoolConverter"/>
		<converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
		<converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
		<converters:DiskUsageColorConverter x:Key="DiskUsageColorConverter"/>
		<converters:UpdatesColorConverter x:Key="UpdatesColorConverter"/>
		<converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
		<converters:BoolToGridLengthConverter x:Key="ModDetailColumnWidthConverter" TrueWidth="440" FalseWidth="0"/>
	</Window.Resources>

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<!-- Importowane style -->
		<StyleInclude Source="/Styles/ModCardStyle.axaml"/>
		<StyleInclude Source="/Styles/ModDetailPanelStyle.axaml"/>
		<StyleInclude Source="/Styles/MenuButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/PanelStyles.axaml"/>
		<StyleInclude Source="/Styles/StatusBarStyle.axaml"/>
		<StyleInclude Source="/Styles/BulkModeChipStyle.axaml"/>
		<StyleInclude Source="/Styles/BrowserTabStyle.axaml"/>
		<StyleInclude Source="/Styles/GlassSurfaceStyles.axaml"/>
		<StyleInclude Source="/Styles/GlassOpaqueFallbackStyles.axaml"/>

		<!-- Wspólny styl dla przycisków panelu szczegółów moda -->
		<Style Selector="Button.mod-detail-btn">
			<Setter Property="Padding" Value="12"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Opacity" Value="1.0"/>
		</Style>
		<Style Selector="Button.mod-detail-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.85"/>
		</Style>
		<Style Selector="Button.mod-detail-btn:pressed /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<!-- Skeleton card loading placeholder -->
		<Style Selector="Border.skeleton-card">
			<Setter Property="Width" Value="340"/>
			<Setter Property="Height" Value="160"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Background" Value="{DynamicResource ModCardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ModCardBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Opacity" Value="0.5"/>
			<Style.Animations>
				<Animation Duration="0:0:1.5" IterationCount="Infinite">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0.4"/>
					</KeyFrame>
					<KeyFrame Cue="50%">
						<Setter Property="Opacity" Value="0.8"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="0.4"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>

	<!-- Main Grid replacing SplitView -->
	<Grid RowDefinitions="*,Auto,Auto">

		<Panel Grid.RowSpan="3"
			   IsHitTestVisible="False"
			   ZIndex="0">
			<Rectangle Fill="{DynamicResource HeartsBackgroundBrush}"/>
			<Rectangle Fill="{DynamicResource WindowBackgroundGradientBrush}"/>
			<Rectangle Fill="{DynamicResource WindowAccentGlowBrush}" Opacity="0.9"/>
			<Rectangle Fill="{DynamicResource WindowBulkGlowBrush}" Opacity="0.7"/>
		</Panel>

		<Grid Grid.Row="0" RowDefinitions="*">
			<!-- Master-detail: siatka + panel (bez overlay/scrim) -->
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="{Binding IsBrowserDetailPanelVisible, Converter={StaticResource ModDetailColumnWidthConverter}}"/>
				</Grid.ColumnDefinitions>

			<Panel Grid.Column="0">
				<Grid RowDefinitions="Auto,*">
				<local:BrowserToolbar Grid.Row="0" DataContext="{Binding}"/>

			<Panel Grid.Row="1"
				   Classes="glass-browser-panel"
				   PointerPressed="ModGridBackground_PointerPressed">

			<!-- Skeleton loading placeholders (widoczne podczas inicjalizacji) -->
			<ScrollViewer Margin="10"
						  IsVisible="{Binding IsModsLoading}"
						  Background="Transparent">
				<labs:FlexPanel Direction="Row" Wrap="Wrap"
								JustifyContent="FlexStart"
								AlignItems="FlexStart"
								AlignContent="FlexStart">
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
					<Border Width="340" Height="160" CornerRadius="12" Classes="skeleton-card"/>
				</labs:FlexPanel>
			</ScrollViewer>

				<Border Margin="10"
						Classes="glass-empty-state"
						IsVisible="{Binding ShowBrowserNoResults}"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						MaxWidth="420">
					<StackPanel Spacing="8" HorizontalAlignment="Center">
						<TextBlock Text="{loc:Localize UI.Browser.NoResults}"
								   FontSize="16" FontWeight="SemiBold"
								   TextAlignment="Center"
								   Foreground="{DynamicResource TextPrimaryBrush}"/>
					</StackPanel>
				</Border>

				<controls:PackInstancesHintPanel DataContext="{Binding}"
											   Margin="10"
											   IsVisible="{Binding ShowPackInstancesEmptyState}"
											   VerticalAlignment="Center"
											   HorizontalAlignment="Center"/>

				<ScrollViewer Margin="10"
							  VerticalScrollBarVisibility="Auto"
							  IsVisible="{Binding IsPackInstancesGridVisible}"
							  Background="Transparent">
					<StackPanel Spacing="16">
						<ListBox x:Name="PackInstancesListBox"
								 ItemsSource="{Binding PackInstances}"
								 SelectedItem="{Binding SelectedPackInstance}"
								 Background="Transparent"
								 BorderThickness="0">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<labs:FlexPanel Direction="Row"
													Wrap="Wrap"
													JustifyContent="FlexStart"
													AlignItems="FlexStart"
													AlignContent="FlexStart"
													RowSpacing="0"
													ColumnSpacing="0">
										<i:Interaction.Behaviors>
											<behaviors:LayoutAnimationBehavior/>
										</i:Interaction.Behaviors>
									</labs:FlexPanel>
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<controls:PackInstanceCard/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<controls:PackInstancesHintPanel DataContext="{Binding}"
														 HorizontalAlignment="Center"
														 ShowEmptyStateMessage="False"/>
					</StackPanel>
				</ScrollViewer>

				<ListBox x:Name="DllModsListBox"
						 Margin="10"
						 IsVisible="{Binding IsDllAddonsGridVisible}"
						 ItemsSource="{Binding DllMods}"
						 SelectedItem="{Binding SelectedDllMod}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<labs:FlexPanel Direction="Row"
											Wrap="Wrap"
											JustifyContent="FlexStart"
											AlignItems="FlexStart"
											AlignContent="FlexStart"
											RowSpacing="0"
											ColumnSpacing="0">
								<i:Interaction.Behaviors>
									<behaviors:LayoutAnimationBehavior/>
								</i:Interaction.Behaviors>
							</labs:FlexPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<controls:DllAddonCard/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<ListBox x:Name="ModsListBox"
						 Margin="10"
						 IsVisible="{Binding IsBrowserGridVisible}"
						 ItemsSource="{Binding Mods}"
						 SelectedItem="{Binding SelectedMod}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<labs:FlexPanel Direction="Row" 
											Wrap="Wrap"
											JustifyContent="FlexStart"
											AlignItems="FlexStart"
											AlignContent="FlexStart"
											RowSpacing="0"
											ColumnSpacing="0">
								<i:Interaction.Behaviors>
									<behaviors:LayoutAnimationBehavior/>
								</i:Interaction.Behaviors>
							</labs:FlexPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Panel ToolTip.ShowDelay="300">
								<i:Interaction.Behaviors>
									<behaviors:DoubleClickBehavior
										DoubleClickCommand="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
										CommandParameter="{Binding}"
										DoubleClickInterval="300"/>
								</i:Interaction.Behaviors>
								<ToolTip.Tip>
									<StackPanel Spacing="4" MaxWidth="260">
										<TextBlock Text="{Binding Name}"
												   FontWeight="Bold"
												   FontSize="14"/>
										<Rectangle Height="1"
												   Fill="{DynamicResource ModCardBorderBrush}"
												   Margin="0,2,0,4"
												   Opacity="0.5"/>
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="{loc:Localize UI.Labels.ModVersion}"
													   FontWeight="SemiBold"
													   FontSize="11"
													   Opacity="0.7"/>
											<TextBlock Text="{Binding ModVersion, TargetNullValue=—}"
													   FontSize="11"/>
										</StackPanel>
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="{loc:Localize UI.Labels.GameVersion}"
													   FontWeight="SemiBold"
													   FontSize="11"
													   Opacity="0.7"/>
											<TextBlock Text="{Binding AmongVersion, TargetNullValue=—}"
													   FontSize="11"/>
										</StackPanel>
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="{loc:Localize UI.Labels.Status}"
													   FontWeight="SemiBold"
													   FontSize="11"
													   Opacity="0.7"/>
											<TextBlock Text="{loc:Localize UI.ModStatus.Installed}"
													   FontSize="11"
													   Foreground="#4CAF50"
													   IsVisible="{Binding IsInstalled}"/>
											<TextBlock Text="{loc:Localize UI.ModStatus.NotInstalled}"
													   FontSize="11"
													   Foreground="#FF5252"
													   IsVisible="{Binding IsInstalled, Converter={StaticResource InverseBoolConverter}}"/>
										</StackPanel>
									</StackPanel>
								</ToolTip.Tip>
								<controls:ModCard/>
							</Panel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<local:BulkModeChip HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="12,10,12,0"
									ZIndex="2"
									IsVisible="{Binding IsBulkChipVisible}"
									DataContext="{Binding}"/>
			</Panel>
				</Grid>
			</Panel>

				<Border x:Name="PackInstanceDetailDrawerHost"
						Grid.Column="1"
						Classes="mod-detail-host"
						MaxWidth="460"
						IsVisible="{Binding IsPackInstancePanelVisible}">
					<local:PackInstanceDetailDrawer DataContext="{Binding}"/>
				</Border>

				<Border x:Name="ModDetailDrawerHost"
						Grid.Column="1"
						Classes="mod-detail-host"
						MaxWidth="460"
						IsVisible="{Binding IsModPanelVisible}">
					<local:ModDetailDrawer x:Name="ModDetailDrawerControl" DataContext="{Binding}"/>
				</Border>

				<Border x:Name="DllAddonInspectorHost"
						Grid.Column="1"
						Classes="mod-detail-host"
						MaxWidth="460"
						IsVisible="{Binding IsDllPanelVisible}">
					<local:DllAddonInspector DataContext="{Binding}"/>
				</Border>
			</Grid>
		</Grid>

			<local:BulkActionBar Grid.Row="1" DataContext="{Binding}"/>

			<!-- STATUS BAR - Panel statusu na dole -->
			<Border x:Name="StatusBar"
					Grid.Row="2"
					Classes="status-bar">

				<Grid ColumnDefinitions="Auto,*,Auto" Margin="16,5,16,5" ColumnSpacing="6">
					<Grid Grid.Column="0"
						  Width="56" Height="56">
						<Button x:Name="FabButton"
								Classes="fab"
								Classes.active="{Binding IsPaneOpen}"
								Command="{Binding TogglePaneCommand}"
								ToolTip.Tip="{Binding FabBadgeTooltip}">
							<i:Interaction.Behaviors>
								<behaviors:RippleBehavior RippleColor="#FFFFFF" RippleOpacity="0.25" RippleDuration="500"/>
							</i:Interaction.Behaviors>
							<Grid>
								<ic:SymbolIcon x:Name="FabIcon" Symbol="{x:Static fic:Symbol.Navigation}" FontSize="20" Foreground="White"/>
							</Grid>
						</Button>
						<Border Classes="fab-badge"
								IsVisible="{Binding FabHasBadge}"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Margin="0,-3,-3,0">
							<TextBlock Text="{Binding FabBadgeCount}" FontSize="9"
									   Foreground="White"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Border>
					</Grid>

					<Border Grid.Column="1"
							Classes="statusbar-discord-promo"
							IsVisible="{Binding IsDiscordPromoStatusBarMode}">
						<Grid>
							<Grid x:Name="FabDiscordPromoContent"
								  Classes="fab-discord-promo-content visible"
								  IsVisible="{Binding HasPromotedDiscord}"
								  ColumnDefinitions="Auto,*,Auto"
								  ColumnSpacing="10">
								<Grid Grid.Column="0" Width="40" Height="40">
									<Border Width="40" Height="40"
											CornerRadius="20"
											Background="{DynamicResource AccentBrush}"
											IsVisible="{Binding CurrentPromotedDiscordHasIcon, Converter={x:Static BoolConverters.Not}}">
										<TextBlock Text="💬"
												   FontSize="16"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"
												   Foreground="White"/>
									</Border>

									<Border Width="40" Height="40"
											CornerRadius="20"
											ClipToBounds="True"
											IsVisible="{Binding CurrentPromotedDiscordHasIcon}">
										<Image Source="{Binding CurrentPromotedDiscordIconBitmap}"
											   Width="40"
											   Height="40"
											   Stretch="UniformToFill"/>
									</Border>
								</Grid>

								<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
									<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.OfficialBadge}"
										   FontSize="10"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource AccentBrush}"
										   IsVisible="{Binding CurrentPromotedDiscordIsOfficial}"/>
									<TextBlock Text="{Binding CurrentPromotedDiscordName}"
										   FontSize="13"
											   FontWeight="SemiBold"
											   TextTrimming="CharacterEllipsis"
											   Foreground="{DynamicResource TextPrimaryBrush}"/>
									<TextBlock Text="{Binding CurrentPromotedDiscordDescription}"
											   FontSize="11"
											   MaxLines="2"
											   TextWrapping="Wrap"
											   TextTrimming="CharacterEllipsis"
											   Foreground="{DynamicResource TextSecondaryBrush}"/>
								</StackPanel>

								<Button Grid.Column="2"
										Classes="fab-discord-promo-join"
										Content="{loc:Localize RecommendedDiscords.JoinButton}"
										Command="{Binding OpenPromotedDiscordInviteCommand}"
									CommandParameter="{Binding CurrentPromotedDiscordInviteLink}"/>
							</Grid>

							<TextBlock Text="{loc:Localize RecommendedDiscords.LoadingServers}"
									   FontSize="12"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   IsVisible="{Binding HasPromotedDiscord, Converter={x:Static BoolConverters.Not}}"/>
						</Grid>
					</Border>

					<Grid Grid.Column="1"
						  IsVisible="{Binding IsSystemStatusBarMode}"
						  ColumnDefinitions="2*,2*,1*"
						  ColumnSpacing="10">
						<!-- SEKCJA 1: Statystyki modów -->
						<Border Grid.Column="0" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<Border Classes="status-icon-container" Background="#4A148C">
									<TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>

								<StackPanel VerticalAlignment="Center" Spacing="2">
									<TextBlock Classes="status-main-text"
											   Text="{Binding ModsStatusMainText}"
											   Foreground="#F44336"
											   IsVisible="{Binding !!AvailableUpdatesCount}"/>
									<TextBlock Classes="status-main-text"
											   Text="{Binding ModsStatusMainText}"
											   IsVisible="{Binding !AvailableUpdatesCount}"/>
									<TextBlock Classes="status-sub-text" Text="{Binding ModsStatusSubText}"/>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<TextBlock Text="{Binding ModsStatusTooltip}"
										   FontSize="11"
										   MaxWidth="350"
										   TextWrapping="Wrap"/>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 2: Przestrzeń dyskowa -->
						<Border Grid.Column="1" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<Border Classes="status-icon-container" Background="#0288D1">
									<TextBlock Text="💾" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>

								<StackPanel VerticalAlignment="Center" Spacing="4" Width="250">
									<TextBlock Classes="status-main-text">
										<Run Text="{Binding ModsFolderSizeGB, StringFormat='{}{0:F2} GB'}"/>
										<Run Text=" / "/>
										<Run Text="{Binding FreeDiskSpaceGB, StringFormat='{}{0:F2} GB'}"/>
									</TextBlock>

									<Grid>
										<ProgressBar Value="{Binding DiskUsagePercentage}"
													 Maximum="100"
													 Height="8"
													 CornerRadius="4"
													 Foreground="{Binding DiskUsagePercentage, Converter={StaticResource DiskUsageColorConverter}}"/>
										<TextBlock Classes="status-sub-text"
												   HorizontalAlignment="Right"
												   Margin="0,-2,0,0">
											<Run Text="{Binding DiskUsagePercentage, StringFormat='{}{0:F1}%'}"/>
										</TextBlock>
									</Grid>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.Labels.SpaceDetailsHeader}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock Text="{Binding DiskSpaceDetailsTooltip}" FontSize="11"/>
								</StackPanel>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 3: Status API -->
						<Border Grid.Column="2" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
								<Ellipse Width="16" Height="16"
										 Fill="{Binding ApiStatusColor}"
										 Classes="status-pulse"/>

								<StackPanel VerticalAlignment="Center">
									<TextBlock Classes="status-main-text" Text="{loc:Localize UI.StatusBar.API}"/>
									<TextBlock Classes="status-sub-text" Text="{Binding ApiStatusText}"/>
									<TextBlock Classes="status-sub-text"
											   Text="{Binding OnlineUsersText}"
											   IsVisible="{Binding IsApiOnline}"/>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.StatusBar.ServerStatus}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.URL}"/>
										<Run Text="{Binding ApiBaseUrl}"/>
									</TextBlock>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.LastCheck}"/>
										<Run Text="{Binding LastApiCheck, StringFormat='{}{0:HH:mm:ss}'}"/>
									</TextBlock>
									<TextBlock FontSize="11" IsVisible="{Binding IsApiOnline}">
										<Run Text="{loc:Localize UI.StatusBar.Latency}"/>
										<Run Text="{Binding ApiPingMs}"/>
										<Run Text="{loc:Localize UI.StatusBar.Ms}"/>
									</TextBlock>
								</StackPanel>
							</ToolTip.Tip>
						</Border>
					</Grid>

					<Button Grid.Column="2"
							Classes="statusbar-toggle-button"
							Command="{Binding ToggleStatusBarModeCommand}">
						<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSwap}" FontSize="20"/>
						<ToolTip.Tip>
							<StackPanel>
								<TextBlock Text="{loc:Localize UI.StatusBar.SwitchToSystemStatus}"
										   IsVisible="{Binding IsDiscordPromoStatusBarMode}"/>
								<TextBlock Text="{loc:Localize UI.StatusBar.SwitchToDiscordPromo}"
										   IsVisible="{Binding IsSystemStatusBarMode}"/>
							</StackPanel>
						</ToolTip.Tip>
					</Button>
				</Grid>
			</Border>

			<!-- Modal dla paneli narzędziowych -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsAnyToolModalOpen}"
					PointerPressed="OnToolModalOverlayPressed">
				<Border Classes="tool-modal-card"
						PointerPressed="OnToolModalPanelPressed">
					<Grid RowDefinitions="Auto,*">
						<Grid ColumnDefinitions="*,Auto" Margin="24,20,24,14">
							<TextBlock Grid.Column="0"
									   Text="{Binding ToolModalTitle}"
									   FontSize="20"
									   FontWeight="Bold"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Classes="statusbar-toggle-button"
									Command="{Binding CloseToolModalCommand}">
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}" FontSize="20"/>
							</Button>
						</Grid>

					<Grid Grid.Row="1" Margin="24,0,24,24">
								<local:InfoPanel IsVisible="{Binding IsInfoPanelVisible}"
												 DataContext="{Binding}"
												 Classes="fade-in-panel"/>

								<ContentControl Content="{Binding LobbyBoardViewModel}"
												IsVisible="{Binding IsLobbyBoardVisible}"
												Classes="fade-in-panel">
									<ContentControl.DataTemplates>
										<DataTemplate DataType="vm:LobbyBoardPanelViewModel">
											<local:LobbyBoardPanel/>
										</DataTemplate>
									</ContentControl.DataTemplates>
								</ContentControl>

								<local:AdditionalActionsPanel IsVisible="{Binding IsAdditionalActionsVisible}"
															  DataContext="{Binding}"
															  Classes="fade-in-panel"/>

								<Panel IsVisible="{Binding IsSUStatsConfigVisible}" Classes="fade-in-panel">
									<local:SUStatsConfigView/>
								</Panel>

								<Panel IsVisible="{Binding IsAppSettingsVisible}" Classes="fade-in-panel">
									<local:AppSettingsView/>
								</Panel>

								<local:DllManagementPanel IsVisible="{Binding IsDllModalVisible}"/>

							<ContentControl Content="{Binding DllSelectionModalViewModel}"
												Classes="fade-in-panel"
												IsVisible="{Binding IsDllSelectionModalVisible}">
								<ContentControl.DataTemplates>
									<DataTemplate DataType="vm:DllModSelectionViewModel">
										<local:DllModSelectionView/>
									</DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>

								<Panel IsVisible="{Binding IsRecommendedDiscordsVisible}" Classes="fade-in-panel">
									<local:RecommendedDiscordsPanel/>
								</Panel>

						<Panel IsVisible="{Binding IsRepairOptionsVisible}" Classes="fade-in-panel">
							<local:RepairOptionsPanel/>
						</Panel>

						<ContentControl Content="{Binding PostInstallSuccessViewModel}"
										IsVisible="{Binding IsPostInstallSuccessVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:PostInstallSuccessViewModel">
									<local:PostInstallSuccessView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding PostInstallFailureViewModel}"
										IsVisible="{Binding IsPostInstallFailureVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:PostInstallFailureViewModel">
									<local:PostInstallFailureView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding AmongUsNotFoundViewModel}"
										IsVisible="{Binding IsAmongUsNotFoundVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:AmongUsNotFoundViewModel">
									<local:AmongUsNotFoundView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding ModPackCodeEntryViewModel}"
										IsVisible="{Binding IsModPackCodeEntryVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:ModPackCodeEntryViewModel">
									<local:ModPackCodeEntryView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding ModPackCreatorContent}"
										IsVisible="{Binding IsModPackCreatorVisible}"
										Classes="fade-in-panel"/>

						<ContentControl Content="{Binding ModPackResultViewModel}"
										IsVisible="{Binding IsModPackResultVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:ModPackResultViewModel">
									<local:ModPackResultView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding ModPackPreviewViewModel}"
										IsVisible="{Binding IsModPackPreviewVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:ModPackPreviewViewModel">
									<local:ModPackPreviewView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding ModPackManagerContent}"
										IsVisible="{Binding IsModPackManagerVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:SharedModPacksViewModel">
									<local:SharedPacksListView/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<ContentControl Content="{Binding VersionSelectionModalViewModel}"
										IsVisible="{Binding IsVersionSelectionModalVisible}"
										Classes="fade-in-panel">
							<ContentControl.DataTemplates>
								<DataTemplate DataType="vm:VersionSelectionViewModel">
									<local:VersionSelectionPanel/>
								</DataTemplate>
							</ContentControl.DataTemplates>
						</ContentControl>

						<!-- Launch Diagnostics Panel -->
						<Panel IsVisible="{Binding IsLaunchDiagnosticsVisible}" Classes="fade-in-panel">
							<Border Background="{StaticResource SystemAltMediumLowColor}" CornerRadius="8" Padding="16"
									Margin="0,0,0,12">
								<StackPanel Spacing="10">
									<TextBlock Text="{Binding LaunchDiagnosticsTitle}" FontSize="18" FontWeight="Bold"/>
									<TextBlock Text="{Binding LaunchDiagnosticsSeverity}" FontSize="14"/>
									<TextBlock Text="{Binding LaunchDiagnosticsSummary}" TextWrapping="Wrap"/>
									<TextBlock Text="{Binding LaunchDiagnosticsCodes}" TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
									<WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
										<Button Content="{Binding LaunchDiagBtnOpenModFolder}" Click="OnOpenModFolderClicked"
												Classes="secondary" Padding="12,6" Margin="0,0,6,6"/>
										<Button Content="{Binding LaunchDiagBtnOpenLogs}" Click="OnOpenBepInExLogsClicked"
												Classes="secondary" Padding="12,6" Margin="0,0,6,6"/>
										<Button Content="{Binding LaunchDiagBtnSupportBundle}" Click="OnGenerateSupportBundleClicked"
												Classes="secondary" Padding="12,6" Margin="0,0,6,6"/>
										<Button Content="{Binding LaunchDiagBtnAiSupport}" Click="OnOpenAiSupportClicked"
												Classes="accent" Padding="12,6" Margin="0,0,6,6"/>
										<Button Content="{Binding LaunchDiagBtnClose}" Click="OnCloseLaunchDiagnosticsClicked"
												Padding="12,6" Margin="0,0,6,6"/>
									</WrapPanel>
								</StackPanel>
							</Border>
						</Panel>

						<!-- AI Support Panel -->
						<Panel IsVisible="{Binding IsAiSupportVisible}" Classes="fade-in-panel">
							<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
									Margin="0,0,0,12">
								<ScrollViewer VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled"
											  MaxHeight="560">
								<StackPanel Spacing="10">
									<TextBlock Text="{Binding AiSupportTitle}" FontSize="18" FontWeight="Bold"/>
									<TextBlock Text="{Binding AiSupportPrivacyNoticeText}"
											   TextWrapping="Wrap" Opacity="0.8" FontSize="12"
											   IsVisible="{Binding !AiSupportPrivacyAccepted}"/>
									<Button Content="{Binding AiSupportAcceptPrivacyBtn}"
											IsVisible="{Binding !AiSupportPrivacyAccepted}"
											Click="OnAiSupportAcceptPrivacyClicked" Classes="accent" Padding="12,6"/>
									<StackPanel IsVisible="{Binding AiSupportPrivacyAccepted}" Spacing="8">
												<TextBox Text="{Binding AiSupportProblem}" PlaceholderText="{Binding AiSupportProblemPlaceholder}"
														 AcceptsReturn="True"
														 TextWrapping="Wrap"
														 MinHeight="90"
														 MaxHeight="180"/>
										<CheckBox IsChecked="{Binding AiSupportIncludeDiagnostics}"
												  Content="{Binding AiSupportIncludeDiagnosticsLabel}"/>
										<Button Content="{Binding AiSupportAnalyzeBtn}" Click="OnAnalyzeAiSupportClicked"
												Classes="accent" Padding="12,6"
												IsEnabled="{Binding !AiSupportIsLoading}"/>
										<ProgressBar IsVisible="{Binding AiSupportIsLoading}" IsIndeterminate="True"/>
										<Border IsVisible="{Binding AiSupportResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
												Background="{DynamicResource PaneBackgroundBrush}" CornerRadius="4" Padding="10"
												MaxHeight="260">
											<ScrollViewer VerticalScrollBarVisibility="Auto"
														  HorizontalScrollBarVisibility="Disabled">
											<StackPanel Spacing="6">
												<TextBlock Text="{Binding AiSupportResultSummary}" TextWrapping="Wrap"/>
												<TextBlock Text="{Binding AiSupportResultWarnings}" TextWrapping="Wrap"
														   Foreground="#FFB900" IsVisible="{Binding AiSupportResultWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
												<StackPanel Orientation="Vertical" Margin="0,6,0,0" Spacing="6">
													<Button Content="{Binding AiSupportHelpedBtn}" Click="OnAiSupportHelpedClicked"
															Classes="accent" Padding="12,6" HorizontalAlignment="Left"/>
													<Button Content="{Binding AiSupportNotHelpedBtn}" Click="OnAiSupportNotHelpedClicked"
															Classes="secondary" Padding="12,6" HorizontalAlignment="Left"/>
													<Button Content="{Binding AiSupportGenerateReportBtn}" Click="OnGenerateSupportBundleClicked"
															Classes="secondary" Padding="12,6" HorizontalAlignment="Left"/>
												</StackPanel>
											</StackPanel>
											</ScrollViewer>
										</Border>
									</StackPanel>
									<Button Content="{Binding AiSupportCloseBtn}" Click="OnCloseAiSupportClicked" Padding="12,6"/>
								</StackPanel>
								</ScrollViewer>
							</Border>
						</Panel>
					</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- Globalny modal dla komunikatów/potwierdzeń/prompt -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsInlineDialogVisible}"
					PointerPressed="OnInlineDialogOverlayPressed">
				<Border Classes="tool-modal-card"
						Width="560"
						MaxWidth="640"
						MaxHeight="500"
						MinHeight="220"
						PointerPressed="OnInlineDialogCardPressed">
					<Grid RowDefinitions="Auto,*,Auto">
						<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,8">
							<TextBlock Grid.Column="0"
									   Text="{Binding InlineDialogTitle}"
									   FontSize="18"
									   FontWeight="Bold"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Classes="statusbar-toggle-button"
									IsVisible="{Binding IsInlineDialogDismissible}"
									Click="OnInlineDialogSecondaryClick">
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}" FontSize="20"/>
							</Button>
						</Grid>

						<StackPanel Grid.Row="1" Margin="20,0,20,10" Spacing="10">
							<ScrollViewer MaxHeight="240"
										  VerticalScrollBarVisibility="Auto">
								<TextBlock Text="{Binding InlineDialogMessage}"
										   TextWrapping="Wrap"
										   FontSize="13"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
							</ScrollViewer>

							<Border IsVisible="{Binding IsInlineDialogPrompt}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Background="{DynamicResource SecondaryBackgroundBrush}">
								<TextBox Text="{Binding InlineDialogInputText, Mode=TwoWay}"
										 PlaceholderText="{loc:Localize PromptDialog.EnterNamePlaceholder}"
										 AcceptsReturn="True"
										 TextWrapping="Wrap"
										 MinHeight="120"
										 Background="Transparent"
										 BorderThickness="0"
										 Padding="10"/>
							</Border>
						</StackPanel>

						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Spacing="10"
									Margin="20,0,20,16">
							<Button Content="{Binding InlineDialogSecondaryButtonText}"
									IsVisible="{Binding IsInlineDialogSecondaryVisible}"
									MinWidth="100"
									Padding="10,8"
									Background="{DynamicResource ModCardBackgroundBrush}"
									Foreground="{DynamicResource TextPrimaryBrush}"
									BorderBrush="{DynamicResource ModCardBorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Click="OnInlineDialogSecondaryClick"/>
							<Button Content="{Binding InlineDialogPrimaryButtonText}"
									MinWidth="100"
									Padding="10,8"
									Background="{DynamicResource AccentBrush}"
									Foreground="White"
									CornerRadius="6"
									Click="OnInlineDialogPrimaryClick"/>
						</StackPanel>
					</Grid>
				</Border>
			</Border>

			<!-- Modal ostrzeżenia antywirusowego -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsAntivirusWarningVisible}">
				<Border Classes="tool-modal-card"
						Width="620"
						MaxWidth="680"
						MaxHeight="560"
						MinHeight="300"
						PointerPressed="OnAntivirusWarningCardPressed">
					<Grid RowDefinitions="Auto,*,Auto" Margin="24,22,24,18">
						<StackPanel Grid.Row="0" Spacing="10">
							<TextBlock Text="{Binding AntivirusWarningTitle}"
									   FontSize="20"
									   FontWeight="Bold"/>
							<TextBlock Text="{Binding AntivirusWarningIntro}"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
						</StackPanel>

						<ScrollViewer Grid.Row="1"
								  Margin="0,18,0,18"
								  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="14">
								<StackPanel Spacing="8">
									<TextBlock Text="{Binding AntivirusWarningProductsHeader}"
										   FontSize="14"
										   FontWeight="SemiBold"/>
									<ItemsControl ItemsSource="{Binding AntivirusWarningProducts}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,2">
													<TextBlock Text="•"
															   FontSize="18"
															   Foreground="{DynamicResource AccentBrush}"/>
													<TextBlock Text="{Binding .}"
															   TextWrapping="Wrap"
															   Foreground="{DynamicResource TextPrimaryBrush}"/>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<Border BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="14"
										Background="{DynamicResource SecondaryBackgroundBrush}">
									<TextBlock Text="{Binding AntivirusWarningRecommendation}"
										   TextWrapping="Wrap"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
								</Border>

								<Border BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="14"
										Background="{DynamicResource SecondaryBackgroundBrush}">
									<StackPanel Spacing="6">
										<TextBlock Text="{Binding AntivirusWarningSecurityNote}"
												   TextWrapping="Wrap"
												   FontSize="12"
												   Opacity="0.9"
												   Foreground="{DynamicResource TextPrimaryBrush}"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="14">
							<CheckBox Content="{Binding AntivirusWarningCheckboxText}"
									  IsChecked="{Binding IsAntivirusWarningAcknowledged, Mode=TwoWay}"
									  Foreground="{DynamicResource TextPrimaryBrush}"/>
							<Button Grid.Row="1"
									Content="OK"
									HorizontalAlignment="Right"
									MinWidth="110"
									Padding="10,8"
									Background="{DynamicResource AccentBrush}"
									Foreground="White"
									CornerRadius="6"
									IsEnabled="{Binding CanConfirmAntivirusWarning}"
									Click="OnAntivirusWarningConfirmClick"/>
						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- FAB Menu Overlay (backdrop) -->
			<Border Grid.Row="0" Grid.RowSpan="3"
					Classes="fab-overlay"
					Classes.visible="{Binding IsPaneOpen}"
					PointerPressed="OnOverlayPressed"/>

			<!-- FAB Menu Panel — kotwica przy FAB (pozycja w code-behind) -->
			<Border x:Name="FabMenuPanel"
					Grid.Row="0"
					Grid.RowSpan="3"
					Classes="fab-menu-panel"
					Classes.visible="{Binding IsPaneOpen}"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Margin="16,0,0,76"
					ZIndex="150"
					PointerPressed="OnMenuPanelPressed">

				<ScrollViewer x:Name="FabMenuScroll"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="4">
					<!-- Menu Header -->
					<TextBlock Text="{loc:Localize UI.Menu.Title}"
							   FontSize="18"
							   FontWeight="Bold"
							   Margin="4,4,4,12"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>

					<!-- Menu Items with FluentIcons -->
					<!-- Sprawdź aktualizacje modów -->
					<Button Classes="fab-menu-item"
							Command="{Binding CheckForModUpdatesFromMenuCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Grid>
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowDownload}" 
											  FontSize="20" Foreground="#FF5722"/>
								<Border Classes="fab-menu-item-badge"
										IsVisible="{Binding FabHasBadge}">
									<TextBlock Text="{Binding FabBadgeCount}" FontSize="9" 
											  Foreground="White"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
								</Border>
							</Grid>
							<TextBlock Text="{loc:Localize UI.Menu.CheckModUpdates}" 
									  VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding FixBlackScreenCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Toolbox}" FontSize="20" Foreground="#FF9800"/>
							<TextBlock Text="{loc:Localize UI.Menu.RepairGame}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowAdditionalActionsCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Wrench}" FontSize="20" Foreground="#F44336"/>
							<TextBlock Text="{loc:Localize UI.Menu.ToUConfigs}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowRecommendedDiscordsCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.PeopleTeam}" FontSize="20" Foreground="#4CAF50"/>
							<TextBlock Text="{loc:Localize UI.Menu.RecommendedDiscords}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowSUStatsConfigCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.DataBarVertical}" FontSize="20" Foreground="#E91E63"/>
							<TextBlock Text="{loc:Localize UI.Menu.SUStats}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>


					<Border Classes="fab-menu-group">
						<StackPanel Spacing="2">
							<Button Classes="fab-menu-item"
									Command="{Binding ToggleFabModPackActionsCommand}">
								<i:Interaction.Behaviors>
									<behaviors:RippleBehavior/>
								</i:Interaction.Behaviors>
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
									<ic:SymbolIcon Grid.Column="0" Symbol="{x:Static fic:Symbol.Box}" FontSize="20" Foreground="#00BCD4"/>
									<TextBlock Grid.Column="1"
											   Text="{loc:Localize ModPacks.MenuGroup}"
											   VerticalAlignment="Center"
											   TextWrapping="Wrap"/>
									<TextBlock Grid.Column="2" Text="▼" VerticalAlignment="Center" FontSize="10"
											   IsVisible="{Binding IsFabModPackActionsExpanded}"/>
									<TextBlock Grid.Column="2" Text="▶" VerticalAlignment="Center" FontSize="10"
											   IsVisible="{Binding IsFabModPackActionsExpanded, Converter={x:Static BoolConverters.Not}}"/>
								</Grid>
							</Button>

							<StackPanel Spacing="2" Margin="28,0,0,4"
										IsVisible="{Binding IsFabModPackActionsExpanded}">
								<Button Classes="fab-menu-subitem"
										Command="{Binding CreateLocalPackCommand}">
									<TextBlock Text="{loc:Localize UI.Packs.CreateLocal}" TextWrapping="Wrap" MaxWidth="220"/>
								</Button>
								<Button Classes="fab-menu-subitem"
										Command="{Binding CreateAndSharePackCommand}">
									<TextBlock Text="{loc:Localize UI.Packs.CreateAndShare}" TextWrapping="Wrap" MaxWidth="220"/>
								</Button>
								<Button Classes="fab-menu-subitem"
										Command="{Binding ShareExistingPackCommand}">
									<TextBlock Text="{loc:Localize ModPacks.ShareMenu}" TextWrapping="Wrap" MaxWidth="220"/>
								</Button>
								<Button Classes="fab-menu-subitem"
										Command="{Binding EnterModPackCodeCommand}">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ClipboardPaste}" FontSize="16" Foreground="#00BCD4"/>
										<TextBlock Text="{loc:Localize ModPacks.EnterCodeMenu}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="190"/>
									</StackPanel>
								</Button>
								<Button Classes="fab-menu-subitem"
										Command="{Binding ShowModPackManagerCommand}">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<ic:SymbolIcon Symbol="{x:Static fic:Symbol.CloudArrowUp}" FontSize="16" Foreground="#00BCD4"/>
										<TextBlock Text="{loc:Localize ModPacks.Shared.ManageFromLimit}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="190"/>
									</StackPanel>
								</Button>
							</StackPanel>
						</StackPanel>
					</Border>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowLobbyBoardCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.People}" FontSize="20" Foreground="#9C27B0"/>
							<TextBlock Text="{loc:Localize UI.Menu.LobbyBoard}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowAppSettingsCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Settings}" FontSize="20" Foreground="#2196F3"/>
							<TextBlock Text="{loc:Localize UI.Menu.Settings}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowInfoCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}" FontSize="20" Foreground="#00BCD4"/>
							<TextBlock Text="{loc:Localize UI.Menu.Info}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Border Classes="fab-menu-separator"/>
					<Button Classes="fab-menu-item"
							Command="{Binding ToggleThemeCommand}">
						<i:Interaction.Behaviors>
							<behaviors:RippleBehavior/>
						</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock Text="{Binding ThemeButtonIcon}" FontSize="20" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Toast notification overlay – na samej górze z-order, nad modalami -->
			<local:ToastHost Grid.Row="0" Grid.RowSpan="3"/>

	</Grid>
</Window>
