<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Views"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:converters="using:SUSModder.Converters"
        xmlns:labs="using:Avalonia.Labs.Panels"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        x:Class="SUSModder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="890" Height="820"
        MinWidth="890" MinHeight="820">
	<Window.Resources>
		<converters:StringNotNullOrEmptyToBoolConverter x:Key="StringNotNullOrEmptyToBoolConverter"/>
		<converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
		<converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
		<converters:DiskUsageColorConverter x:Key="DiskUsageColorConverter"/>
		<converters:UpdatesColorConverter x:Key="UpdatesColorConverter"/>
		<converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
	</Window.Resources>

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<FluentTheme />
		<!-- Importowane style -->
		<StyleInclude Source="/Styles/ModCardStyle.axaml"/>
		<StyleInclude Source="/Styles/MenuButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/PanelStyles.axaml"/>
		<StyleInclude Source="/Styles/StatusBarStyle.axaml"/>
		<StyleInclude Source="/Styles/FabButtonStyle.axaml"/>
	</Window.Styles>

	<!-- Main Grid replacing SplitView -->
	<Grid Background="{DynamicResource HeartsBackgroundBrush}" RowDefinitions="*,Auto">
		
		<!-- Main Content Area -->
		<Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">

				<ListBox Grid.Column="0" Margin="10"
						 ItemsSource="{Binding Mods}"
						 SelectedItem="{Binding SelectedMod}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<labs:FlexPanel Direction="Row" 
											Wrap="Wrap"
											JustifyContent="FlexStart"
											AlignItems="FlexStart"
											AlignContent="FlexStart"
											RowSpacing="0"
											ColumnSpacing="0">
								<i:Interaction.Behaviors>
									<behaviors:LayoutAnimationBehavior/>
								</i:Interaction.Behaviors>
							</labs:FlexPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Classes="mod-card"
									ToolTip.ShowDelay="300">
								<i:Interaction.Behaviors>
									<behaviors:DoubleClickBehavior 
										DoubleClickCommand="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
										CommandParameter="{Binding}" 
										DoubleClickInterval="300" />
								</i:Interaction.Behaviors>
								<ToolTip.Tip>
									<StackPanel MaxWidth="300">
										<TextBlock Text="{Binding Name}" 
												   FontWeight="Bold" 
												   FontSize="13"
												   Margin="0,0,0,5"/>
										<TextBlock Text="{Binding Description, Converter={StaticResource StringTruncateConverter}, ConverterParameter=150}" 
												   TextWrapping="Wrap"
												   FontSize="11"/>
									</StackPanel>
								</ToolTip.Tip>
								<StackPanel>
									<Image Classes="mod-icon"
										   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
										   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
									<TextBlock Classes="mod-name"
											   Text="{Binding Name}"
											   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<GridSplitter Grid.Column="1" Width="2"
							  Background="{DynamicResource GridSplitterBrush}"
							  VerticalAlignment="Stretch" HorizontalAlignment="Center">
					<GridSplitter.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="IsModSelected"/>
							<Binding Path="IsInfoPanelVisible"/>
							<Binding Path="IsAdditionalActionsVisible"/>
							<Binding Path="IsDllModificationsVisible"/>
						</MultiBinding>
					</GridSplitter.IsVisible>
				</GridSplitter>

				<!-- Panel po prawej stronie z nowym stylingiem -->
				<Border Grid.Column="2"
						Margin="15,10,10,10"
						Background="{DynamicResource SecondaryBackgroundBrush}"
						BorderBrush="{DynamicResource AccentBrush}"
						BorderThickness="1"
						CornerRadius="12"
						BoxShadow="0 4 16 0 #20000000"
						Width="350"
						MaxWidth="400">
					<Border.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="IsModSelected"/>
							<Binding Path="IsInfoPanelVisible"/>
							<Binding Path="IsAdditionalActionsVisible"/>
							<Binding Path="IsDllModificationsVisible"/>
							<Binding Path="IsSUStatsConfigVisible"/>
							<Binding Path="IsAppSettingsVisible"/>
						</MultiBinding>
					</Border.IsVisible>

					<Panel Margin="20">
						<!-- Panel modyfikacji DLL -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllModificationsVisible}">
							<Panel.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="IsDllModificationsVisible"/>
									<Binding Path="IsDllInstallDialogVisible" Converter="{x:Static BoolConverters.Not}"/>
								</MultiBinding>
							</Panel.IsVisible>

							<ScrollViewer>
								<StackPanel>
									<!-- Header -->
									<Border Background="{DynamicResource AccentBrush}"
											CornerRadius="8"
											Padding="15"
											Margin="0,0,0,20">
										<StackPanel Orientation="Horizontal" Spacing="15">
											<TextBlock Text="🧩" FontSize="32" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{loc:Localize UI.DllManager.Title}"
														   FontSize="20" FontWeight="Bold"
														   Foreground="White"/>
												<TextBlock Text="{loc:Localize UI.DllManager.SelectModification}"
														   FontSize="12"
														   Foreground="#E0FFFFFF"/>
											</StackPanel>
										</StackPanel>
									</Border>

									<!-- Lista modów DLL -->
									<ItemsControl ItemsSource="{Binding DllMods}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource ModCardBackgroundBrush}"
														BorderBrush="{DynamicResource ModCardBorderBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Margin="0,0,0,10"
														Padding="15">
													<Grid ColumnDefinitions="Auto,*,Auto">
														<!-- Ikona -->
														<Image Grid.Column="0"
															   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
															   Width="48" Height="48"
															   Margin="0,0,15,0"/>

														<!-- Informacje -->
														<StackPanel Grid.Column="1" VerticalAlignment="Center">
															<TextBlock Text="{Binding Name}"
																	   FontSize="16" FontWeight="Bold"
																	   Foreground="{DynamicResource TextPrimaryBrush}"/>
															<TextBlock Text="{Binding Description}"
																	   FontSize="12"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   TextWrapping="Wrap"
																	   MaxWidth="200"/>
															<TextBlock FontSize="11"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   Text="{Binding ModVersion, StringFormat='Wersja: {0}'}"/>
														</StackPanel>
														<!-- Przycisk wyboru -->
														<Button Grid.Column="2"
																Content="{loc:Localize UI.Buttons.Select}"
																Background="{DynamicResource AccentBrush}"
																Foreground="White"
																Padding="15,8"
																CornerRadius="6"
																FontSize="12"
																FontWeight="SemiBold"
																Command="{Binding $parent[local:MainWindow].DataContext.SelectDllModCommand}"
																CommandParameter="{Binding}"/>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</ScrollViewer>
						</Panel>

						<!-- Dialog instalacji/odinstalowania DLL -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllInstallDialogVisible}">
							<ScrollViewer>
								<StackPanel>
									<!-- Header z informacją o wybranym DLL -->
									<Border Background="{DynamicResource AccentBrush}"
											CornerRadius="8"
											Padding="15"
											Margin="0,0,0,20">
										<StackPanel Orientation="Horizontal" Spacing="15">
											<Image Source="{Binding SelectedDllMod.PngFileName, Converter={StaticResource StringToBitmapConverter}}"
												   Width="48" Height="48"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding SelectedDllMod.Name}"
														   FontSize="18" FontWeight="Bold"
														   Foreground="White"/>
												<TextBlock Text="{loc:Localize UI.DllManager.ManageInstallation}"
														   FontSize="12"
														   Foreground="#E0FFFFFF"/>
											</StackPanel>
										</StackPanel>
									</Border>

									<!-- Sekcja: Zainstaluj -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="15"
											IsVisible="{Binding ModsWithoutDllInstalled.Count}">
										<StackPanel>
											<TextBlock Text="{loc:Localize UI.DllManager.InstallIn}"
													   FontSize="16" FontWeight="Bold"
													   Foreground="{DynamicResource AccentBrush}"
													   Margin="0,0,0,10"/>

											<ItemsControl ItemsSource="{Binding ModsWithoutDllInstalled}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{DynamicResource SecondaryBackgroundBrush}"
																BorderBrush="{DynamicResource BorderBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Margin="0,0,0,8"
																Padding="12">
															<Grid ColumnDefinitions="Auto,*,Auto">
																<!-- Ikona -->
																<Image Grid.Column="0"
																	   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
																	   Width="32" Height="32"
																	   Margin="0,0,10,0"/>

																<!-- Informacje -->
																<StackPanel Grid.Column="1" VerticalAlignment="Center">
																	<TextBlock Text="{Binding Name}"
																			   FontSize="13" FontWeight="SemiBold"
																			   Foreground="{DynamicResource TextPrimaryBrush}"/>
																</StackPanel>

																<!-- Przycisk Instaluj -->
																<Button Grid.Column="2"
																		Content="{loc:Localize UI.Buttons.Install}"
																		Background="{DynamicResource AccentBrush}"
																		Foreground="White"
																		Padding="10,5"
																		CornerRadius="4"
																		FontSize="11"
																		FontWeight="SemiBold"
																		Command="{Binding $parent[local:MainWindow].DataContext.InstallDllToModCommand}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>

									<!-- Sekcja: Odinstaluj -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="15"
											IsVisible="{Binding ModsWithDllInstalled.Count}">
										<StackPanel>
											<TextBlock Text="{loc:Localize UI.DllManager.UninstallFrom}"
													   FontSize="16" FontWeight="Bold"
													   Foreground="{DynamicResource DangerBrush}"
													   Margin="0,0,0,10"/>

											<ItemsControl ItemsSource="{Binding ModsWithDllInstalled}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{DynamicResource SecondaryBackgroundBrush}"
																BorderBrush="{DynamicResource BorderBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Margin="0,0,0,8"
																Padding="12">
															<Grid ColumnDefinitions="Auto,*,Auto">
																<!-- Ikona -->
																<Image Grid.Column="0"
																	   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
																	   Width="32" Height="32"
																	   Margin="0,0,10,0"/>

																<!-- Informacje -->
																<StackPanel Grid.Column="1" VerticalAlignment="Center">
																	<TextBlock Text="{Binding Name}"
																			   FontSize="13" FontWeight="SemiBold"
																			   Foreground="{DynamicResource TextPrimaryBrush}"/>
																</StackPanel>

																<!-- Przycisk Usuń -->
																<Button Grid.Column="2"
																		Content="{loc:Localize UI.Buttons.Delete}"
																		Background="{DynamicResource DangerBrush}"
																		Foreground="White"
																		Padding="10,5"
																		CornerRadius="4"
																		FontSize="11"
																		FontWeight="SemiBold"
																		Command="{Binding $parent[local:MainWindow].DataContext.UninstallDllFromModCommand}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>

									<!-- Komunikat gdy brak modów -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="20">
										<Border.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
												<Binding Path="ModsWithDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
												<Binding Path="ModsWithoutDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
											</MultiBinding>
										</Border.IsVisible>

										<StackPanel HorizontalAlignment="Center">
											<TextBlock Text="🤷‍♂️"
													   FontSize="32"
													   HorizontalAlignment="Center"
													   Margin="0,0,0,10"/>
											<TextBlock Text="{loc:Localize UI.DllManager.NoModsInstalled}"
													   FontSize="14"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextAlignment="Center"/>
											<TextBlock Text="{loc:Localize UI.DllManager.InstallFullModFirst}"
													   FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextAlignment="Center"/>
										</StackPanel>
									</Border>

									<!-- Przycisk powrotu -->
									<Button Content="{loc:Localize UI.DllManager.BackToList}"
											HorizontalAlignment="Center"
											Background="{DynamicResource ModCardBackgroundBrush}"
											Foreground="{DynamicResource TextPrimaryBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											Padding="15,10"
											CornerRadius="6"
											Command="{Binding CloseDllDialogCommand}"/>
								</StackPanel>
							</ScrollViewer>
						</Panel>
						<!-- Panel informacji z animacją fade-in -->
						<local:InfoPanel IsVisible="{Binding IsInfoPanelVisible}"
										 DataContext="{Binding}"
										 Classes="fade-in-panel"/>

						<!-- Panel dodatkowych akcji z animacją slide od lewej -->
						<local:AdditionalActionsPanel IsVisible="{Binding IsAdditionalActionsVisible}"
													  DataContext="{Binding}"
													  Classes="fade-in-panel"/>

						<!-- Panel konfiguracji SUStats -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsSUStatsConfigVisible}">
							<local:SUStatsConfigView/>
						</Panel>

						<!-- Panel ustawień aplikacji -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsAppSettingsVisible}">
							<local:AppSettingsView/>
						</Panel>

						<!-- Panel modów z animacją slide od prawej -->
						<Panel Classes="fade-in-panel">
							<Panel.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="IsModSelected"/>
									<Binding Path="IsInfoPanelVisible" Converter="{x:Static BoolConverters.Not}"/>
									<Binding Path="IsAdditionalActionsVisible" Converter="{x:Static BoolConverters.Not}"/>
								</MultiBinding>
							</Panel.IsVisible>

							<StackPanel DataContext="{Binding SelectedMod}"
										Classes="mod-content-slide"
										Classes.visible="{Binding $parent[local:MainWindow].DataContext.IsModContentVisible}">
								<!-- Header z akcentem i developer menu -->
								<Border Background="{DynamicResource AccentBrush}"
										CornerRadius="8"
										Padding="15"
										Margin="0,0,0,20">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Istniejący content headera moda -->
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
											<Image Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
												   Width="64" Height="64"
												   HorizontalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}"
														   FontSize="20" FontWeight="Bold"
														   Foreground="White"
														   TextWrapping="Wrap"/>
												<TextBlock FontSize="11" Foreground="#E0FFFFFF">
													<Run Text="{loc:Localize UI.Labels.ModVersion}"/>
													<Run Text=":"/>
													<Run Text="{Binding ModVersion}"/>
												</TextBlock>
												<TextBlock FontSize="11" Foreground="#E0FFFFFF">
													<Run Text="{loc:Localize UI.Labels.GameVersion}"/>
													<Run Text=":"/>
													<Run Text="{Binding AmongVersion}"/>
												</TextBlock>
											</StackPanel>
										</StackPanel>

										<!-- Developer menu dla konkretnego moda -->
										<Button Grid.Column="1"
												x:Name="ModDeveloperMenuButton"
												Content="⋯"
												FontSize="18"
												FontWeight="Bold"
												Width="32"
												Height="32"
												Background="Transparent"
												BorderThickness="0"
												HorizontalContentAlignment="Center"
												VerticalContentAlignment="Center"
												Foreground="White"
												VerticalAlignment="Top"
												HorizontalAlignment="Right"
												IsVisible="{Binding $parent[local:MainWindow].DataContext.IsDeveloperMode}"
												Click="ModDeveloperMenuButton_Click">
											<Button.Styles>
												<Style Selector="Button:pointerover">
													<Setter Property="Background" Value="#40FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
												<Style Selector="Button:pressed">
													<Setter Property="Background" Value="#60FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
											</Button.Styles>

											<!-- Flyout menu -->
											<Button.Flyout>
												<MenuFlyout>
													<MenuItem Header="{loc:Localize MainWindow.DeveloperMenu.RemoveSingleInstance}">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].RemoveSingleInstanceCommand"/>
														</MenuItem.Command>
													</MenuItem>
													<MenuItem Header="{loc:Localize MainWindow.DeveloperMenu.LaunchMultipleInstances}">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].LaunchMultipleInstancesCommand"/>
														</MenuItem.Command>
													</MenuItem>
												</MenuFlyout>
											</Button.Flyout>
										</Button>
										</Grid>
								</Border>

								<ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
									<StackPanel x:Name="DescriptionPanel" Orientation="Vertical"/>
								</ScrollViewer>

							<!-- PROGRESS BAR -->
							<Border IsVisible="{Binding ShowProgress}"
									Background="{DynamicResource TertiaryBackgroundBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="15"
									Margin="0,0,0,10">
								<StackPanel>
									<TextBlock Text="{Binding InstallStatusMessage}"
											   FontSize="12"
											   Foreground="{DynamicResource TextPrimaryBrush}"
											   TextAlignment="Center"
											   Margin="0,0,0,8"/>
									<ProgressBar Value="{Binding InstallProgress}"
												 Minimum="0"
												 Maximum="100"
												 Height="24"
												 CornerRadius="12"
												 Background="{DynamicResource WindowBackgroundBrush}"
												 Foreground="{DynamicResource AccentBrush}"/>
									<TextBlock Text="{Binding InstallProgress, StringFormat='{}{0}%'}"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   TextAlignment="Center"
											   Margin="0,5,0,0"/>
								</StackPanel>
							</Border>								<!-- Przyciski dla Vanilla - tylko Uruchom -->
								<StackPanel IsVisible="{Binding IsVanilla}" Spacing="10">
									<Button Content="{loc:Localize UI.Buttons.Launch}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>
								</StackPanel>

								<!-- Przyciski dla niezainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}" ConverterParameter="Invert"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="{loc:Localize UI.Buttons.InstallLatest}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.InstallCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.SelectVersion}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="13"
											Background="{DynamicResource SecondaryBackgroundBrush}"
											BorderBrush="{DynamicResource AccentBrush}"
											BorderThickness="1"
											Foreground="{DynamicResource TextPrimaryBrush}"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.InstallWithVersionSelectionCommand}"/>
								</StackPanel>

								<!-- Przyciski dla zainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="{loc:Localize UI.Buttons.Launch}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.Update}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UpdateCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.Delete}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DangerBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UninstallCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.AddDll}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DllButtonBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.ShowDllSelectionCommand}"/>
								</StackPanel>

								<!-- Przycisk Role - widoczny dla modów z opisami ról (NIE dla Vanilla) -->
								<Button Content="{loc:Localize UI.Buttons.Roles}"
										HorizontalAlignment="Stretch"
										Margin="0,10,0,0"
										Padding="12"
										CornerRadius="8"
										FontSize="14"
										FontWeight="SemiBold"
										Background="{DynamicResource ModCardBackgroundBrush}"
										Foreground="{DynamicResource TextPrimaryBrush}"
										BorderBrush="{DynamicResource ModCardBorderBrush}"
										BorderThickness="1"
										Command="{Binding $parent[local:MainWindow].DataContext.ShowRolesCommand}">
									<Button.IsVisible>
										<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
									</Button.IsVisible>
									<Button.IsEnabled>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="IsInstalling" Converter="{x:Static BoolConverters.Not}"/>
											<Binding Path="HasRoles" FallbackValue="False"/>
										</MultiBinding>
									</Button.IsEnabled>
								</Button>

								<!-- Sekcja "Zainstalowano w:" - ukrywana podczas operacji -->
								<StackPanel Margin="0,25,0,0">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}"/>
											<Binding Path="ShowProgress" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>
									
									<TextBlock Text="{loc:Localize UI.Labels.InstalledIn}:"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   Margin="0,0,0,8"/>
									<Border BorderBrush="{DynamicResource AccentBrush}"
											BorderThickness="1"
											Background="{DynamicResource TertiaryBackgroundBrush}"
											CornerRadius="6"
											Margin="0,0,0,4">
										<SelectableTextBlock Text="{Binding InstallPath, Converter={x:Static converters:PathShorteningConverter.Instance}, ConverterParameter=30}"
															 Background="Transparent"
															 Foreground="{DynamicResource TextPrimaryBrush}"
															 Padding="10"
															 FontFamily="Consolas"
															 FontSize="10"
															 ToolTip.Tip="{Binding InstallPath}"/>
									</Border>
									<Grid ColumnDefinitions="*,5,*">
										<Button Grid.Column="0"
												Content="{loc:Localize UI.Buttons.OpenFolder}"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.OpenFolderCommand}"/>

										<Button Grid.Column="2"
												Content="{loc:Localize UI.Buttons.CreateShortcut}"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.CreateShortcutCommand}"/>
									</Grid>
								</StackPanel>
							</StackPanel>
						</Panel>
					</Panel>
				</Border>
			</Grid>

			<!-- STATUS BAR - Panel statusu na dole -->
			<Border x:Name="StatusBar"
					Grid.Row="1"
					Classes="status-bar">

				<!-- Statystyki modów, dysk, API -->
				<Grid ColumnDefinitions="2*,2*,1*" Margin="20,5,20,5">
					
						<!-- SEKCJA 1: Statystyki modów -->
						<Border Grid.Column="0" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<!-- Ikona -->
								<Border Classes="status-icon-container" Background="#4A148C">
									<TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>

							<!-- Tekst -->
							<StackPanel VerticalAlignment="Center" Spacing="2">
								<!-- Główny tekst - CZERWONY gdy są aktualizacje -->
								<TextBlock Classes="status-main-text"
										   Text="{Binding ModsStatusMainText}"
										   Foreground="#F44336"
										   IsVisible="{Binding !!AvailableUpdatesCount}"/>
								
								<!-- Główny tekst - NORMALNY kolor gdy NIE MA aktualizacji -->
								<TextBlock Classes="status-main-text"
										   Text="{Binding ModsStatusMainText}"
										   IsVisible="{Binding !AvailableUpdatesCount}"/>

								<!-- Tekst pomocniczy - liczba zainstalowanych modów -->
								<TextBlock Classes="status-sub-text" Text="{Binding ModsStatusSubText}"/>
							</StackPanel>
							</StackPanel>

							<!-- Tooltip z listą zainstalowanych i dostępnych aktualizacji -->
							<ToolTip.Tip>
								<TextBlock Text="{Binding ModsStatusTooltip}"
										   FontSize="11"
										   MaxWidth="350"
										   TextWrapping="Wrap"/>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 2: Przestrzeń dyskowa -->
						<Border Grid.Column="1" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<!-- Ikona -->
								<Border Classes="status-icon-container" Background="#0288D1">
									<TextBlock Text="💾" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>
							
								<!-- Tekst i progress bar -->
								<StackPanel VerticalAlignment="Center" Spacing="4" Width="250">
									<TextBlock Classes="status-main-text">
										<Run Text="{Binding ModsFolderSizeGB, StringFormat='{}{0:F2} GB'}"/>
										<Run Text=" / "/>
										<Run Text="{Binding FreeDiskSpaceGB, StringFormat='{}{0:F2} GB'}"/>
									</TextBlock>
								
									<!-- Progress Bar z kolorowaniem -->
									<Grid>
										<ProgressBar Value="{Binding DiskUsagePercentage}"
													 Maximum="100"
													 Height="8"
													 CornerRadius="4"
													 Foreground="{Binding DiskUsagePercentage, Converter={StaticResource DiskUsageColorConverter}}"/>
										<TextBlock Classes="status-sub-text" 
												   HorizontalAlignment="Right"
												   Margin="0,-2,0,0">
											<Run Text="{Binding DiskUsagePercentage, StringFormat='{}{0:F1}%'}"/>
										</TextBlock>
									</Grid>
								</StackPanel>
							</StackPanel>
						
							<!-- Tooltip ze szczegółami -->
							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.Labels.SpaceDetailsHeader}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock Text="{Binding DiskSpaceDetailsTooltip}" FontSize="11"/>
								</StackPanel>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 3: Status API -->
						<Border Grid.Column="2" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
								<!-- Status indicator (kolorowe kółko) -->
								<Ellipse Width="16" Height="16"
										 Fill="{Binding ApiStatusColor}"
										 Classes="status-pulse"/>
							
								<!-- Tekst statusu -->
								<StackPanel VerticalAlignment="Center">
									<TextBlock Classes="status-main-text" Text="{loc:Localize UI.StatusBar.API}"/>
									<TextBlock Classes="status-sub-text" Text="{Binding ApiStatusText}"/>
									<TextBlock Classes="status-sub-text" 
											   Text="{Binding OnlineUsersText}"
											   IsVisible="{Binding IsApiOnline}"/>
								</StackPanel>
							</StackPanel>
						
							<!-- Tooltip ze szczegółami API -->
							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.StatusBar.ServerStatus}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.URL}"/>
										<Run Text="{Binding ApiBaseUrl}"/>
									</TextBlock>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.LastCheck}"/>
										<Run Text="{Binding LastApiCheck, StringFormat='{}{0:HH:mm:ss}'}"/>
									</TextBlock>
									<TextBlock FontSize="11" IsVisible="{Binding IsApiOnline}">
										<Run Text="{loc:Localize UI.StatusBar.Latency}"/>
										<Run Text="{Binding ApiPingMs}"/>
										<Run Text="{loc:Localize UI.StatusBar.Ms}"/>
									</TextBlock>
								</StackPanel>
							</ToolTip.Tip>
						</Border>

				</Grid>
			</Border>

		<!-- FAB Menu Overlay (backdrop) -->
		<Border Grid.Row="0" Grid.RowSpan="2"
				Classes="fab-overlay"
				Classes.visible="{Binding IsPaneOpen}"
				PointerPressed="OnOverlayPressed"/>

		<!-- FAB Container -->
		<Canvas x:Name="FabHost"
				Grid.Row="0"
				Grid.RowSpan="2"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				PointerMoved="OnFabPointerMoved"
				PointerReleased="OnFabPointerReleased">

			<!-- FAB Menu Panel -->
			<Border x:Name="FabMenuPanel"
					Classes="fab-menu-panel"
					Classes.visible="{Binding IsPaneOpen}"
					Canvas.Left="24"
					Canvas.Top="0"
					PointerPressed="OnMenuPanelPressed">

				<StackPanel Spacing="4">
				<!-- Menu Header -->
				<TextBlock Text="{loc:Localize UI.Menu.Title}"
						   FontSize="18"
						   FontWeight="Bold"
						   Margin="4,4,4,12"
						   Foreground="{DynamicResource TextPrimaryBrush}"/>

			<!-- Menu Items with FluentIcons -->
			<Button Classes="fab-menu-item"
					Command="{Binding ShowAdditionalActionsCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Wrench}" FontSize="20" Foreground="#F44336"/>
					<TextBlock Text="{loc:Localize UI.Menu.ToUConfigs}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding ShowDllModificationsCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Code}" FontSize="20" Foreground="#9C27B0"/>
					<TextBlock Text="{loc:Localize UI.Menu.DllMods}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding ShowSUStatsConfigCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.DataBarVertical}" FontSize="20" Foreground="#E91E63"/>
					<TextBlock Text="{loc:Localize UI.Menu.SUStats}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding FixBlackScreenCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Toolbox}" FontSize="20" Foreground="#FF9800"/>
					<TextBlock Text="{loc:Localize UI.Menu.RepairGame}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding CheckForAppUpdatesCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowClockwise}" FontSize="20" Foreground="#03A9F4"/>
					<TextBlock Text="{loc:Localize UI.Menu.CheckAppUpdates}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding ShowAppSettingsCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Settings}" FontSize="20" Foreground="#2196F3"/>
					<TextBlock Text="{loc:Localize UI.Menu.Settings}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding ShowRecommendedDiscordsCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.PeopleTeam}" FontSize="20" Foreground="#4CAF50"/>
					<TextBlock Text="{loc:Localize UI.Menu.RecommendedDiscords}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="fab-menu-item"
					Command="{Binding ShowInfoCommand}">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}" FontSize="20" Foreground="#00BCD4"/>
					<TextBlock Text="{loc:Localize UI.Menu.Info}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

					<Border Classes="fab-menu-separator"/>
					<!-- Theme toggle at bottom -->
					<Button Classes="fab-menu-item"
							Command="{Binding ToggleThemeCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock Text="{Binding ThemeButtonIcon}" FontSize="20" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</Border>

				<!-- FAB Button (draggable, initially bottom-left) -->
				<Button x:Name="FabButton"
						Classes="fab"
						Classes.active="{Binding IsPaneOpen}"
						Command="{Binding TogglePaneCommand}"
						Width="56"
						Height="56"
						Canvas.Left="24"
						Canvas.Top="0"
						PointerPressed="OnFabPointerPressed"
						PointerMoved="OnFabPointerMoved"
						PointerReleased="OnFabPointerReleased">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Navigation}" FontSize="20" Foreground="White"/>
				</Button>

			</Canvas>

	</Grid>
</Window>
