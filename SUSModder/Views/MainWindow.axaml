<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Views"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:converters="using:SUSModder.Converters"
        xmlns:labs="using:Avalonia.Labs.Panels"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        x:Class="SUSModder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="890" Height="835"
        MinWidth="890" MinHeight="820">
	<Window.Resources>
		<converters:StringNotNullOrEmptyToBoolConverter x:Key="StringNotNullOrEmptyToBoolConverter"/>
		<converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
		<converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
		<converters:DiskUsageColorConverter x:Key="DiskUsageColorConverter"/>
		<converters:UpdatesColorConverter x:Key="UpdatesColorConverter"/>
		<converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
	</Window.Resources>

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<!-- Importowane style -->
		<StyleInclude Source="/Styles/ModCardStyle.axaml"/>
		<StyleInclude Source="/Styles/MenuButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/PanelStyles.axaml"/>
		<StyleInclude Source="/Styles/StatusBarStyle.axaml"/>
	</Window.Styles>

	<!-- Main Grid replacing SplitView -->
	<Grid Background="{DynamicResource HeartsBackgroundBrush}" RowDefinitions="*,Auto">
		
		<!-- Main Content Area -->
		<Grid Grid.Row="0" ColumnDefinitions="*, Auto">

				<ListBox Grid.Column="0" Margin="10"
						 ItemsSource="{Binding Mods}"
						 SelectedItem="{Binding SelectedMod}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<labs:FlexPanel Direction="Row" 
											Wrap="Wrap"
											JustifyContent="FlexStart"
											AlignItems="FlexStart"
											AlignContent="FlexStart"
											RowSpacing="0"
											ColumnSpacing="0">
								<i:Interaction.Behaviors>
									<behaviors:LayoutAnimationBehavior/>
								</i:Interaction.Behaviors>
							</labs:FlexPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Classes="mod-card"
									ToolTip.ShowDelay="300">
								<i:Interaction.Behaviors>
									<behaviors:DoubleClickBehavior 
										DoubleClickCommand="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
										CommandParameter="{Binding}" 
										DoubleClickInterval="300" />
								</i:Interaction.Behaviors>
								<ToolTip.Tip>
									<StackPanel MaxWidth="300">
										<TextBlock Text="{Binding Name}" 
												   FontWeight="Bold" 
												   FontSize="13"
												   Margin="0,0,0,5"/>
										<TextBlock Text="{Binding Description, Converter={StaticResource StringTruncateConverter}, ConverterParameter=150}" 
												   TextWrapping="Wrap"
												   FontSize="11"/>
									</StackPanel>
								</ToolTip.Tip>
								<StackPanel>
									<Image Classes="mod-icon"
										   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
										   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
									<TextBlock Classes="mod-name"
											   Text="{Binding Name}"
											   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<!-- Panel po prawej stronie z nowym stylingiem -->
				<Border Grid.Column="1"
						Margin="15,10,10,10"
						Background="{DynamicResource SecondaryBackgroundBrush}"
						BorderBrush="{DynamicResource AccentBrush}"
						BorderThickness="1"
						CornerRadius="12"
						BoxShadow="0 4 16 0 #20000000"
						Width="350"
						MaxWidth="400">
					<Border.IsVisible>
						<Binding Path="IsModSelected"/>
					</Border.IsVisible>

					<Panel Margin="20">
						<!-- Panel modów z animacją slide od prawej -->
						<Panel Classes="fade-in-panel">
							<Panel.IsVisible>
								<Binding Path="IsModSelected"/>
							</Panel.IsVisible>

							<StackPanel DataContext="{Binding SelectedMod}"
										Classes="mod-content-slide"
										Classes.visible="{Binding $parent[local:MainWindow].DataContext.IsModContentVisible}">
								<!-- Header z akcentem i developer menu -->
								<Border Background="{DynamicResource AccentBrush}"
										CornerRadius="8"
										Padding="15"
										Margin="0,0,0,20">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Istniejący content headera moda -->
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
											<Image Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
												   Width="64" Height="64"
												   HorizontalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}"
														   FontSize="20" FontWeight="Bold"
														   Foreground="White"
														   TextWrapping="Wrap"/>
												<TextBlock FontSize="11" Foreground="#E0FFFFFF">
													<Run Text="{loc:Localize UI.Labels.ModVersion}"/>
													<Run Text=":"/>
													<Run Text="{Binding ModVersion}"/>
												</TextBlock>
												<TextBlock FontSize="10"
														   Foreground="#FFF8D18B"
														   IsVisible="{Binding IsPinnedVersionInstall}"
														   Text="{loc:Localize UI.Labels.PinnedVersionInfo}"/>
												<TextBlock FontSize="11" Foreground="#E0FFFFFF">
													<Run Text="{loc:Localize UI.Labels.GameVersion}"/>
													<Run Text=":"/>
													<Run Text="{Binding AmongVersion}"/>
												</TextBlock>
											</StackPanel>
										</StackPanel>

										<!-- Developer menu dla konkretnego moda -->
										<Button Grid.Column="1"
												x:Name="ModDeveloperMenuButton"
												Content="⋯"
												FontSize="18"
												FontWeight="Bold"
												Width="32"
												Height="32"
												Background="Transparent"
												BorderThickness="0"
												HorizontalContentAlignment="Center"
												VerticalContentAlignment="Center"
												Foreground="White"
												VerticalAlignment="Top"
												HorizontalAlignment="Right"
												IsVisible="{Binding $parent[local:MainWindow].DataContext.IsDeveloperMode}"
												Click="ModDeveloperMenuButton_Click">
											<Button.Styles>
												<Style Selector="Button:pointerover">
													<Setter Property="Background" Value="#40FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
												<Style Selector="Button:pressed">
													<Setter Property="Background" Value="#60FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
											</Button.Styles>

											<!-- Flyout menu -->
											<Button.Flyout>
												<MenuFlyout>
													<MenuItem Header="{loc:Localize MainWindow.DeveloperMenu.RemoveSingleInstance}">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].RemoveSingleInstanceCommand"/>
														</MenuItem.Command>
													</MenuItem>
													<MenuItem Header="{loc:Localize MainWindow.DeveloperMenu.LaunchMultipleInstances}">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].LaunchMultipleInstancesCommand"/>
														</MenuItem.Command>
													</MenuItem>
												</MenuFlyout>
											</Button.Flyout>
										</Button>
										</Grid>
								</Border>

								<ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
									<StackPanel x:Name="DescriptionPanel" Orientation="Vertical"/>
								</ScrollViewer>

							<!-- PROGRESS BAR -->
							<Border IsVisible="{Binding ShowProgress}"
									Background="{DynamicResource TertiaryBackgroundBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="15"
									Margin="0,0,0,10">
								<StackPanel>
									<TextBlock Text="{Binding InstallStatusMessage}"
											   FontSize="12"
											   Foreground="{DynamicResource TextPrimaryBrush}"
											   TextAlignment="Center"
											   Margin="0,0,0,8"/>
									<ProgressBar Value="{Binding InstallProgress}"
												 Minimum="0"
												 Maximum="100"
												 Height="24"
												 CornerRadius="12"
												 Background="{DynamicResource WindowBackgroundBrush}"
												 Foreground="{DynamicResource AccentBrush}"/>
									<TextBlock Text="{Binding InstallProgress, StringFormat='{}{0}%'}"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   TextAlignment="Center"
											   Margin="0,5,0,0"/>
								</StackPanel>
							</Border>								<!-- Przyciski dla Vanilla - tylko Uruchom -->
								<StackPanel IsVisible="{Binding IsVanilla}" Spacing="10">
									<Button Content="{loc:Localize UI.Buttons.Launch}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>
								</StackPanel>

								<!-- Przyciski dla niezainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}" ConverterParameter="Invert"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="{loc:Localize UI.Buttons.InstallLatest}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.InstallCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.SelectVersion}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="13"
											Background="{DynamicResource SecondaryBackgroundBrush}"
											BorderBrush="{DynamicResource AccentBrush}"
											BorderThickness="1"
											Foreground="{DynamicResource TextPrimaryBrush}"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.InstallWithVersionSelectionCommand}"/>
								</StackPanel>

								<!-- Przyciski dla zainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="{loc:Localize UI.Buttons.Launch}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.Update}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UpdateCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.Delete}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DangerBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UninstallCommand}"/>

									<Button Content="{loc:Localize UI.Buttons.AddDll}"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DllButtonBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.ShowDllSelectionCommand}"/>
								</StackPanel>

								<!-- Przycisk Role - widoczny dla modów z opisami ról (NIE dla Vanilla) -->
								<Button Content="{loc:Localize UI.Buttons.Roles}"
										HorizontalAlignment="Stretch"
										Margin="0,10,0,0"
										Padding="12"
										CornerRadius="8"
										FontSize="14"
										FontWeight="SemiBold"
										Background="{DynamicResource ModCardBackgroundBrush}"
										Foreground="{DynamicResource TextPrimaryBrush}"
										BorderBrush="{DynamicResource ModCardBorderBrush}"
										BorderThickness="1"
										Command="{Binding $parent[local:MainWindow].DataContext.ShowRolesCommand}">
									<Button.IsVisible>
										<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
									</Button.IsVisible>
									<Button.IsEnabled>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="IsInstalling" Converter="{x:Static BoolConverters.Not}"/>
											<Binding Path="HasRoles" FallbackValue="False"/>
										</MultiBinding>
									</Button.IsEnabled>
								</Button>

								<!-- Sekcja "Zainstalowano w:" - ukrywana podczas operacji -->
								<StackPanel Margin="0,25,0,0">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}"/>
											<Binding Path="ShowProgress" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>
									
									<TextBlock Text="{loc:Localize UI.Labels.InstalledIn}:"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   Margin="0,0,0,8"/>
									<Border BorderBrush="{DynamicResource AccentBrush}"
											BorderThickness="1"
											Background="{DynamicResource TertiaryBackgroundBrush}"
											CornerRadius="6"
											Margin="0,0,0,4">
										<SelectableTextBlock Text="{Binding InstallPath, Converter={x:Static converters:PathShorteningConverter.Instance}, ConverterParameter=30}"
															 Background="Transparent"
															 Foreground="{DynamicResource TextPrimaryBrush}"
															 Padding="10"
															 FontFamily="Consolas"
															 FontSize="10"
															 ToolTip.Tip="{Binding InstallPath}"/>
									</Border>
									<Grid ColumnDefinitions="*,5,*">
										<Button Grid.Column="0"
												Content="{loc:Localize UI.Buttons.OpenFolder}"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.OpenFolderCommand}"/>

										<Button Grid.Column="2"
												Content="{loc:Localize UI.Buttons.CreateShortcut}"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.CreateShortcutCommand}"/>
									</Grid>
								</StackPanel>
							</StackPanel>
						</Panel>
					</Panel>
				</Border>
			</Grid>

			<!-- STATUS BAR - Panel statusu na dole -->
			<Border x:Name="StatusBar"
					Grid.Row="1"
					Classes="status-bar">

				<Grid ColumnDefinitions="Auto,*,Auto" Margin="16,5,16,5" ColumnSpacing="6">
					<Grid Grid.Column="0"
						  Width="56" Height="56">
						<Button x:Name="FabButton"
								Classes="fab"
								Classes.active="{Binding IsPaneOpen}"
								Command="{Binding TogglePaneCommand}">
							<ToolTip.Tip>
								<TextBlock Text="{Binding FabBadgeTooltip}" FontSize="11" MaxWidth="200" TextWrapping="Wrap"/>
							</ToolTip.Tip>
							<Grid>
								<!-- Navigation icon (default, no updates) -->
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Navigation}" FontSize="20" Foreground="White"
											   IsVisible="{Binding !FabHasBadge}"/>
								<!-- ArrowDownload icon (updates available) -->
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowDownload}" FontSize="20" Foreground="White"
											   IsVisible="{Binding FabHasBadge}"/>
							</Grid>
						</Button>
						<Border Classes="fab-badge"
								IsVisible="{Binding FabHasBadge}"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Margin="0,-3,-3,0">
							<TextBlock Text="{Binding FabBadgeCount}" FontSize="9"
									   Foreground="White"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Border>
					</Grid>

					<Border Grid.Column="1"
							Classes="statusbar-discord-promo"
							IsVisible="{Binding IsDiscordPromoStatusBarMode}">
						<Grid>
							<Grid x:Name="FabDiscordPromoContent"
								  Classes="fab-discord-promo-content visible"
								  IsVisible="{Binding HasPromotedDiscord}"
								  ColumnDefinitions="Auto,*,Auto"
								  ColumnSpacing="10">
								<Grid Grid.Column="0" Width="40" Height="40">
									<Border Width="40" Height="40"
											CornerRadius="20"
											Background="{DynamicResource AccentBrush}"
											IsVisible="{Binding CurrentPromotedDiscordHasIcon, Converter={x:Static BoolConverters.Not}}">
										<TextBlock Text="💬"
												   FontSize="16"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"
												   Foreground="White"/>
									</Border>

									<Border Width="40" Height="40"
											CornerRadius="20"
											ClipToBounds="True"
											IsVisible="{Binding CurrentPromotedDiscordHasIcon}">
										<Image Source="{Binding CurrentPromotedDiscordIconBitmap}"
											   Width="40"
											   Height="40"
											   Stretch="UniformToFill"/>
									</Border>
								</Grid>

								<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
									<TextBlock Text="{Binding CurrentPromotedDiscordName}"
											   FontSize="13"
											   FontWeight="SemiBold"
											   TextTrimming="CharacterEllipsis"
											   Foreground="{DynamicResource TextPrimaryBrush}"/>
									<TextBlock Text="{Binding CurrentPromotedDiscordDescription}"
											   FontSize="11"
											   MaxLines="2"
											   TextWrapping="Wrap"
											   TextTrimming="CharacterEllipsis"
											   Foreground="{DynamicResource TextSecondaryBrush}"/>
								</StackPanel>

								<Button Grid.Column="2"
										Classes="fab-discord-promo-join"
										Content="{loc:Localize RecommendedDiscords.JoinButton}"
										Command="{Binding OpenPromotedDiscordInviteCommand}"
									CommandParameter="{Binding CurrentPromotedDiscordInviteLink}"/>
							</Grid>

							<TextBlock Text="{loc:Localize RecommendedDiscords.LoadingServers}"
									   FontSize="12"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   VerticalAlignment="Center"
									   HorizontalAlignment="Center"
									   IsVisible="{Binding HasPromotedDiscord, Converter={x:Static BoolConverters.Not}}"/>
						</Grid>
					</Border>

					<Grid Grid.Column="1"
						  IsVisible="{Binding IsSystemStatusBarMode}"
						  ColumnDefinitions="2*,2*,1*"
						  ColumnSpacing="10">
						<!-- SEKCJA 1: Statystyki modów -->
						<Border Grid.Column="0" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<Border Classes="status-icon-container" Background="#4A148C">
									<TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>

								<StackPanel VerticalAlignment="Center" Spacing="2">
									<TextBlock Classes="status-main-text"
											   Text="{Binding ModsStatusMainText}"
											   Foreground="#F44336"
											   IsVisible="{Binding !!AvailableUpdatesCount}"/>
									<TextBlock Classes="status-main-text"
											   Text="{Binding ModsStatusMainText}"
											   IsVisible="{Binding !AvailableUpdatesCount}"/>
									<TextBlock Classes="status-sub-text" Text="{Binding ModsStatusSubText}"/>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<TextBlock Text="{Binding ModsStatusTooltip}"
										   FontSize="11"
										   MaxWidth="350"
										   TextWrapping="Wrap"/>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 2: Przestrzeń dyskowa -->
						<Border Grid.Column="1" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="15">
								<Border Classes="status-icon-container" Background="#0288D1">
									<TextBlock Text="💾" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								</Border>

								<StackPanel VerticalAlignment="Center" Spacing="4" Width="250">
									<TextBlock Classes="status-main-text">
										<Run Text="{Binding ModsFolderSizeGB, StringFormat='{}{0:F2} GB'}"/>
										<Run Text=" / "/>
										<Run Text="{Binding FreeDiskSpaceGB, StringFormat='{}{0:F2} GB'}"/>
									</TextBlock>

									<Grid>
										<ProgressBar Value="{Binding DiskUsagePercentage}"
													 Maximum="100"
													 Height="8"
													 CornerRadius="4"
													 Foreground="{Binding DiskUsagePercentage, Converter={StaticResource DiskUsageColorConverter}}"/>
										<TextBlock Classes="status-sub-text"
												   HorizontalAlignment="Right"
												   Margin="0,-2,0,0">
											<Run Text="{Binding DiskUsagePercentage, StringFormat='{}{0:F1}%'}"/>
										</TextBlock>
									</Grid>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.Labels.SpaceDetailsHeader}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock Text="{Binding DiskSpaceDetailsTooltip}" FontSize="11"/>
								</StackPanel>
							</ToolTip.Tip>
						</Border>

						<!-- SEKCJA 3: Status API -->
						<Border Grid.Column="2" Classes="status-section">
							<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
								<Ellipse Width="16" Height="16"
										 Fill="{Binding ApiStatusColor}"
										 Classes="status-pulse"/>

								<StackPanel VerticalAlignment="Center">
									<TextBlock Classes="status-main-text" Text="{loc:Localize UI.StatusBar.API}"/>
									<TextBlock Classes="status-sub-text" Text="{Binding ApiStatusText}"/>
									<TextBlock Classes="status-sub-text"
											   Text="{Binding OnlineUsersText}"
											   IsVisible="{Binding IsApiOnline}"/>
								</StackPanel>
							</StackPanel>

							<ToolTip.Tip>
								<StackPanel>
									<TextBlock Text="{loc:Localize UI.StatusBar.ServerStatus}" FontWeight="Bold" Margin="0,0,0,5"/>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.URL}"/>
										<Run Text="{Binding ApiBaseUrl}"/>
									</TextBlock>
									<TextBlock FontSize="11">
										<Run Text="{loc:Localize UI.StatusBar.LastCheck}"/>
										<Run Text="{Binding LastApiCheck, StringFormat='{}{0:HH:mm:ss}'}"/>
									</TextBlock>
									<TextBlock FontSize="11" IsVisible="{Binding IsApiOnline}">
										<Run Text="{loc:Localize UI.StatusBar.Latency}"/>
										<Run Text="{Binding ApiPingMs}"/>
										<Run Text="{loc:Localize UI.StatusBar.Ms}"/>
									</TextBlock>
								</StackPanel>
							</ToolTip.Tip>
						</Border>
					</Grid>

					<Button Grid.Column="2"
							Classes="statusbar-toggle-button"
							Command="{Binding ToggleStatusBarModeCommand}">
						<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSwap}" FontSize="20"/>
						<ToolTip.Tip>
							<StackPanel>
								<TextBlock Text="{loc:Localize UI.StatusBar.SwitchToSystemStatus}"
										   IsVisible="{Binding IsDiscordPromoStatusBarMode}"/>
								<TextBlock Text="{loc:Localize UI.StatusBar.SwitchToDiscordPromo}"
										   IsVisible="{Binding IsSystemStatusBarMode}"/>
							</StackPanel>
						</ToolTip.Tip>
					</Button>
				</Grid>
			</Border>

			<!-- Modal dla paneli narzędziowych -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsAnyToolModalOpen}"
					PointerPressed="OnToolModalOverlayPressed">
				<Border Classes="tool-modal-card"
						PointerPressed="OnToolModalPanelPressed">
					<Grid RowDefinitions="Auto,*">
						<Grid ColumnDefinitions="*,Auto" Margin="24,20,24,14">
							<TextBlock Grid.Column="0"
									   Text="{Binding ToolModalTitle}"
									   FontSize="20"
									   FontWeight="Bold"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Classes="statusbar-toggle-button"
									Command="{Binding CloseToolModalCommand}">
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}" FontSize="20"/>
							</Button>
						</Grid>

					<Grid Grid.Row="1" Margin="24,0,24,24">
								<local:InfoPanel IsVisible="{Binding IsInfoPanelVisible}"
												 DataContext="{Binding}"
												 Classes="fade-in-panel"/>

								<local:AdditionalActionsPanel IsVisible="{Binding IsAdditionalActionsVisible}"
															  DataContext="{Binding}"
															  Classes="fade-in-panel"/>

								<Panel IsVisible="{Binding IsSUStatsConfigVisible}" Classes="fade-in-panel">
									<local:SUStatsConfigView/>
								</Panel>

								<Panel IsVisible="{Binding IsAppSettingsVisible}" Classes="fade-in-panel">
									<local:AppSettingsView/>
								</Panel>

								<local:DllManagementPanel IsVisible="{Binding IsDllModalVisible}"/>

							<ContentControl Content="{Binding DllSelectionModalViewModel}"
												Classes="fade-in-panel"
												IsVisible="{Binding IsDllSelectionModalVisible}">
								<ContentControl.DataTemplates>
									<DataTemplate DataType="vm:DllModSelectionViewModel">
										<local:DllModSelectionView/>
									</DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>

								<Panel IsVisible="{Binding IsRecommendedDiscordsVisible}" Classes="fade-in-panel">
									<local:RecommendedDiscordsPanel/>
								</Panel>

							<Panel IsVisible="{Binding IsRepairOptionsVisible}" Classes="fade-in-panel">
								<local:RepairOptionsPanel/>
							</Panel>

							<ContentControl Content="{Binding VersionSelectionModalViewModel}"
											IsVisible="{Binding IsVersionSelectionModalVisible}"
											Classes="fade-in-panel">
								<ContentControl.DataTemplates>
									<DataTemplate DataType="vm:VersionSelectionViewModel">
										<local:VersionSelectionPanel/>
									</DataTemplate>
								</ContentControl.DataTemplates>
							</ContentControl>
						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- Globalny modal dla komunikatów/potwierdzeń/prompt -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsInlineDialogVisible}"
					PointerPressed="OnInlineDialogOverlayPressed">
				<Border Classes="tool-modal-card"
						Width="560"
						MaxWidth="640"
						MaxHeight="500"
						MinHeight="220"
						PointerPressed="OnInlineDialogCardPressed">
					<Grid RowDefinitions="Auto,*,Auto">
						<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,8">
							<TextBlock Grid.Column="0"
									   Text="{Binding InlineDialogTitle}"
									   FontSize="18"
									   FontWeight="Bold"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Classes="statusbar-toggle-button"
									IsVisible="{Binding IsInlineDialogDismissible}"
									Click="OnInlineDialogSecondaryClick">
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}" FontSize="20"/>
							</Button>
						</Grid>

						<StackPanel Grid.Row="1" Margin="20,0,20,10" Spacing="10">
							<ScrollViewer MaxHeight="240"
										  VerticalScrollBarVisibility="Auto">
								<TextBlock Text="{Binding InlineDialogMessage}"
										   TextWrapping="Wrap"
										   FontSize="13"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
							</ScrollViewer>

							<Border IsVisible="{Binding IsInlineDialogPrompt}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Background="{DynamicResource SecondaryBackgroundBrush}">
								<TextBox Text="{Binding InlineDialogInputText, Mode=TwoWay}"
										 PlaceholderText="{loc:Localize PromptDialog.EnterNamePlaceholder}"
										 AcceptsReturn="True"
										 TextWrapping="Wrap"
										 MinHeight="120"
										 Background="Transparent"
										 BorderThickness="0"
										 Padding="10"/>
							</Border>
						</StackPanel>

						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Spacing="10"
									Margin="20,0,20,16">
							<Button Content="{Binding InlineDialogSecondaryButtonText}"
									IsVisible="{Binding IsInlineDialogSecondaryVisible}"
									MinWidth="100"
									Padding="10,8"
									Background="{DynamicResource ModCardBackgroundBrush}"
									Foreground="{DynamicResource TextPrimaryBrush}"
									BorderBrush="{DynamicResource ModCardBorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Click="OnInlineDialogSecondaryClick"/>
							<Button Content="{Binding InlineDialogPrimaryButtonText}"
									MinWidth="100"
									Padding="10,8"
									Background="{DynamicResource AccentBrush}"
									Foreground="White"
									CornerRadius="6"
									Click="OnInlineDialogPrimaryClick"/>
						</StackPanel>
					</Grid>
				</Border>
			</Border>

			<!-- Modal ostrzeżenia antywirusowego -->
			<Border Grid.Row="0"
					Grid.RowSpan="2"
					Classes="tool-modal-overlay"
					IsVisible="{Binding IsAntivirusWarningVisible}">
				<Border Classes="tool-modal-card"
						Width="620"
						MaxWidth="680"
						MaxHeight="560"
						MinHeight="300"
						PointerPressed="OnAntivirusWarningCardPressed">
					<Grid RowDefinitions="Auto,*,Auto" Margin="24,22,24,18">
						<StackPanel Grid.Row="0" Spacing="10">
							<TextBlock Text="{Binding AntivirusWarningTitle}"
									   FontSize="20"
									   FontWeight="Bold"/>
							<TextBlock Text="{Binding AntivirusWarningIntro}"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
						</StackPanel>

						<ScrollViewer Grid.Row="1"
								  Margin="0,18,0,18"
								  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="14">
								<StackPanel Spacing="8">
									<TextBlock Text="{Binding AntivirusWarningProductsHeader}"
										   FontSize="14"
										   FontWeight="SemiBold"/>
									<ItemsControl ItemsSource="{Binding AntivirusWarningProducts}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,2">
													<TextBlock Text="•"
															   FontSize="18"
															   Foreground="{DynamicResource AccentBrush}"/>
													<TextBlock Text="{Binding .}"
															   TextWrapping="Wrap"
															   Foreground="{DynamicResource TextPrimaryBrush}"/>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<Border BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="14"
										Background="{DynamicResource SecondaryBackgroundBrush}">
									<TextBlock Text="{Binding AntivirusWarningRecommendation}"
										   TextWrapping="Wrap"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
								</Border>
							</StackPanel>
						</ScrollViewer>

						<Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="14">
							<CheckBox Content="{Binding AntivirusWarningCheckboxText}"
									  IsChecked="{Binding IsAntivirusWarningAcknowledged, Mode=TwoWay}"
									  Foreground="{DynamicResource TextPrimaryBrush}"/>
							<Button Grid.Row="1"
									Content="OK"
									HorizontalAlignment="Right"
									MinWidth="110"
									Padding="10,8"
									Background="{DynamicResource AccentBrush}"
									Foreground="White"
									CornerRadius="6"
									IsEnabled="{Binding CanConfirmAntivirusWarning}"
									Click="OnAntivirusWarningConfirmClick"/>
						</Grid>
					</Grid>
				</Border>
			</Border>

			<!-- FAB Menu Overlay (backdrop) -->
			<Border Grid.Row="0" Grid.RowSpan="2"
					Classes="fab-overlay"
					Classes.visible="{Binding IsPaneOpen}"
					PointerPressed="OnOverlayPressed"/>

			<!-- FAB Menu Panel -->
			<Border x:Name="FabMenuPanel"
					Grid.Row="0"
					Grid.RowSpan="2"
					Classes="fab-menu-panel"
					Classes.visible="{Binding IsPaneOpen}"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Margin="20,0,0,96"
					PointerPressed="OnMenuPanelPressed">

				<StackPanel Spacing="4">
					<!-- Menu Header -->
					<TextBlock Text="{loc:Localize UI.Menu.Title}"
							   FontSize="18"
							   FontWeight="Bold"
							   Margin="4,4,4,12"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>

					<!-- Menu Items with FluentIcons -->
					<!-- Sprawdź aktualizacje modów -->
					<Button Classes="fab-menu-item"
							Command="{Binding CheckForModUpdatesFromMenuCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Grid>
								<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowDownload}" 
											  FontSize="20" Foreground="#FF5722"/>
								<Border Classes="fab-menu-item-badge"
										IsVisible="{Binding FabHasBadge}">
									<TextBlock Text="{Binding FabBadgeCount}" FontSize="9" 
											  Foreground="White"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
								</Border>
							</Grid>
							<TextBlock Text="{loc:Localize UI.Menu.CheckModUpdates}" 
									  VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding FixBlackScreenCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Toolbox}" FontSize="20" Foreground="#FF9800"/>
							<TextBlock Text="{loc:Localize UI.Menu.RepairGame}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowAdditionalActionsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Wrench}" FontSize="20" Foreground="#F44336"/>
							<TextBlock Text="{loc:Localize UI.Menu.ToUConfigs}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowRecommendedDiscordsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.PeopleTeam}" FontSize="20" Foreground="#4CAF50"/>
							<TextBlock Text="{loc:Localize UI.Menu.RecommendedDiscords}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowSUStatsConfigCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.DataBarVertical}" FontSize="20" Foreground="#E91E63"/>
							<TextBlock Text="{loc:Localize UI.Menu.SUStats}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowAppSettingsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Settings}" FontSize="20" Foreground="#2196F3"/>
							<TextBlock Text="{loc:Localize UI.Menu.Settings}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Button Classes="fab-menu-item"
							Command="{Binding ShowInfoCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}" FontSize="20" Foreground="#00BCD4"/>
							<TextBlock Text="{loc:Localize UI.Menu.Info}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Border Classes="fab-menu-separator"/>
					<Button Classes="fab-menu-item"
							Command="{Binding ToggleThemeCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<TextBlock Text="{Binding ThemeButtonIcon}" FontSize="20" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding ThemeButtonText}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Border>

	</Grid>
</Window>
