<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Views"
        xmlns:converters="using:SUSModder.Converters"
        xmlns:labs="using:Avalonia.Labs.Panels"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:behaviors="using:SUSModder.Behaviors"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        x:Class="SUSModder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="820"
        MinWidth="800" MinHeight="770">
	<Window.Resources>
		<converters:StringNotNullOrEmptyToBoolConverter x:Key="StringNotNullOrEmptyToBoolConverter"/>
		<converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
		<converters:InstallStatusToOpacityConverter x:Key="InstallStatusToOpacityConverter"/>
		<converters:DiskUsageColorConverter x:Key="DiskUsageColorConverter"/>
		<converters:StringTruncateConverter x:Key="StringTruncateConverter"/>
	</Window.Resources>

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<FluentTheme />
		<!-- Importowane style -->
		<StyleInclude Source="/Styles/AnimationStyles.axaml"/>
		<StyleInclude Source="/Styles/ModCardStyle.axaml"/>
		<StyleInclude Source="/Styles/MenuButtonStyle.axaml"/>
		<StyleInclude Source="/Styles/PanelStyles.axaml"/>
		<StyleInclude Source="/Styles/StatusBarStyle.axaml"/>
	</Window.Styles>

	<SplitView x:Name="MainSplitView"
               IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="CompactOverlay"
               PaneBackground="{DynamicResource PaneBackgroundBrush}"
               OpenPaneLength="220">

		<SplitView.Pane>
			<Grid RowDefinitions="Auto,*,Auto" Margin="10,40,10,0">
				<!-- Menu główne na górze -->
				<StackPanel Grid.Row="0">

					<!-- Hamburger menu button -->
					<Button Classes="hamburger-button"
							Command="{Binding TogglePaneCommand}">
						<TextBlock Text="☰" Classes="menu-icon"/>
					</Button>


					<!-- Menu options with icons and text -->
					<Button Classes="menu-button"
							Margin="0,15,0,0"
							Command="{Binding ShowAdditionalActionsCommand}">
						<StackPanel Classes="menu-item">
							<TextBlock Text="🛠️" Classes="menu-icon"/>
							<TextBlock Text="Konfiguracje ToU"
									   Classes="menu-text"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>
					<Button Margin="0,0,0,5"
							HorizontalContentAlignment="Left"
							Padding="0,10"
							Background="Transparent"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Command="{Binding ShowDllModificationsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🔧" FontSize="18"/>
							<TextBlock Text="Modyfikacje DLL"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>
					<Button Margin="0,0,0,5"
							HorizontalContentAlignment="Left"
							Padding="0,10"
							Background="Transparent"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Command="{Binding ShowSUStatsConfigCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="📊" FontSize="18"/>
							<TextBlock Text="SUStats - konfiguracje"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>

					<Button Margin="0,0,0,5"
							HorizontalContentAlignment="Left"
							Padding="0,10"
							Background="Transparent"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Command="{Binding FixBlackScreenCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🔨" FontSize="18"/>
							<TextBlock Text="Napraw Amonga"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>
					<Button Margin="0,0,0,5"
						HorizontalContentAlignment="Left"
						Padding="0,10"
						Background="Transparent"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Command="{Binding ShowAppSettingsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="⚙️" FontSize="18"/>
							<TextBlock Text="Ustawienia aplikacji"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>
					<Button Margin="0,0,0,5"
						HorizontalContentAlignment="Left"
						Padding="0,10"
						Background="Transparent"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Command="{Binding ShowRecommendedDiscordsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="👥" FontSize="18"/>
							<TextBlock Text="Polecane Discordy"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>
					<Button Margin="0,0,0,5"
							HorizontalContentAlignment="Left"
							Padding="0,10"
							Background="Transparent"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Command="{Binding ShowInfoCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="ℹ️" FontSize="18"/>
							<TextBlock Text="Informacje"
									   VerticalAlignment="Center"
									   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
						</StackPanel>
					</Button>


				</StackPanel>

				<!-- Przycisk motywu na dole -->
				<Button Grid.Row="2"
						Command="{Binding ToggleThemeCommand}"
						Margin="0,0,0,0"
						HorizontalContentAlignment="Left"
						Padding="0,10"
						Background="Transparent"
						Foreground="{DynamicResource TextPrimaryBrush}"
						DockPanel.Dock="Bottom">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="{Binding ThemeButtonIcon}" FontSize="18"/>
						<TextBlock Text="{Binding ThemeButtonText}"
								   VerticalAlignment="Center"
								   IsVisible="{Binding IsPaneOpen, ElementName=MainSplitView}"/>
					</StackPanel>
				</Button>
			</Grid>
		</SplitView.Pane>

		<Grid Background="{DynamicResource HeartsBackgroundBrush}" RowDefinitions="*,Auto">
			<Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">

				<ListBox Grid.Column="0" Margin="10"
						 ItemsSource="{Binding Mods}"
						 SelectedItem="{Binding SelectedMod}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<labs:FlexPanel Direction="Row" 
											Wrap="Wrap"
											JustifyContent="FlexStart"
											AlignItems="FlexStart"
											AlignContent="FlexStart"
											RowSpacing="0"
											ColumnSpacing="0">
								<i:Interaction.Behaviors>
									<behaviors:LayoutAnimationBehavior/>
								</i:Interaction.Behaviors>
							</labs:FlexPanel>
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Classes="mod-card"
									ToolTip.ShowDelay="300">
								<i:Interaction.Behaviors>
									<behaviors:DoubleClickBehavior 
										DoubleClickCommand="{Binding $parent[Window].DataContext.ModDoubleClickCommand}"
										CommandParameter="{Binding}" 
										DoubleClickInterval="300" />
								</i:Interaction.Behaviors>
								<ToolTip.Tip>
									<StackPanel MaxWidth="300">
										<TextBlock Text="{Binding Name}" 
												   FontWeight="Bold" 
												   FontSize="13"
												   Margin="0,0,0,5"/>
										<TextBlock Text="{Binding Description, Converter={StaticResource StringTruncateConverter}, ConverterParameter=150}" 
												   TextWrapping="Wrap"
												   FontSize="11"/>
									</StackPanel>
								</ToolTip.Tip>
								<StackPanel>
									<Image Classes="mod-icon"
										   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
										   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
									<TextBlock Classes="mod-name"
											   Text="{Binding Name}"
											   Opacity="{Binding InstallPath, Converter={StaticResource InstallStatusToOpacityConverter}}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<GridSplitter Grid.Column="1" Width="2"
							  Background="{DynamicResource GridSplitterBrush}"
							  VerticalAlignment="Stretch" HorizontalAlignment="Center">
					<GridSplitter.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="IsModSelected"/>
							<Binding Path="IsInfoPanelVisible"/>
							<Binding Path="IsAdditionalActionsVisible"/>
							<Binding Path="IsDllModificationsVisible"/>
						</MultiBinding>
					</GridSplitter.IsVisible>
				</GridSplitter>

				<!-- Panel po prawej stronie z nowym stylingiem -->
				<Border Grid.Column="2"
						Margin="15,10,10,10"
						Background="{DynamicResource SecondaryBackgroundBrush}"
						BorderBrush="{DynamicResource AccentBrush}"
						BorderThickness="1"
						CornerRadius="12"
						BoxShadow="0 4 16 0 #20000000"
						Width="350"
						MaxWidth="400">
					<Border.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.Or}">
							<Binding Path="IsModSelected"/>
							<Binding Path="IsInfoPanelVisible"/>
							<Binding Path="IsAdditionalActionsVisible"/>
							<Binding Path="IsDllModificationsVisible"/>
						</MultiBinding>
					</Border.IsVisible>

					<Panel Margin="20">
						<!-- Panel modyfikacji DLL -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllModificationsVisible}">
							<Panel.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="IsDllModificationsVisible"/>
									<Binding Path="IsDllInstallDialogVisible" Converter="{x:Static BoolConverters.Not}"/>
								</MultiBinding>
							</Panel.IsVisible>

							<ScrollViewer>
								<StackPanel>
									<!-- Header -->
									<Border Background="{DynamicResource AccentBrush}"
											CornerRadius="8"
											Padding="15"
											Margin="0,0,0,20">
										<StackPanel Orientation="Horizontal" Spacing="15">
											<TextBlock Text="🧩" FontSize="32" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="Modyfikacje DLL"
														   FontSize="20" FontWeight="Bold"
														   Foreground="White"/>
												<TextBlock Text="Wybierz modyfikację do zainstalowania"
														   FontSize="12"
														   Foreground="#E0FFFFFF"/>
											</StackPanel>
										</StackPanel>
									</Border>

									<!-- Lista modów DLL -->
									<ItemsControl ItemsSource="{Binding DllMods}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource ModCardBackgroundBrush}"
														BorderBrush="{DynamicResource ModCardBorderBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Margin="0,0,0,10"
														Padding="15">
													<Grid ColumnDefinitions="Auto,*,Auto">
														<!-- Ikona -->
														<Image Grid.Column="0"
															   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
															   Width="48" Height="48"
															   Margin="0,0,15,0"/>

														<!-- Informacje -->
														<StackPanel Grid.Column="1" VerticalAlignment="Center">
															<TextBlock Text="{Binding Name}"
																	   FontSize="16" FontWeight="Bold"
																	   Foreground="{DynamicResource TextPrimaryBrush}"/>
															<TextBlock Text="{Binding Description}"
																	   FontSize="12"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   TextWrapping="Wrap"
																	   MaxWidth="200"/>
															<TextBlock Text="{Binding ModVersion, StringFormat='Wersja: {0}'}"
																	   FontSize="11"
																	   Foreground="{DynamicResource TextSecondaryBrush}"/>
														</StackPanel>
														<!-- Przycisk wyboru -->
														<Button Grid.Column="2"
																Content="Wybierz"
																Background="{DynamicResource AccentBrush}"
																Foreground="White"
																Padding="15,8"
																CornerRadius="6"
																FontSize="12"
																FontWeight="SemiBold"
																Command="{Binding $parent[local:MainWindow].DataContext.SelectDllModCommand}"
																CommandParameter="{Binding}"/>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</ScrollViewer>
						</Panel>

						<!-- Dialog instalacji/odinstalowania DLL -->
						<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllInstallDialogVisible}">
							<ScrollViewer>
								<StackPanel>
									<!-- Header z informacją o wybranym DLL -->
									<Border Background="{DynamicResource AccentBrush}"
											CornerRadius="8"
											Padding="15"
											Margin="0,0,0,20">
										<StackPanel Orientation="Horizontal" Spacing="15">
											<Image Source="{Binding SelectedDllMod.PngFileName, Converter={StaticResource StringToBitmapConverter}}"
												   Width="48" Height="48"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding SelectedDllMod.Name}"
														   FontSize="18" FontWeight="Bold"
														   Foreground="White"/>
												<TextBlock Text="Zarządzaj instalacją modyfikacji"
														   FontSize="12"
														   Foreground="#E0FFFFFF"/>
											</StackPanel>
										</StackPanel>
									</Border>

									<!-- Sekcja: Zainstaluj -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="15"
											IsVisible="{Binding ModsWithoutDllInstalled.Count}">
										<StackPanel>
											<TextBlock Text="📥 Zainstaluj w:"
													   FontSize="16" FontWeight="Bold"
													   Foreground="{DynamicResource AccentBrush}"
													   Margin="0,0,0,10"/>

											<ItemsControl ItemsSource="{Binding ModsWithoutDllInstalled}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{DynamicResource SecondaryBackgroundBrush}"
																BorderBrush="{DynamicResource BorderBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Margin="0,0,0,8"
																Padding="12">
															<Grid ColumnDefinitions="Auto,*,Auto">
																<!-- Ikona -->
																<Image Grid.Column="0"
																	   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
																	   Width="32" Height="32"
																	   Margin="0,0,10,0"/>

																<!-- Informacje -->
																<StackPanel Grid.Column="1" VerticalAlignment="Center">
																	<TextBlock Text="{Binding Name}"
																			   FontSize="13" FontWeight="SemiBold"
																			   Foreground="{DynamicResource TextPrimaryBrush}"/>
																</StackPanel>

																<!-- Przycisk Instaluj -->
																<Button Grid.Column="2"
																		Content="Instaluj"
																		Background="{DynamicResource AccentBrush}"
																		Foreground="White"
																		Padding="10,5"
																		CornerRadius="4"
																		FontSize="11"
																		FontWeight="SemiBold"
																		Command="{Binding $parent[local:MainWindow].DataContext.InstallDllToModCommand}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>

									<!-- Sekcja: Odinstaluj -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="15"
											IsVisible="{Binding ModsWithDllInstalled.Count}">
										<StackPanel>
											<TextBlock Text="🗑️ Odinstaluj z:"
													   FontSize="16" FontWeight="Bold"
													   Foreground="{DynamicResource DangerBrush}"
													   Margin="0,0,0,10"/>

											<ItemsControl ItemsSource="{Binding ModsWithDllInstalled}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Background="{DynamicResource SecondaryBackgroundBrush}"
																BorderBrush="{DynamicResource BorderBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Margin="0,0,0,8"
																Padding="12">
															<Grid ColumnDefinitions="Auto,*,Auto">
																<!-- Ikona -->
																<Image Grid.Column="0"
																	   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
																	   Width="32" Height="32"
																	   Margin="0,0,10,0"/>

																<!-- Informacje -->
																<StackPanel Grid.Column="1" VerticalAlignment="Center">
																	<TextBlock Text="{Binding Name}"
																			   FontSize="13" FontWeight="SemiBold"
																			   Foreground="{DynamicResource TextPrimaryBrush}"/>
																</StackPanel>

																<!-- Przycisk Usuń -->
																<Button Grid.Column="2"
																		Content="Usuń"
																		Background="{DynamicResource DangerBrush}"
																		Foreground="White"
																		Padding="10,5"
																		CornerRadius="4"
																		FontSize="11"
																		FontWeight="SemiBold"
																		Command="{Binding $parent[local:MainWindow].DataContext.UninstallDllFromModCommand}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>

									<!-- Komunikat gdy brak modów -->
									<Border Background="{DynamicResource ModCardBackgroundBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,0,0,15"
											Padding="20">
										<Border.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
												<Binding Path="ModsWithDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
												<Binding Path="ModsWithoutDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
											</MultiBinding>
										</Border.IsVisible>

										<StackPanel HorizontalAlignment="Center">
											<TextBlock Text="🤷‍♂️"
													   FontSize="32"
													   HorizontalAlignment="Center"
													   Margin="0,0,0,10"/>
											<TextBlock Text="Brak zainstalowanych modów"
													   FontSize="14"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextAlignment="Center"/>
											<TextBlock Text="Zainstaluj najpierw jakiś mod typu 'full'"
													   FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextAlignment="Center"/>
										</StackPanel>
									</Border>

									<!-- Przycisk powrotu -->
									<Button Content="← Powrót do listy DLL"
											HorizontalAlignment="Center"
											Background="{DynamicResource ModCardBackgroundBrush}"
											Foreground="{DynamicResource TextPrimaryBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											Padding="15,10"
											CornerRadius="6"
											Command="{Binding CloseDllDialogCommand}"/>
								</StackPanel>
							</ScrollViewer>
						</Panel>
						<!-- Panel informacji z animacją fade-in -->
						<local:InfoPanel IsVisible="{Binding IsInfoPanelVisible}"
										 DataContext="{Binding}"
										 Classes="fade-in-panel"/>

						<!-- Panel dodatkowych akcji z animacją slide od lewej -->
						<local:AdditionalActionsPanel IsVisible="{Binding IsAdditionalActionsVisible}"
													  DataContext="{Binding}"
													  Classes="fade-in-panel"/>

						<!-- Panel modów z animacją slide od prawej -->
						<Panel Classes="fade-in-panel">
							<Panel.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="IsModSelected"/>
									<Binding Path="IsInfoPanelVisible" Converter="{x:Static BoolConverters.Not}"/>
									<Binding Path="IsAdditionalActionsVisible" Converter="{x:Static BoolConverters.Not}"/>
								</MultiBinding>
							</Panel.IsVisible>

							<StackPanel DataContext="{Binding SelectedMod}"
										Classes="mod-content-slide"
										Classes.visible="{Binding $parent[local:MainWindow].DataContext.IsModContentVisible}">
								<!-- Header z akcentem i developer menu -->
								<Border Background="{DynamicResource AccentBrush}"
										CornerRadius="8"
										Padding="15"
										Margin="0,0,0,20">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Istniejący content headera moda -->
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
											<Image Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
												   Width="64" Height="64"
												   HorizontalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}"
														   FontSize="20" FontWeight="Bold"
														   Foreground="White"
														   TextWrapping="Wrap"/>
												<TextBlock Text="{Binding ModVersion, StringFormat='Wersja moda: {0}'}"
														   FontSize="11"
														   Foreground="#E0FFFFFF"/>
												<TextBlock Text="{Binding AmongVersion, StringFormat='Wersja AmongUs: {0}'}"
														   FontSize="11"
														   Foreground="#E0FFFFFF"/>
											</StackPanel>
										</StackPanel>

										<!-- Developer menu dla konkretnego moda -->
										<Button Grid.Column="1"
												x:Name="ModDeveloperMenuButton"
												Content="⋯"
												FontSize="18"
												FontWeight="Bold"
												Width="32"
												Height="32"
												Background="Transparent"
												BorderThickness="0"
												HorizontalContentAlignment="Center"
												VerticalContentAlignment="Center"
												Foreground="White"
												VerticalAlignment="Top"
												HorizontalAlignment="Right"
												IsVisible="{Binding $parent[local:MainWindow].DataContext.IsDeveloperMode}"
												Click="ModDeveloperMenuButton_Click">
											<Button.Styles>
												<Style Selector="Button:pointerover">
													<Setter Property="Background" Value="#40FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
												<Style Selector="Button:pressed">
													<Setter Property="Background" Value="#60FFFFFF"/>
													<Setter Property="CornerRadius" Value="4"/>
												</Style>
											</Button.Styles>

											<!-- Flyout menu -->
											<Button.Flyout>
												<MenuFlyout>
													<MenuItem Header="Usuń SingleInstance">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].RemoveSingleInstanceCommand"/>
														</MenuItem.Command>
													</MenuItem>
													<MenuItem Header="Uruchom wybraną ilość instancji">
														<MenuItem.Command>
															<Binding Path="$parent[local:MainWindow].LaunchMultipleInstancesCommand"/>
														</MenuItem.Command>
													</MenuItem>
												</MenuFlyout>
											</Button.Flyout>
										</Button>
										</Grid>
								</Border>

								<ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
									<StackPanel x:Name="DescriptionPanel" Orientation="Vertical"/>
								</ScrollViewer>

								<!-- PROGRESS BAR -->
								<Border IsVisible="{Binding ShowProgress}"
										Background="{DynamicResource TertiaryBackgroundBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="15"
										Margin="0,0,0,20">
									<StackPanel>
										<TextBlock Text="{Binding InstallStatusMessage}"
												   FontSize="12"
												   Foreground="{DynamicResource TextPrimaryBrush}"
												   TextAlignment="Center"
												   Margin="0,0,0,8"/>
										<ProgressBar Value="{Binding InstallProgress}"
													 Minimum="0"
													 Maximum="100"
													 Height="24"
													 CornerRadius="12"
													 Background="{DynamicResource WindowBackgroundBrush}"
													 Foreground="{DynamicResource AccentBrush}"/>
										<TextBlock Text="{Binding InstallProgress, StringFormat='{}{0}%'}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextAlignment="Center"
												   Margin="0,5,0,0"/>
									</StackPanel>
								</Border>

								<!-- Przyciski dla Vanilla - tylko Uruchom -->
								<StackPanel IsVisible="{Binding IsVanilla}" Spacing="10">
									<Button Content="Uruchom"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>
								</StackPanel>

								<!-- Przyciski dla niezainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}" ConverterParameter="Invert"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="Instaluj"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.InstallCommand}"/>
								</StackPanel>

								<!-- Przyciski dla zainstalowanego moda (NIE Vanilla) -->
								<StackPanel Spacing="10">
									<StackPanel.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="InstallPath" Converter="{StaticResource StringNotNullOrEmptyToBoolConverter}"/>
											<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
										</MultiBinding>
									</StackPanel.IsVisible>

									<Button Content="Uruchom"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource SuccessBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.LaunchCommand}"/>

									<Button Content="Aktualizuj"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource AccentBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UpdateCommand}"/>

									<Button Content="Usuń"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DangerBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.UninstallCommand}"/>

									<Button Content="Dodaj DLL"
											HorizontalAlignment="Stretch"
											Padding="12"
											CornerRadius="8"
											FontSize="14"
											FontWeight="SemiBold"
											Background="{DynamicResource DllButtonBrush}"
											Foreground="White"
											IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[local:MainWindow].DataContext.ShowDllSelectionCommand}"/>
								</StackPanel>

								<!-- Przycisk Role - zawsze widoczny (NIE dla Vanilla) -->
								<Button Content="Role"
										HorizontalAlignment="Stretch"
										Margin="0,10,0,0"
										Padding="12"
										CornerRadius="8"
										FontSize="14"
										FontWeight="SemiBold"
										Background="{DynamicResource ModCardBackgroundBrush}"
										Foreground="{DynamicResource TextPrimaryBrush}"
										BorderBrush="{DynamicResource ModCardBorderBrush}"
										BorderThickness="1"
										IsEnabled="{Binding IsInstalling, Converter={x:Static BoolConverters.Not}}"
										Command="{Binding $parent[local:MainWindow].DataContext.ShowRolesCommand}">
									<Button.IsVisible>
										<Binding Path="IsVanilla" Converter="{x:Static BoolConverters.Not}"/>
									</Button.IsVisible>
								</Button>

								<StackPanel IsVisible="{Binding InstallPath, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
											Margin="0,25,0,0">
									<TextBlock Text="Zainstalowano w:"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   Margin="0,0,0,8"/>
									<Border BorderBrush="{DynamicResource AccentBrush}"
											BorderThickness="1"
											Background="{DynamicResource TertiaryBackgroundBrush}"
											CornerRadius="6"
											Margin="0,0,0,4">
										<SelectableTextBlock Text="{Binding InstallPath, Converter={x:Static converters:PathShorteningConverter.Instance}, ConverterParameter=30}"
															 Background="Transparent"
															 Foreground="{DynamicResource TextPrimaryBrush}"
															 Padding="10"
															 FontFamily="Consolas"
															 FontSize="10"
															 ToolTip.Tip="{Binding InstallPath}"/>
									</Border>
									<Grid ColumnDefinitions="*,5,*">
										<Button Grid.Column="0"
												Content="Otwórz folder"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.OpenFolderCommand}"/>

										<Button Grid.Column="2"
												Content="Stwórz skrót"
												HorizontalAlignment="Stretch"
												Padding="8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Background="{DynamicResource ModCardBackgroundBrush}"
												Foreground="{DynamicResource TextPrimaryBrush}"
												BorderBrush="{DynamicResource ModCardBorderBrush}"
												BorderThickness="1"
												Command="{Binding $parent[local:MainWindow].DataContext.CreateShortcutCommand}"/>
									</Grid>
								</StackPanel>
							</StackPanel>
						</Panel>
					</Panel>
				</Border>
			</Grid>

			<!-- STATUS BAR - Panel statusu na dole -->
			<Border Grid.Row="1" 
					Classes="status-bar"
					Height="70">
				
				<Grid ColumnDefinitions="2*,2*,1*" Margin="20,0">
					
					<!-- SEKCJA 1: Statystyki modów -->
					<Border Grid.Column="0" Classes="status-section">
						<StackPanel Orientation="Horizontal" Spacing="15">
							<!-- Ikona -->
							<Border Classes="status-icon-container" Background="#4A148C">
								<TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>
							
							<!-- Tekst -->
							<StackPanel VerticalAlignment="Center" Spacing="2">
								<TextBlock Classes="status-main-text">
									<Run Text="Zainstalowanych modów: "/>
									<Run Text="{Binding InstalledFullModsCount}" FontWeight="Bold"/>
								</TextBlock>
							</StackPanel>
						</StackPanel>
						
						<!-- Tooltip z listą modów -->
						<ToolTip.Tip>
							<StackPanel MaxWidth="300">
								<TextBlock Text="Zainstalowane mody:" FontWeight="Bold" Margin="0,0,0,5"/>
								<ItemsControl ItemsSource="{Binding InstalledModsList}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding}" FontSize="11"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ToolTip.Tip>
					</Border>

					<!-- SEKCJA 2: Przestrzeń dyskowa -->
					<Border Grid.Column="1" Classes="status-section">
						<StackPanel Orientation="Horizontal" Spacing="15">
							<!-- Ikona -->
							<Border Classes="status-icon-container" Background="#0288D1">
								<TextBlock Text="💾" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
							</Border>
							
							<!-- Tekst i progress bar -->
							<StackPanel VerticalAlignment="Center" Spacing="4" Width="250">
								<TextBlock Classes="status-main-text">
									<Run Text="{Binding ModsFolderSizeGB, StringFormat='{}{0:F2} GB'}"/>
									<Run Text=" / "/>
									<Run Text="{Binding TotalDiskSpaceGB, StringFormat='{}{0:F0} GB'}"/>
								</TextBlock>
								
								<!-- Progress Bar z kolorowaniem -->
								<Grid>
									<ProgressBar Value="{Binding DiskUsagePercentage}"
												 Maximum="100"
												 Height="8"
												 CornerRadius="4"
												 Foreground="{Binding DiskUsagePercentage, Converter={StaticResource DiskUsageColorConverter}}"/>
									<TextBlock Classes="status-sub-text" 
											   HorizontalAlignment="Right"
											   Margin="0,-2,0,0">
										<Run Text="{Binding DiskUsagePercentage, StringFormat='{}{0:F1}%'}"/>
									</TextBlock>
								</Grid>
							</StackPanel>
						</StackPanel>
						
						<!-- Tooltip ze szczegółami -->
						<ToolTip.Tip>
							<StackPanel>
								<TextBlock Text="Szczegóły przestrzeni:" FontWeight="Bold" Margin="0,0,0,5"/>
								<TextBlock Text="{Binding DiskSpaceDetailsTooltip}" FontSize="11"/>
							</StackPanel>
						</ToolTip.Tip>
					</Border>

					<!-- SEKCJA 3: Status API -->
					<Border Grid.Column="2" Classes="status-section">
						<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
							<!-- Status indicator (kolorowe kółko) -->
							<Ellipse Width="16" Height="16"
									 Fill="{Binding ApiStatusColor}"
									 Classes="status-pulse"/>
							
							<!-- Tekst statusu -->
							<StackPanel VerticalAlignment="Center">
								<TextBlock Classes="status-main-text" Text="API"/>
								<TextBlock Classes="status-sub-text" Text="{Binding ApiStatusText}"/>
							</StackPanel>
						</StackPanel>
						
						<!-- Tooltip ze szczegółami API -->
						<ToolTip.Tip>
							<StackPanel>
								<TextBlock Text="Status serwera API" FontWeight="Bold" Margin="0,0,0,5"/>
								<TextBlock FontSize="11">
									<Run Text="URL: "/>
									<Run Text="{Binding ApiBaseUrl}"/>
								</TextBlock>
								<TextBlock FontSize="11">
									<Run Text="Ostatnie sprawdzenie: "/>
									<Run Text="{Binding LastApiCheck, StringFormat='{}{0:HH:mm:ss}'}"/>
								</TextBlock>
								<TextBlock FontSize="11" IsVisible="{Binding IsApiOnline}">
									<Run Text="Opóźnienie: "/>
									<Run Text="{Binding ApiPingMs}"/>
									<Run Text="ms"/>
								</TextBlock>
							</StackPanel>
						</ToolTip.Tip>
					</Border>

				</Grid>
			</Border>

		</Grid>
	</SplitView>
</Window>
