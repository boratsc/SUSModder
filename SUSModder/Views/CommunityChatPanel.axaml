<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.CommunityChatPanel"
             x:DataType="vm:CommunityChatPanelViewModel"
             MinHeight="200">
	<UserControl.Styles>
		<!-- E11: miękkie dymki treści (bez obramowań/cieni); własne = złote soft fill.
		     Kolejność: chat-bubble-own po chat-bubble — ta sama specyficzność, późniejsza wygrywa. -->
		<Style Selector="Border.chat-bubble">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="10,8"/>
		</Style>
		<Style Selector="Border.chat-bubble-own">
			<Setter Property="Background" Value="{DynamicResource AccentSoftFillBrush}"/>
		</Style>
		<Style Selector="Border.chat-banner">
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
		</Style>
		<Style Selector="TextBox.chat-input">
			<Setter Property="MinHeight" Value="38"/>
		</Style>
		<Style Selector="Button.chat-new-messages">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="10,4"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6" Margin="10,8,10,8">

		<!-- ══════════ Nagłówek: tytuł + online + zasady/odśwież + X (E5) ══════════ -->
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Chat}" FontSize="16"
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource TextSecondaryBrush}"/>
					<TextBlock Text="{loc:Localize UI.CommunityChat.Title}"
							   FontSize="14" FontWeight="Bold"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
						VerticalAlignment="Center" Margin="0,0,8,0"
						IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsApiOnline}">
				<Ellipse Width="8" Height="8"
						 Fill="{DynamicResource StatusInstalledBrush}"
						 VerticalAlignment="Center"/>
				<TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChatOnlineText}"
						   FontSize="11"
						   VerticalAlignment="Center"
						   Foreground="{DynamicResource StatusInstalledTextBrush}"/>
			</StackPanel>
			<Button Grid.Column="2"
					Padding="6"
					VerticalAlignment="Top"
					Command="{Binding OpenRulesCommand}"
					AutomationProperties.Name="{loc:Localize UI.CommunityChat.Rules.Button}"
					ToolTip.Tip="{loc:Localize UI.CommunityChat.Rules.Button}">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}" FontSize="16"
							   Foreground="{DynamicResource TextSecondaryBrush}"/>
			</Button>
			<Button Grid.Column="3"
					Padding="6"
					VerticalAlignment="Top"
					IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
					Command="{Binding RefreshCommand}"
					AutomationProperties.Name="{loc:Localize UI.CommunityChat.Refresh}"
					ToolTip.Tip="{loc:Localize UI.CommunityChat.Refresh}">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSync}" FontSize="16"
							   Foreground="{DynamicResource TextSecondaryBrush}"/>
			</Button>
			<Button Grid.Column="4"
					Padding="6"
					VerticalAlignment="Top"
					Background="Transparent"
					BorderThickness="0"
					Command="{Binding CloseChatCommand}"
					AutomationProperties.Name="{loc:Localize UI.CommunityChat.Close}"
					ToolTip.Tip="{loc:Localize UI.CommunityChat.Close}">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Dismiss}" FontSize="16"
							   Foreground="{DynamicResource TextSecondaryBrush}"/>
			</Button>
		</Grid>

		<!-- ══════════ Banner stanu (błędy / limity / info) ══════════ -->
		<Panel Grid.Row="1" IsVisible="{Binding HasBanner}" Opacity="{Binding BannerOpacity}">
			<Panel.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
				</Transitions>
			</Panel.Transitions>
			<Border Classes="chat-banner" Background="{DynamicResource TertiaryBackgroundBrush}"
					IsVisible="{Binding BannerIsInfo}">
				<TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11"
						   Foreground="{DynamicResource TextSecondaryBrush}"/>
			</Border>
			<Border Classes="chat-banner" Background="{DynamicResource WarningBannerFillBrush}"
					IsVisible="{Binding BannerIsWarning}">
				<TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11"
						   Foreground="{DynamicResource TextPrimaryBrush}"/>
			</Border>
			<Border Classes="chat-banner" Background="{DynamicResource ErrorBannerFillBrush}"
					IsVisible="{Binding BannerIsError}">
				<TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="11"
						   Foreground="{DynamicResource TextPrimaryBrush}"/>
			</Border>
		</Panel>

		<!-- ══════════ Ostrzeżenie heurystyki (przed wysłaniem) ══════════ -->
		<Border Grid.Row="2"
				Classes="chat-banner"
				Background="{DynamicResource WarningBannerFillBrush}"
				IsVisible="{Binding IsHeuristicPromptVisible}">
			<StackPanel Spacing="6">
				<TextBlock Text="{Binding HeuristicWarningText}"
						   TextWrapping="Wrap" FontSize="11"
						   Foreground="{DynamicResource TextPrimaryBrush}"/>
				<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
					<Button Content="{Binding HeuristicReviewLabel}"
							Padding="8,3" FontSize="11"
							CornerRadius="4"
							Background="Transparent"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							Command="{Binding DismissHeuristicCommand}"/>
					<Button Content="{Binding HeuristicSendAnywayLabel}"
							Padding="8,3" FontSize="11"
							CornerRadius="4"
							Background="{DynamicResource AccentBrush}"
							Foreground="{DynamicResource OnAccentTextBrush}"
							Command="{Binding SendAnywayCommand}"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- ══════════ Lista wiadomości (własny obszar przewijania) ══════════ -->
		<Panel Grid.Row="3">
			<ScrollViewer x:Name="MessagesScroll"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding Messages}"
							  Margin="0,0,4,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:CommunityChatMessageViewModel">
							<!-- E11: autor + czas NAD miękkim dymkiem treści; wyrównanie lewe dla ciągłości.
							     Zgłoś/Usuń zostają w wierszu nagłówka (istniejące funkcje). -->
							<StackPanel Spacing="2" Margin="0,0,0,10">
								<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
									<TextBlock Grid.Column="0" Text="{Binding AuthorDisplay}"
											   FontSize="12" FontWeight="SemiBold"
											   VerticalAlignment="Center"
											   MaxWidth="240" TextTrimming="CharacterEllipsis"
											   Foreground="{DynamicResource TextPrimaryBrush}"/>
									<TextBlock Grid.Column="1" Text="{Binding TimeAgoDisplay}"
											   FontSize="11"
											   VerticalAlignment="Center"
											   Foreground="{DynamicResource TextMutedBrush}"/>
									<TextBlock Grid.Column="2" Text="{loc:Localize UI.CommunityChat.OwnBadge}"
											   FontSize="10" FontWeight="SemiBold"
											   VerticalAlignment="Center"
											   IsVisible="{Binding IsOwn}"
											   Foreground="{DynamicResource AccentBrush}"/>
									<Button Grid.Column="4"
											Content="{loc:Localize UI.CommunityChat.Report.Button}"
											Padding="6,2" FontSize="10"
											Background="Transparent"
											Foreground="{DynamicResource TextSecondaryBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="4"
											VerticalAlignment="Center"
											IsEnabled="{Binding $parent[ItemsControl].DataContext.IsBusy, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[ItemsControl].DataContext.ReportCommand}"
											CommandParameter="{Binding}"
											ToolTip.Tip="{loc:Localize UI.CommunityChat.Report.Hint}"/>
									<Button Grid.Column="5"
											Content="{loc:Localize UI.CommunityChat.Delete.Button}"
											Padding="6,2" FontSize="10"
											Background="Transparent"
											Foreground="{DynamicResource DangerBrush}"
											BorderBrush="{DynamicResource ModCardBorderBrush}"
											BorderThickness="1"
											CornerRadius="4"
											VerticalAlignment="Center"
											IsVisible="{Binding CanDelete}"
											IsEnabled="{Binding $parent[ItemsControl].DataContext.IsBusy, Converter={x:Static BoolConverters.Not}}"
											Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}"
											CommandParameter="{Binding}"/>
								</Grid>
								<!-- Treść w miękkim dymku (własne = AccentSoftFill); tekst selektorowalny,
								     emotikony ASCII prezentacyjnie zamieniane na emoji. Bez obramowań/cieni. -->
								<Border Classes="chat-bubble" Classes.chat-bubble-own="{Binding IsOwn}"
									HorizontalAlignment="Left">
									<SelectableTextBlock Text="{Binding DisplayContent}"
										TextWrapping="Wrap"
										FontSize="13"
										Foreground="{DynamicResource TextPrimaryBrush}"/>
								</Border>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!-- Stany pustej / ładowania / braku połączenia -->
			<TextBlock IsVisible="{Binding IsInitialLoading}"
					   Text="{loc:Localize UI.CommunityChat.Loading}"
					   FontStyle="Italic" FontSize="12"
					   Foreground="{DynamicResource TextSecondaryBrush}"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<TextBlock IsVisible="{Binding ShowEmptyState}"
					   Text="{loc:Localize UI.CommunityChat.Empty}"
					   FontStyle="Italic" FontSize="12"
					   Foreground="{DynamicResource TextSecondaryBrush}"
					   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			<TextBlock IsVisible="{Binding ShowDisconnectedState}"
					   Text="{loc:Localize UI.CommunityChat.OfflineHint}"
					   FontStyle="Italic" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
					   Foreground="{DynamicResource TextSecondaryBrush}"
					   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>

			<!-- Przycisk „nowe wiadomości" — gdy czytaliśmy starsze treści -->
			<Button HorizontalAlignment="Center" VerticalAlignment="Bottom"
					Margin="0,0,8,8"
					Classes="chat-new-messages"
					IsVisible="{Binding HasNewMessages}"
					Click="OnNewMessagesClick">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ChevronDown}" FontSize="12"/>
					<TextBlock Text="{Binding NewMessagesText}" FontSize="11"/>
				</StackPanel>
			</Button>
		</Panel>

		<!-- ══════════ Pole pisania ══════════ -->
		<Border Grid.Row="4"
				Background="{DynamicResource SecondaryBackgroundBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="8"
				Padding="8,6">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="4">
				<TextBox Grid.Row="0" Grid.Column="0"
						 x:Name="InputBox"
						 Classes="chat-input"
						 Text="{Binding Draft, Mode=TwoWay}"
						 AcceptsReturn="False"
						 TextWrapping="Wrap"
						 MaxHeight="84"
						 FontSize="13"
						 PlaceholderText="{loc:Localize UI.CommunityChat.Placeholder}"
						 AutomationProperties.Name="{loc:Localize UI.CommunityChat.Placeholder}"
						 KeyDown="OnInputKeyDown"/>
				<Button Grid.Row="0" Grid.Column="1"
						Content="{loc:Localize UI.CommunityChat.Send}"
						Command="{Binding SendCommand}"
						VerticalAlignment="Stretch"
						Padding="12,4"
						CornerRadius="6"
						Background="{DynamicResource AccentBrush}"
						Foreground="{DynamicResource OnAccentTextBrush}"/>
				<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
						   HorizontalAlignment="Right"
						   FontSize="10"
						   Foreground="{DynamicResource TextSecondaryBrush}"
						   Text="{Binding CharCountText}"/>
			</Grid>
		</Border>

		<!-- ══════════ Panel zasad czatu (nakładka) ══════════ -->
		<Border Grid.Row="0" Grid.RowSpan="5"
				IsVisible="{Binding IsRulesVisible}"
				Background="#99000000"
				CornerRadius="8">
			<Border Background="{DynamicResource SecondaryBackgroundBrush}"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="14"
					Margin="10"
					MaxHeight="420"
					VerticalAlignment="Center">
				<Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
					<TextBlock Grid.Row="0"
							   Text="{Binding RulesTitle}"
							   FontWeight="Bold" FontSize="13"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<TextBlock Text="{Binding RulesText}"
								   TextWrapping="Wrap"
								   FontSize="12"
								   Foreground="{DynamicResource TextSecondaryBrush}"/>
					</ScrollViewer>
					<Button Grid.Row="2"
							Content="{Binding RulesButtonLabel}"
							HorizontalAlignment="Right"
							Padding="12,4"
							CornerRadius="6"
							Background="{DynamicResource AccentBrush}"
							Foreground="{DynamicResource OnAccentTextBrush}"
							Command="{Binding AcknowledgeRulesCommand}"/>
				</Grid>
			</Border>
		</Border>
	</Grid>
</UserControl>
