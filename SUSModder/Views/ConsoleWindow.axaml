<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SUSModder.Views"
        x:Class="SUSModder.Views.ConsoleWindow"
        Title="Konsola deweloperska"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource PrimaryBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />

		<Style Selector="TextBlock.log-entry">
			<Setter Property="FontFamily" Value="Consolas, Monaco, 'Courier New', monospace"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<Style Selector="TextBlock.log-info">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.log-warning">
			<Setter Property="Foreground" Value="#FFFF9800"/>
		</Style>

		<Style Selector="TextBlock.log-error">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
		</Style>

		<Style Selector="TextBlock.log-debug">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto" Margin="10">
		<!-- Header -->
		<Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="8"
                Padding="15,10"
                Margin="0,0,0,10">
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
				<TextBlock Grid.Column="0"
                           Text="🖥️ Konsola deweloperska"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

				<TextBlock Grid.Column="1"
                           x:Name="LogCountText"
                           Text="0 wpisów"
                           FontSize="12"
                           Foreground="#E0FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="10,0"/>

				<Button Grid.Column="2"
                        Content="Wyczyść"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Padding="10,5"
                        Margin="5,0"
                        Click="OnClearClick"/>

				<Button Grid.Column="3"
                        Content="Kopiuj"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Padding="10,5"
                        Margin="5,0"
                        Click="OnCopyClick"/>

				<Button Grid.Column="4"
                        Content="Zapisz"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Padding="10,5"
                        Margin="5,0"
                        Click="OnSaveClick"/>
			</Grid>
		</Border>

		<!-- Console content -->
		<Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
			<ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
				<ItemsControl x:Name="LogItemsControl"
                              Margin="10">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="models:LogEntry">
							<TextBlock Classes="log-entry"
                                       Text="{Binding Text}"
                                       Classes.log-info="{Binding IsInfo}"
                                       Classes.log-warning="{Binding IsWarning}"
                                       Classes.log-error="{Binding IsError}"
                                       Classes.log-debug="{Binding IsDebug}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2"
                Background="{DynamicResource TertiaryBackgroundBrush}"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<CheckBox Grid.Column="0"
                          x:Name="AutoScrollCheckBox"
                          Content="Automatyczne przewijanie"
                          IsChecked="True"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>

				<TextBlock Grid.Column="2"
                           x:Name="StatusText"
                           Text="Gotowe"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>
	</Grid>
</Window>
