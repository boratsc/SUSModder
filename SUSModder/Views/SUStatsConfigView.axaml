<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:local="using:SUSModder.Services.Localization"
             x:Class="SUSModder.Views.SUStatsConfigView"
             x:DataType="vm:SUStatsConfigViewModel">

	<Design.DataContext>
		<vm:SUStatsConfigViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="*,Auto" Margin="0">
		<ScrollViewer Grid.Row="0" Padding="0,0,10,0">

			<!-- Główna zawartość -->
			<Border
					Background="{DynamicResource ModCardBackgroundBrush}"
					BorderBrush="{DynamicResource ModCardBorderBrush}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="20">

				<StackPanel Spacing="20">

					<!-- Instrukcja konfiguracji (widoczna przed logowaniem) -->
					<Border Background="{DynamicResource TertiaryBackgroundBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="6"
							Padding="14"
							IsVisible="{Binding IsPasswordValid, Converter={x:Static BoolConverters.Not}}">
						<StackPanel Spacing="8">
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideTitle}"
									   FontSize="13" FontWeight="SemiBold"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideIntro}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep1}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Button Content="https://clairbot.app"
									Padding="0"
									HorizontalAlignment="Left"
									Background="Transparent"
									BorderThickness="0"
									Foreground="{DynamicResource AccentBrush}"
									FontSize="12"
									Click="OpenClairbotLink_Click"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep2}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<Button Content="https://hub.clairbot.app/among-us"
									Padding="0"
									HorizontalAlignment="Left"
									Background="Transparent"
									BorderThickness="0"
									Foreground="{DynamicResource AccentBrush}"
									FontSize="12"
									Click="OpenClairHubLink_Click"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep3}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep4}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep5}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{local:Localize SUStatsConfig.SetupGuideStep6}"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
						</StackPanel>
					</Border>

					<!-- Sekcja hasła -->
					<StackPanel Spacing="12">
						<TextBlock Text="{local:Localize SUStatsConfig.PasswordSection}"
								   FontSize="15" FontWeight="SemiBold"
								   Foreground="{DynamicResource TextPrimaryBrush}"/>

						<TextBlock Text="{local:Localize SUStatsConfig.PasswordPrompt}"
								   FontSize="12"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   TextWrapping="Wrap"/>

						<Grid ColumnDefinitions="*,Auto">
							<TextBox Grid.Column="0"
									 x:Name="PasswordTextBox"
									 Text="{Binding EnteredPassword}"
									 PasswordChar="•"
									 PlaceholderText="{local:Localize SUStatsConfig.PasswordPlaceholder}"
									 FontSize="13"
									 Padding="10,8"
									 CornerRadius="6"
									 Background="{DynamicResource SecondaryBackgroundBrush}"
									 BorderBrush="{DynamicResource BorderBrush}"
									 BorderThickness="1"
									 Margin="0,0,8,0"/>

							<Button Grid.Column="1"
									Content="{local:Localize SUStatsConfig.CheckButton}"
									Background="{DynamicResource AccentBrush}"
									Foreground="White"
									Padding="15,8"
									CornerRadius="6"
									FontSize="13"
									FontWeight="SemiBold"
									Command="{Binding CheckPasswordCommand}"
									IsEnabled="{Binding IsCheckingPassword, Converter={x:Static BoolConverters.Not}}"/>
						</Grid>

						<!-- Status sprawdzania hasła -->
						<TextBlock Text="{Binding PasswordStatusMessage}"
								   Foreground="{Binding PasswordStatusColor}"
								   FontSize="11"
								   Margin="0,5,0,0"
								   IsVisible="{Binding PasswordStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

						<!-- Checkbox zapamiętaj logowanie -->
						<CheckBox IsChecked="{Binding RememberLogin}"
								  Content="{local:Localize SUStatsConfig.RememberLogin}"
								  FontSize="12"
								  Margin="0,5,0,0"
								  Foreground="{DynamicResource TextPrimaryBrush}"/>
					</StackPanel>

					<!-- Separator -->
					<Border Height="1"
							Background="{DynamicResource BorderBrush}"
							IsVisible="{Binding IsPasswordValid}"/>

					<!-- Sekcja konfiguracji (widoczna tylko po poprawnym haśle) -->
					<StackPanel Spacing="15" IsVisible="{Binding IsPasswordValid}">

						<!-- Informacja o serwerze -->
						<Border Background="{DynamicResource SecondaryBackgroundBrush}"
								BorderBrush="{DynamicResource AccentBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="12">
							<StackPanel Spacing="6">
								<TextBlock Text="{local:Localize SUStatsConfig.ServerConnected}"
										   FontSize="13" FontWeight="SemiBold"
										   Foreground="{DynamicResource AccentBrush}"/>

								<TextBlock Text="{Binding ValidatedServerName}"
										   FontSize="15" FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>


							</StackPanel>
						</Border>

						<!-- Switch włączania rejestrowania -->
						<Border Background="{DynamicResource TertiaryBackgroundBrush}"
								BorderBrush="{DynamicResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="15">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="{local:Localize SUStatsConfig.EnableStats}"
											   FontSize="14" FontWeight="SemiBold"
											   Foreground="{DynamicResource TextPrimaryBrush}"/>
									<TextBlock Text="{local:Localize SUStatsConfig.EnableStatsDescription}"
											   FontSize="11"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   Margin="0,2,0,0"/>
								</StackPanel>

								<ToggleSwitch Grid.Column="1"
											  IsChecked="{Binding IsStatsEnabled}"
											  VerticalAlignment="Center"
											  Margin="10,0,0,0"/>
							</Grid>
						</Border>

						<!-- Status rejestrowania -->
						<Border Background="{Binding StatsStatusBackgroundBrush}"
								BorderBrush="{Binding StatsStatusBorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="12"
								IsVisible="{Binding ShowStatsStatus}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="{Binding StatsStatusIcon}"
										   FontSize="14"
										   VerticalAlignment="Center"/>
								<TextBlock Text="{Binding StatsStatusMessage}"
										   Foreground="{Binding StatsStatusTextBrush}"
										   FontSize="12"
										   VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</StackPanel>

				</StackPanel>
			</Border>
		</ScrollViewer>

			<!-- Footer -->
		<Border Grid.Row="1"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,1,0,0"
					Padding="0,15,0,0"
					Margin="0,20,0,0">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">

					<!-- Przycisk wylogowania (widoczny tylko gdy hasło jest poprawne) -->
					<Button Content="{local:Localize SUStatsConfig.LogoutButton}"
							Padding="12,8"
							CornerRadius="6"
							FontSize="13"
							Background="{DynamicResource ModCardBackgroundBrush}"
							Foreground="{DynamicResource TextPrimaryBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							Command="{Binding ResetCommand}"
							IsVisible="{Binding IsPasswordValid}"/>

					<Button Content="{local:Localize SUStatsConfig.CloseButton}"
							Padding="15,8"
							CornerRadius="6"
							FontSize="13"
							Background="{DynamicResource ModCardBackgroundBrush}"
							Foreground="{DynamicResource TextPrimaryBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							Click="CloseButton_Click"/>
				</StackPanel>
		</Border>
	</Grid>
</UserControl>
