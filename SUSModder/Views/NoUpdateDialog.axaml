<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.NoUpdateDialog"
        Title="{loc:Localize Updates.UpdateAvailable}"
        Width="500" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <FluentTheme />

    <!-- Animacja fade-in -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla ikony -->
    <Style Selector="Border.success-icon">
      <Style.Animations>
        <Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="-20"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Animacja dla contentu -->
    <Style Selector="StackPanel.content-panel">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <!-- E6: stan sukcesu (zielona ikona) + tytuł + zdanie; wersja pod „Szczegóły”. -->
  <Border Margin="0,30,0,0">
    <Grid Margin="30,10,30,24" RowDefinitions="Auto,*,Auto">

      <Border Grid.Row="0"
              Classes="modal-icon success success-icon"
              Margin="0,0,0,16">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <TextBlock Text="✓" FontWeight="Bold"/>
      </Border>

      <StackPanel Grid.Row="1"
                  Classes="content-panel"
                  Spacing="12">
        <StackPanel.RenderTransform>
          <TranslateTransform/>
        </StackPanel.RenderTransform>

        <TextBlock Text="{loc:Localize Updates.UpToDate}" Classes="modal-title"/>

        <TextBlock Text="{loc:Localize Updates.NoUpdatesMessage}"
                   Classes="modal-message"
                   MaxWidth="380"
                   Margin="0,0,0,4"/>

        <Expander Classes="modal-details" Header="{loc:Localize UI.Inspector.Details}">
          <Border Classes="modal-info-row" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="{loc:Localize Updates.CurrentVersion}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         x:Name="CurrentVersionText"
                         Text="2.3.3-beta"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Expander>
      </StackPanel>

      <Button Grid.Row="2"
              x:Name="OkButton"
              Classes="modal-primary"
              Content="{loc:Localize UI.Buttons.OK}"
              IsDefault="True"
              IsCancel="True"
              HorizontalAlignment="Center"
              Margin="0,16,0,0"
              Click="OkButton_Click"/>

    </Grid>
  </Border>
</Window>
