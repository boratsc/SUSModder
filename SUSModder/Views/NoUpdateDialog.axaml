<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.NoUpdateDialog"
        Title="{loc:Localize Updates.UpdateAvailable}"
        Width="500" Height="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <FluentTheme />
    
    <!-- Animacja fade-in -->
    <Style Selector="Window">
      <Style.Animations>
        <Animation Duration="0:0:0.3" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Animacja dla ikony -->
    <Style Selector="Border.success-icon">
      <Style.Animations>
        <Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="-20"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Animacja dla contentu -->
    <Style Selector="StackPanel.content-panel">
      <Style.Animations>
        <Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="(TranslateTransform.Y)" Value="10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="(TranslateTransform.Y)" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    
    <!-- Hover effect dla przycisku -->
    <Style Selector="Button.ok-button:pointerover">
      <Setter Property="Background" Value="#10B981"/>
      <Setter Property="BorderBrush" Value="#059669"/>
    </Style>
    
    <Style Selector="Button.ok-button:pressed">
      <Setter Property="Background" Value="#059669"/>
    </Style>
  </Window.Styles>

  <Border Margin="0,30,0,0">
    <Grid Margin="30,10,30,30" RowDefinitions="Auto,Auto,Auto">

      <!-- Ikona sukcesu -->
      <Border Grid.Row="0"
              Classes="success-icon"
              Width="80" Height="80"
              CornerRadius="40"
              Background="#2010B981"
              BorderBrush="#10B981"
              BorderThickness="2"
              HorizontalAlignment="Center"
              Margin="0,0,0,20">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <TextBlock Text="✓" 
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="#10B981"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <!-- Zawartość -->
      <StackPanel Grid.Row="1"
                  Classes="content-panel"
                  Spacing="12"
                  MinHeight="120">
        <StackPanel.RenderTransform>
          <TranslateTransform/>
        </StackPanel.RenderTransform>
        
        <!-- Tytuł -->
        <TextBlock Text="{loc:Localize Updates.UpToDate}"
                   FontSize="20" 
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <!-- Wiadomość -->
        <TextBlock Text="{loc:Localize Updates.NoUpdatesMessage}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="380"
                   Margin="0,0,0,8"/>
        
        <!-- Info o wersji -->
        <Border Background="{DynamicResource ModCardBackgroundBrush}"
                BorderBrush="{DynamicResource ModCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,4,0,4">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0"
                       Text="{loc:Localize Updates.CurrentVersion}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       x:Name="CurrentVersionText"
                       Text="2.3.3-beta"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Przycisk -->
      <Button Grid.Row="2"
              x:Name="OkButton"
              Classes="ok-button"
              Content="{loc:Localize UI.Buttons.OK}"
              Width="180"
              Height="40"
              FontSize="14"
              FontWeight="SemiBold"
              Background="#10B981"
              BorderBrush="#059669"
              BorderThickness="1"
              CornerRadius="8"
              Foreground="White"
              HorizontalAlignment="Center"
              Margin="0,20,0,0"
              Click="OkButton_Click"
              Cursor="Hand">
      </Button>

    </Grid>
  </Border>
</Window>
