<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.ConfirmDialog"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<!-- E6: wspólny wzorzec (tytuł + zdanie + GOLD / outlined).
	     Generyczne potwierdzenie — semantykę akcji zna wywołujący (OkButtonText). -->
	<Grid Margin="24" RowDefinitions="Auto,*,Auto">

		<TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   Classes="modal-title"
                   Margin="0,0,0,12"/>

		<TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   Classes="modal-message"
                   VerticalAlignment="Center"/>

		<StackPanel Grid.Row="2" Classes="modal-actions" Margin="0,16,0,0">
			<Button x:Name="YesButton"
                    Classes="modal-primary"
                    Content="{loc:Localize UI.Buttons.Yes}"
                    IsDefault="True"
                    Click="YesButton_Click"/>
			<Button x:Name="NoButton"
                    Classes="modal-secondary"
                    Content="{loc:Localize UI.Buttons.No}"
                    IsCancel="True"
                    Click="NoButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
