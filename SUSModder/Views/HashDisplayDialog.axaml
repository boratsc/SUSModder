<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SUSModder.Views"
        xmlns:local="clr-namespace:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.HashDisplayDialog"
        x:DataType="views:HashDisplayDialog"
        Title="{local:Localize Tools.HashDisplay.WindowTitle}"
        Width="500" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">

		<!-- Ikona sukcesu i komunikat (E6) -->
		<StackPanel Grid.Row="0"
                    Spacing="12"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center">
			<Border Classes="modal-icon success">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Checkmark}"/>
			</Border>
			<TextBlock Text="{Binding Message}"
                       Classes="modal-title"/>
		</StackPanel>

		<!-- Instrukcja -->
		<TextBlock Grid.Row="1"
                   Text="{local:Localize Tools.HashDisplay.YourCodeLabel}"
                   FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,10"/>

		<!-- Hash z możliwością zaznaczenia -->
		<Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource AccentMutedBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20">
			<TextBox x:Name="HashTextBox"
                     Text="{Binding Hash}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="16"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource AccentBrush}"
                     SelectionBrush="{DynamicResource AccentBrush}"
                     SelectionForegroundBrush="White"/>
		</Border>

		<!-- Instrukcja dodatkowa -->
		<TextBlock Grid.Row="3"
                   Text="{local:Localize Tools.HashDisplay.ShareInstruction}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>

		<StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="15">
			<Button x:Name="CopyButton"
                    Classes="modal-primary"
                    Content="{local:Localize Tools.HashDisplay.CopyButton}"
                    IsDefault="True"
                    Click="OnCopyClick"/>
			<Button Content="{local:Localize Tools.HashDisplay.CloseButton}"
                    Classes="modal-secondary"
                    IsCancel="True"
                    Click="OnCloseClick"/>
		</StackPanel>
	</Grid>
</Window>
