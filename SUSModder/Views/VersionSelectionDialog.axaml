<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SUSModder.ViewModels"
        xmlns:models="clr-namespace:SUSModder.Core.Models;assembly=SUSModder.Core"
        x:DataType="vm:VersionSelectionViewModel"
        x:Class="SUSModder.Views.VersionSelectionDialog"
        Title="Wybór wersji moda"
        Width="600"
        Height="500"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource PrimaryBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Nagłówek -->
        <Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}" 
                CornerRadius="0"
                Height="80"
                Padding="20">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" 
                           Text="📦" 
                           FontSize="40" 
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
                <StackPanel Grid.Column="1" 
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModName}" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock FontSize="13" 
                               Foreground="#E0FFFFFF">
                        <Run Text="Obecna wersja: "/>
                        <Run Text="{Binding CurrentVersion}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Główna zawartość -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Ładowanie -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="15">
                <TextBlock Text="⏳" 
                           FontSize="48" 
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Pobieranie dostępnych wersji..." 
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Błąd -->
            <Border IsVisible="{Binding HasError}"
                    Background="#20FF0000"
                    BorderBrush="#FF6B6B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="400">
                <StackPanel Spacing="10">
                    <TextBlock Text="❌" 
                               FontSize="32" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Błąd"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Lista wersji -->
            <Grid IsVisible="{Binding !IsLoading}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek listy -->
                <TextBlock Grid.Row="0"
                           Text="Wybierz wersję do zainstalowania:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Przewijalna lista wersji -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Versions}"
                                      Margin="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ModVersionHistory">
                                    <Border Background="{DynamicResource ModCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource ModCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="5"
                                            Padding="12"
                                            Cursor="Hand"
                                            Tapped="Version_Tapped">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ModCardHoverBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="*">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="Wersja: "/>
                                                    <Run Text="{Binding ModVersion}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding AmongVersion, StringFormat='Among Us: {0}'}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FormattedDate}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Notes}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Stopka z przyciskami -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <!-- Wiersz 1: Info o wybranej wersji -->
                <StackPanel Grid.Row="0"
                            IsVisible="{Binding SelectedVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Margin="0,0,0,5">
                    <TextBlock Text="Wybrano:"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding SelectedVersion.DisplayText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Wiersz 2: Przyciski -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <!-- Przycisk Anuluj -->
                    <Button Grid.Column="0"
                            Content="Anuluj"
                            Command="{Binding CancelCommand}"
                            Width="120"
                            Height="40"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- Przycisk Instaluj -->
                    <Button Grid.Column="1"
                            Content="Instaluj wybraną wersję"
                            Command="{Binding ConfirmCommand}"
                            MinWidth="180"
                            Height="40"
                            Margin="10,0,0,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
