<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.RecommendedDiscordsPanel"
             x:CompileBindings="False">
	<!-- F3d: zakładka Discordy w kolumnie listy (wzorzec RolesPanel): własny nagłówek
	     (wspólny nagłówek kolumny jest ukryty), skeleton podczas ładowania, treść poniżej.
	     Szczegóły techniczne wiersza pod „Szczegóły" (Expander) — jedna akcja na problem. -->
	<Grid x:Name="Root" RowDefinitions="Auto,*">

		<!-- Nagłówek: tytuł + podtytuł (status ładowania, tłumaczony na żywo) -->
		<StackPanel Grid.Row="0" Margin="20,20,16,12" Spacing="4">
			<TextBlock Text="{loc:Localize RecommendedDiscords.Header}"
					   FontSize="22" FontWeight="SemiBold"
					   Foreground="{DynamicResource TextPrimaryBrush}"/>
			<TextBlock Text="{Binding StatusMessage}"
					   FontSize="12"
					   Foreground="{DynamicResource TextMutedBrush}"/>
		</StackPanel>

		<Panel Grid.Row="1">

			<!-- Loading: skeletony 68 px jak pozostałe listy -->
			<ScrollViewer Margin="10"
						  IsVisible="{Binding IsLoading}"
						  Background="Transparent">
				<StackPanel Spacing="8" Margin="0,4">
					<Border Classes="skeleton-card"/>
					<Border Classes="skeleton-card"/>
					<Border Classes="skeleton-card"/>
					<Border Classes="skeleton-card"/>
					<Border Classes="skeleton-card"/>
					<Border Classes="skeleton-card"/>
				</StackPanel>
			</ScrollViewer>

			<ScrollViewer IsVisible="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}">
				<StackPanel Spacing="12" Margin="10,0,10,10">
					<!-- F3e: banner na pełną szerokość kolumny. Obraz jako ImageBrush w Background
					     (background Border respektuje CornerRadius — ClipToBounds nie przycina do rogów
					     w Avalonia 12.1.4), avatar jako Ellipse z Fill=ImageBrush (geometria ucina rogi PNG).
					     Promień wewnętrzny 13 = 14 zewnętrzny minus 1 px obramowania. -->
					<Border Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource AccentBrush}"
							BorderThickness="1"
							CornerRadius="14">
						<Grid RowDefinitions="Auto,Auto">
							<Grid Grid.Row="0" Height="125">
								<Border CornerRadius="13,13,0,0">
									<Border.Background>
										<ImageBrush Source="avares://SUSModder/Assets/susmodder-hub-banner.png"
													Stretch="UniformToFill"
													Opacity="0.85"/>
									</Border.Background>
									<Border CornerRadius="13,13,0,0"
											Background="{DynamicResource SurfaceOverlayBrush}"/>
								</Border>

								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="16">
									<Ellipse Width="70" Height="70"
											 VerticalAlignment="Center"
											 Stroke="{DynamicResource TextPrimaryBrush}"
											 StrokeThickness="2">
										<Ellipse.Fill>
											<ImageBrush Source="avares://SUSModder/Assets/susmodder-hub-logo.png"
														Stretch="UniformToFill"/>
										</Ellipse.Fill>
									</Ellipse>

									<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Eyebrow}"
											   FontSize="12"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource AccentBrush}"/>
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Title}"
											   FontSize="24"
											   FontWeight="Bold"
											   Foreground="{DynamicResource TextPrimaryBrush}"/>
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Description}"
											   FontSize="13"
											   TextWrapping="Wrap"
											   MaxLines="2"
											   Foreground="{DynamicResource TextSecondaryBrush}"/>
									</StackPanel>
								</Grid>
							</Grid>

							<Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="16,14,16,16">
								<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
									<Border Background="{DynamicResource AccentBrush}" Opacity="0.95" CornerRadius="12" Padding="10,4" Margin="0,0,8,8">
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Tags.Support}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}"/>
									</Border>
									<Border Background="{DynamicResource AccentBrush}" Opacity="0.95" CornerRadius="12" Padding="10,4" Margin="0,0,8,8">
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Tags.Lobby}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}"/>
									</Border>
									<Border Background="{DynamicResource AccentBrush}" Opacity="0.95" CornerRadius="12" Padding="10,4" Margin="0,0,8,8">
										<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.Tags.ModdingChat}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}"/>
									</Border>
								</WrapPanel>

								<Button Grid.Column="1"
										Content="{loc:Localize RecommendedDiscords.OfficialHub.JoinButton}"
										Padding="18,8"
										CornerRadius="8"
										Background="{DynamicResource AccentBrush}"
										Foreground="{DynamicResource OnAccentTextBrush}"
										FontWeight="SemiBold"
										Command="{Binding OpenOfficialDiscordHubCommand}"
										AutomationProperties.Name="{loc:Localize RecommendedDiscords.OfficialHub.JoinButton}"/>
							</Grid>
						</Grid>
					</Border>

					<TextBlock Text="{loc:Localize RecommendedDiscords.OfficialHub.RecommendedServersHeading}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimaryBrush}"
							   Margin="0,4,0,0"/>

					<!-- F3b: lista wierszy + szczegóły (wzorzec RolesPanel / catalog-list 4.0).
					     Akcje zestawu reuse flow paczek; niedostępność = neutralna informacja, detale pod „Szczegóły". -->
					<ListBox Classes="catalog-list"
							 ItemsSource="{Binding DiscordServers}"
							 Background="Transparent"
							 BorderThickness="0"
							 ScrollViewer.VerticalScrollBarVisibility="Disabled">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:DiscordServerViewModel">
								<StackPanel Spacing="6">
									<Border Classes="catalog-row">
										<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
											<Border Grid.Column="0" Classes="catalog-row-icon">
												<Panel>
													<Image Source="{Binding IconBitmap}"
														   Width="44" Height="44" Stretch="UniformToFill"
														   IsVisible="{Binding HasIcon}"/>
													<ic:SymbolIcon Symbol="{x:Static fic:Symbol.PeopleTeam}" FontSize="22"
																   HorizontalAlignment="Center" VerticalAlignment="Center"
																   Foreground="{DynamicResource TextMutedBrush}"
																   IsVisible="{Binding HasIcon, Converter={x:Static BoolConverters.Not}}"/>
												</Panel>
											</Border>
											<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
												<TextBlock Classes="catalog-row-title" Text="{Binding Name}"/>
												<StackPanel Orientation="Horizontal" Spacing="6">
													<ic:SymbolIcon Symbol="{x:Static fic:Symbol.People}" FontSize="12"
																   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
													<TextBlock Classes="catalog-row-subtitle" Text="{Binding MemberCountDisplay}" VerticalAlignment="Center"/>
													<TextBlock Classes="catalog-row-subtitle" Text="·" IsVisible="{Binding HasPack}" VerticalAlignment="Center"/>
													<TextBlock Classes="catalog-row-subtitle" Text="{Binding PackSummary}" IsVisible="{Binding HasPack}" VerticalAlignment="Center"/>
												</StackPanel>
											</StackPanel>
											<Border Grid.Column="2" Classes="catalog-row-badge" IsVisible="{Binding ShowPackUnavailable}">
												<TextBlock Classes="catalog-row-badge-text" Text="{loc:Localize RecommendedDiscords.PackUnavailableShort}"/>
											</Border>
											<!-- F3g: badge aktualizacji paczki (ten sam pill co inne badge wiersza;
											     widoczny tylko gdy aktualizacja realna i możliwa — ShowPackUpdateBadge). -->
											<Border Grid.Column="2" Classes="catalog-row-badge" IsVisible="{Binding ShowPackUpdateBadge}">
												<TextBlock Classes="catalog-row-badge-text" Text="{loc:Localize UI.ModStatus.UpdateAvailable}"/>
											</Border>
											<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
												<TextBlock Classes="catalog-row-subtitle"
														   Text="{loc:Localize RecommendedDiscords.PackBusy}"
														   IsVisible="{Binding IsPackBusy}" VerticalAlignment="Center"/>
												<!-- F3f: identyczne przyciski jak w wierszach katalogu modów
																	(catalog-row-action: złoty „blik”, sam tekst). Tooltip akcji
																	zestawu mówi, czyj zestaw modów zostanie zainstalowany. -->
												<Button Classes="catalog-row-action"
														Content="{loc:Localize RecommendedDiscords.JoinButton}"
														Command="{Binding #Root.DataContext.OpenDiscordLinkCommand}"
														CommandParameter="{Binding InviteLink}"
														IsEnabled="{Binding !IsPackBusy}"
														AutomationProperties.Name="{loc:Localize RecommendedDiscords.JoinButton}"/>
												<Button Classes="catalog-row-action"
														Content="{loc:Localize RecommendedDiscords.InstallPack}"
														IsVisible="{Binding ShowInstallAction}"
														Command="{Binding #Root.DataContext.PackActionCommand}"
														CommandParameter="{Binding}"
														ToolTip.Tip="{Binding PackActionTooltip}"
														AutomationProperties.Name="{loc:Localize RecommendedDiscords.InstallPack}"/>
												<Button Classes="catalog-row-action"
														Content="{loc:Localize RecommendedDiscords.UpdatePack}"
														IsVisible="{Binding ShowUpdateAction}"
														Command="{Binding #Root.DataContext.PackActionCommand}"
														CommandParameter="{Binding}"
														ToolTip.Tip="{Binding PackActionTooltip}"
														AutomationProperties.Name="{loc:Localize RecommendedDiscords.UpdatePack}"/>
											</StackPanel>
										</Grid>
									</Border>
									<Expander Classes="modal-details"
											  Header="{loc:Localize UI.Inspector.Details}"
											  IsVisible="{Binding HasDetails}">
										<StackPanel Spacing="6">
											<TextBlock Text="{Binding Description}"
													   TextWrapping="Wrap" FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   IsVisible="{Binding HasDescription}"/>
											<!-- F3g: lista zmian paczki pod nagłówkiem (reuse klucza „Moje zestawy"). -->
											<StackPanel Spacing="4" IsVisible="{Binding HasPackUpdateChanges}">
												<TextBlock Classes="catalog-detail-techlabel" Text="{loc:Localize ModPacks.UpdateChanges}"/>
												<TextBlock Text="{Binding PackUpdateChangesText}"
														   TextWrapping="Wrap" FontSize="12"
														   Foreground="{DynamicResource TextSecondaryBrush}"/>
											</StackPanel>
											<TextBlock Text="{loc:Localize RecommendedDiscords.PackUnavailable}"
													   TextWrapping="Wrap" FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   IsVisible="{Binding ShowPackUnavailable}"/>
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowPackUnavailable}">
												<TextBlock Classes="catalog-detail-techlabel" Text="{loc:Localize RecommendedDiscords.VtStatusLabel}"/>
												<TextBlock Grid.Column="1" Classes="catalog-detail-techvalue" Text="{Binding VtStatusDisplay}"/>
											</Grid>
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowPackUnavailable}">
												<TextBlock Classes="catalog-detail-techlabel" Text="{loc:Localize ModPacks.PackCodeLabel}"/>
												<TextBlock Grid.Column="1" Classes="catalog-detail-techvalue" Text="{Binding PackCode}"/>
											</Grid>
										</StackPanel>
									</Expander>
									<Border Classes="catalog-row-separator"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</ScrollViewer>
		</Panel>
	</Grid>
</UserControl>
