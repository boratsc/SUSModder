<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:local="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.UpdateModConfirmDialog"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />
		
		<!-- Animacja fade-in dla całego okna -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		
		<!-- Animacja dla ikony aktualizacji -->
		<Style Selector="Border.update-icon">
			<Style.Animations>
				<Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="-20"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		
		<!-- Animacja dla contentu -->
		<Style Selector="StackPanel.content-panel">
			<Style.Animations>
				<Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="10"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		
		<!-- Hover effect dla przycisku aktualizacji -->
		<Style Selector="Button.update-button:pointerover">
			<Setter Property="Background" Value="#059669"/>
			<Setter Property="BorderBrush" Value="#047857"/>
		</Style>
		
		<Style Selector="Button.update-button:pressed">
			<Setter Property="Background" Value="#047857"/>
		</Style>
		
		<!-- Hover effect dla przycisku anuluj -->
		<Style Selector="Button.cancel-button:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
		</Style>
	</Window.Styles>

	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,30" RowDefinitions="Auto,Auto,Auto">

			<!-- Ikona aktualizacji z tłem -->
			<Border Grid.Row="0"
					Classes="update-icon"
					Width="80" Height="80"
					CornerRadius="40"
					Background="#2010B981"
					BorderBrush="#10B981"
					BorderThickness="2"
					HorizontalAlignment="Center"
					Margin="0,0,0,20">
				<Border.RenderTransform>
					<TranslateTransform/>
				</Border.RenderTransform>
				<TextBlock Text="🔄" 
						   FontSize="40"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
			</Border>

			<!-- Zawartość -->
			<StackPanel Grid.Row="1"
						Classes="content-panel"
						Spacing="12"
						MinHeight="150">
				<StackPanel.RenderTransform>
					<TranslateTransform/>
				</StackPanel.RenderTransform>
				
				<!-- Tytuł -->
				<TextBlock x:Name="TitleText"
						   FontSize="20" 
						   FontWeight="Bold"
						   Foreground="{DynamicResource TextPrimaryBrush}"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"/>

				<!-- Wiadomość główna -->
				<TextBlock x:Name="MessageText"
						   FontSize="14"
						   Foreground="{DynamicResource TextSecondaryBrush}"
						   TextWrapping="Wrap"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   MaxWidth="420"
						   Margin="0,0,0,8"/>
				
				<!-- Panel informacji o wersjach -->
				<Border Background="{DynamicResource ModCardBackgroundBrush}"
						BorderBrush="{DynamicResource ModCardBorderBrush}"
						BorderThickness="1"
						CornerRadius="8"
						Padding="16,12"
						Margin="0,4,0,4">
					<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">
						<!-- Obecna wersja moda -->
						<TextBlock Grid.Row="0" Grid.Column="0"
								   Text="{local:Localize Dialogs.UpdateMod.CurrentVersion}"
								   FontSize="13"
								   FontWeight="Medium"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   VerticalAlignment="Center"/>
						<TextBlock Grid.Row="0" Grid.Column="1"
								   x:Name="CurrentModVersionText"
								   FontSize="13"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextPrimaryBrush}"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Center"/>
						
						<!-- Nowa wersja moda -->
						<TextBlock Grid.Row="2" Grid.Column="0"
								   Text="{local:Localize Dialogs.UpdateMod.NewVersion}"
								   FontSize="13"
								   FontWeight="Medium"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   VerticalAlignment="Center"/>
						<TextBlock Grid.Row="2" Grid.Column="1"
								   x:Name="NewModVersionText"
								   FontSize="13"
								   FontWeight="SemiBold"
								   Foreground="#10B981"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Center"/>
						
						<!-- Wersja Among Us -->
						<TextBlock Grid.Row="4" Grid.Column="0"
								   Text="{local:Localize Dialogs.UpdateMod.AmongVersion}"
								   FontSize="13"
								   FontWeight="Medium"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   VerticalAlignment="Center"/>
						<TextBlock Grid.Row="4" Grid.Column="1"
								   x:Name="AmongVersionText"
								   FontSize="13"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextPrimaryBrush}"
								   HorizontalAlignment="Right"
								   VerticalAlignment="Center"/>
					</Grid>
				</Border>
				
				<!-- Info o rozmiarze do pobrania (opcjonalne) -->
				<Border x:Name="DownloadSizeInfoBorder"
						Background="{DynamicResource ModCardBackgroundBrush}"
						BorderBrush="{DynamicResource ModCardBorderBrush}"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12,8"
						Margin="0,0,0,0"
						HorizontalAlignment="Center"
						IsVisible="False">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="📥" FontSize="14"/>
						<TextBlock x:Name="DownloadSizeText"
								   FontSize="13"
								   Foreground="{DynamicResource TextSecondaryBrush}"/>
					</StackPanel>
				</Border>
			</StackPanel>

			<!-- Przyciski -->
			<StackPanel Grid.Row="2"
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						Spacing="12"
						Margin="0,20,0,0">
				<Button x:Name="CancelButton"
						Classes="cancel-button"
						Content="{local:Localize Dialogs.UpdateMod.CancelButton}"
						Width="160" Height="38"
						Background="{DynamicResource ModCardBackgroundBrush}"
						Foreground="{DynamicResource TextPrimaryBrush}"
						BorderBrush="{DynamicResource ModCardBorderBrush}"
						BorderThickness="2"
						CornerRadius="8"
						FontWeight="Medium"
						Click="CancelButton_Click"/>
				<Button x:Name="ConfirmButton"
						Classes="update-button"
						Content="{local:Localize Dialogs.UpdateMod.UpdateButton}"
						Width="160" Height="38"
						Background="#10B981"
						Foreground="White"
						BorderBrush="#059669"
						BorderThickness="2"
						CornerRadius="8"
						FontWeight="Bold"
						Click="ConfirmButton_Click">
					<i:Interaction.Behaviors>
						<behaviors:ShakeOnLoadBehavior 
							Intensity="6" 
							RepeatCount="2" 
							Delay="0:0:0.6" />
					</i:Interaction.Behaviors>
					<Button.RenderTransform>
						<TranslateTransform/>
					</Button.RenderTransform>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</Window>
