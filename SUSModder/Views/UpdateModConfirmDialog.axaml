<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:behaviors="using:SUSModder.Behaviors"
        xmlns:local="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.UpdateModConfirmDialog"
        Width="550" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<FluentTheme />

		<!-- Animacja fade-in dla całego okna -->
		<Style Selector="Window">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla ikony aktualizacji -->
		<Style Selector="Border.update-icon">
			<Style.Animations>
				<Animation Duration="0:0:0.5" FillMode="Forward" Delay="0:0:0.1">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="-20"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Animacja dla contentu -->
		<Style Selector="StackPanel.content-panel">
			<Style.Animations>
				<Animation Duration="0:0:0.4" FillMode="Forward" Delay="0:0:0.2">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
						<Setter Property="(TranslateTransform.Y)" Value="10"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
						<Setter Property="(TranslateTransform.Y)" Value="0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- Wiersze podsumowania aktualizacji (3.1-06) -->
		<Style Selector="TextBlock.preview-addon">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<Style Selector="TextBlock.preview-addon.attention">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
		</Style>
	</Window.Styles>

	<!-- E6 / makieta 10: ikona + tytuł + zdanie, GOLD „Aktualizuj” + outlined „Później”.
	     Wersje, rozmiar i podsumowanie DLL pod „Szczegóły”. -->
	<Border Margin="0,30,0,0">
		<Grid Margin="30,10,30,24" RowDefinitions="Auto,*,Auto">

			<Border Grid.Row="0"
					Classes="modal-icon update-icon"
					Margin="0,0,0,16">
				<Border.RenderTransform>
					<TranslateTransform/>
				</Border.RenderTransform>
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowSync}"/>
			</Border>

			<ScrollViewer Grid.Row="1"
						VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Disabled"
						MaxHeight="330">
				<StackPanel Classes="content-panel"
						Spacing="12"
						HorizontalAlignment="Stretch">
					<StackPanel.RenderTransform>
						<TranslateTransform/>
					</StackPanel.RenderTransform>

					<TextBlock x:Name="TitleText" Classes="modal-title"/>

					<TextBlock x:Name="MessageText"
							   Classes="modal-message"
							   MaxWidth="420"
							   Margin="0,0,0,4"/>

					<Expander Classes="modal-details" Header="{local:Localize UI.Inspector.Details}">
						<StackPanel Spacing="8" Margin="0,8,0,0">
							<!-- Panel informacji o wersjach -->
							<Border Classes="modal-info-row">
								<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">
									<TextBlock Grid.Row="0" Grid.Column="0"
											   Text="{local:Localize Dialogs.UpdateMod.CurrentVersion}"
											   FontSize="13"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   VerticalAlignment="Center"/>
									<TextBlock Grid.Row="0" Grid.Column="1"
											   x:Name="CurrentModVersionText"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource TextPrimaryBrush}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Center"/>

									<TextBlock Grid.Row="2" Grid.Column="0"
											   Text="{local:Localize Dialogs.UpdateMod.NewVersion}"
											   FontSize="13"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   VerticalAlignment="Center"/>
									<TextBlock Grid.Row="2" Grid.Column="1"
											   x:Name="NewModVersionText"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource AccentBrush}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Center"/>

									<TextBlock Grid.Row="4" Grid.Column="0"
											   Text="{local:Localize Dialogs.UpdateMod.AmongVersion}"
											   FontSize="13"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   VerticalAlignment="Center"/>
									<TextBlock Grid.Row="4" Grid.Column="1"
											   x:Name="AmongVersionText"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource TextPrimaryBrush}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Center"/>
								</Grid>
							</Border>

							<!-- Info o rozmiarze do pobrania (opcjonalne) -->
							<Border x:Name="DownloadSizeInfoBorder"
									Classes="modal-info-row"
									HorizontalAlignment="Stretch"
									IsVisible="False">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<ic:SymbolIcon Symbol="{x:Static fic:Symbol.ArrowDownload}" FontSize="14"
									               Foreground="{DynamicResource TextSecondaryBrush}"/>
									<TextBlock x:Name="DownloadSizeText"
											   FontSize="13"
											   Foreground="{DynamicResource TextSecondaryBrush}"/>
								</StackPanel>
							</Border>

							<!-- Podsumowanie aktualizacji (3.1-06): prognoza stanu dodatków DLL i konfiguracji.
								 Ukryte, dopóki nie ma kompletu kluczy lokalizacyjnych — bez tekstu nieprzetłumaczonego. -->
							<Border x:Name="PreviewBorder"
									Classes="modal-info-row"
									IsVisible="False">
								<StackPanel Spacing="8">
									<TextBlock x:Name="PreviewHeaderText"
											   FontSize="13"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource TextPrimaryBrush}"
											   TextWrapping="Wrap"/>
									<TextBlock x:Name="PreviewLoadingText"
											   FontSize="12"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   TextWrapping="Wrap"
											   IsVisible="False"/>
									<TextBlock x:Name="PreviewErrorText"
											   FontSize="12"
											   Foreground="{DynamicResource DangerBrush}"
											   TextWrapping="Wrap"
											   IsVisible="False"/>
									<TextBlock x:Name="PreviewAddonsHeaderText"
											   FontSize="12"
											   FontWeight="Medium"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   IsVisible="False"/>
									<StackPanel x:Name="PreviewAddonList"
											   Spacing="3"/>
									<TextBlock x:Name="PreviewConfigHeaderText"
											   FontSize="12"
											   FontWeight="Medium"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   Margin="0,4,0,0"
											   IsVisible="False"/>
									<TextBlock x:Name="PreviewConfigText"
											   FontSize="12"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   TextWrapping="Wrap"
											   IsVisible="False"/>
								</StackPanel>
							</Border>
						</StackPanel>
					</Expander>
				</StackPanel>
			</ScrollViewer>

			<StackPanel Grid.Row="2" Classes="modal-actions" Margin="0,16,0,0">
				<Button x:Name="ConfirmButton"
						Classes="modal-primary"
						Content="{local:Localize Dialogs.UpdateMod.UpdateButton}"
						IsDefault="True"
						Click="ConfirmButton_Click">
					<i:Interaction.Behaviors>
						<behaviors:ShakeOnLoadBehavior
							Intensity="6"
							RepeatCount="2"
							Delay="0:0:0.6" />
					</i:Interaction.Behaviors>
					<Button.RenderTransform>
						<TranslateTransform/>
					</Button.RenderTransform>
				</Button>
				<Button x:Name="CancelButton"
						Classes="modal-secondary"
						Content="{local:Localize Updates.NoLater}"
						IsCancel="True"
						Click="CancelButton_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>
