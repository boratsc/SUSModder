<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             x:Class="SUSModder.Views.AdditionalActionsPanel"
             x:DataType="vm:MainWindowViewModel">

	<ScrollViewer MaxWidth="300">
		<StackPanel Spacing="15">
			<TextBlock Text="{loc:Localize Tools.TownOfUsTools}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
			<Border Background="{DynamicResource ModCardBackgroundBrush}"
					BorderBrush="{DynamicResource ModCardBorderBrush}"
					BorderThickness="1"
					CornerRadius="8"
					Padding="15"
					Margin="0,0,0,20">
				<TextBlock Text="{loc:Localize Tools.TownOfUsDescription}"
						   FontSize="12" FontStyle="Italic"
						   Foreground="{DynamicResource TextSecondaryBrush}"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   TextWrapping="Wrap"/>
			</Border>
			<!-- Sekcja Konfiguracje ToU -->
			<StackPanel>
				<TextBlock Text="{loc:Localize Tools.Toolkit}"
		           FontSize="18" FontWeight="Bold"
		           Foreground="{DynamicResource TextPrimaryBrush}"
		           Margin="10,5,0,10"/>
				<Button Content="{loc:Localize Tools.SetLobbySize}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnLobbySetClick"/>
				<TextBlock Text="{loc:Localize Tools.TouConfigs}"
		           FontSize="18" FontWeight="Bold"
		           Foreground="{DynamicResource TextPrimaryBrush}"
		           Margin="10,5,0,10"/>
				<Button Content="{loc:Localize Tools.SaveConfigLocally}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnSaveLocalConfigClick"/>

				<Button Content="{loc:Localize Tools.LoadConfigLocally}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnLoadLocalConfigClick"/>

				<Button Content="{loc:Localize Tools.SaveConfigServer}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnSaveServerConfigClick"/>

				<Button Content="{loc:Localize Tools.LoadConfigServer}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnLoadServerConfigClick"/>

				<Button Content="{loc:Localize Tools.LoadConfigFromTxt}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5" Padding="10"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="OnLoadLocalTxtConfigClick"/>

				<Button Content="{loc:Localize Tools.ChangePresetNames}"
						HorizontalAlignment="Stretch"
						Margin="0,0,0,5" Padding="10"
						Background="{DynamicResource AccentBrush}"
						Foreground="White"
						Click="OnChangePresetNamesClick"/>

			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
