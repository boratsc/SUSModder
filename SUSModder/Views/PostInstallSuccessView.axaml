<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             x:Class="SUSModder.Views.PostInstallSuccessView"
             x:DataType="vm:PostInstallSuccessViewModel"
             Background="Transparent">

	<!-- E6 / makieta 08: ikona + tytuł + jedno zdanie z nazwą moda,
	     GOLD „Uruchom grę” + outlined „Zamknij”. Pozostałe akcje jako
	     drugorzędne wiersze; promocja Discord pod „Szczegóły”.
	     Fade-in zapewnia wrapper fade-in-panel w MainWindow. -->

	<StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center"
	            MaxWidth="520" Margin="30">

		<Border Classes="modal-icon">
			<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Checkmark}"/>
		</Border>

		<TextBlock Classes="modal-title" Text="{Binding Title}"/>

		<TextBlock Classes="modal-message" Text="{Binding TitleWithName}"/>

		<!-- Podpowiedź o DLL tylko dla modów z obsługą DLL (MessageNoDll pokrywa się ze zdaniem głównym) -->
		<TextBlock Classes="modal-message" FontSize="13"
		           Text="{Binding Message}"
		           IsVisible="{Binding SupportsDll}"/>

		<StackPanel Classes="modal-actions">
			<Button Classes="modal-primary" Command="{Binding LaunchCommand}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Play}" FontSize="16"
					               Foreground="{DynamicResource OnAccentTextBrush}"/>
					<TextBlock Text="{Binding LaunchButton}" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button Classes="modal-secondary"
			        Command="{Binding DismissCommand}"
			        Content="{loc:Localize UI.Window.Close}"/>
		</StackPanel>

		<!-- Drugorzędne akcje: DLL i changelog (nic nie znika) -->
		<StackPanel Classes="modal-actions">
			<Button Classes="modal-secondary"
			        Command="{Binding AddDllCommand}"
			        Content="{Binding AddDllButton}"
			        FontSize="13" Padding="14,8" MinWidth="0"/>
			<Button Classes="modal-secondary"
			        Command="{Binding ShowChangelogCommand}"
			        Content="{Binding ShowChangelogButton}"
			        FontSize="13" Padding="14,8" MinWidth="0"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
			<CheckBox IsChecked="{Binding AutoUpdateEnabled}"
			          IsVisible="{Binding IsAutoUpdateCheckboxVisible}"
			          FontSize="12"
			          Foreground="{DynamicResource TextSecondaryBrush}"
			          Content="{Binding AutoUpdateCheckbox}"/>
			<CheckBox IsChecked="{Binding DontShowAgain}"
			          FontSize="12"
			          Foreground="{DynamicResource TextSecondaryBrush}"
			          Content="{Binding DontShowAgainCheckbox}"/>
		</StackPanel>

		<Expander Classes="modal-details" Header="{loc:Localize UI.Inspector.Details}">
			<Border Classes="modal-info-row" Margin="0,8,0,0">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
					<StackPanel Spacing="3" VerticalAlignment="Center">
						<TextBlock Text="{Binding DiscordHubCtaTitle}"
						           FontSize="14" FontWeight="SemiBold"
						           Foreground="{DynamicResource TextPrimaryBrush}"
						           TextWrapping="Wrap"/>
						<TextBlock Text="{Binding DiscordHubCtaDescription}"
						           FontSize="12"
						           Foreground="{DynamicResource TextSecondaryBrush}"
						           TextWrapping="Wrap"/>
					</StackPanel>
					<Button Grid.Column="1"
					        Classes="modal-primary"
					        Content="{Binding DiscordHubCtaButton}"
					        Command="{Binding OpenDiscordHubCommand}"
					        FontSize="13" Padding="12,8" MinWidth="0"
					        VerticalAlignment="Center"/>
				</Grid>
			</Border>
		</Expander>

	</StackPanel>
</UserControl>
