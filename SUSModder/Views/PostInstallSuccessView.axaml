<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             x:Class="SUSModder.Views.PostInstallSuccessView"
             x:DataType="vm:PostInstallSuccessViewModel"
             Background="{DynamicResource CardBackgroundBrush}">

	<UserControl.Styles>
		<!-- Animacja fade-in wyłączona: poprzednia wersja używała
		     Selector="UserControl" bez pseudo-klasy, co powodowało
		     częściowo przezroczysty stan podczas zmiany IsVisible
		     i wizualne nachodzenie się dwóch modali w tym samym
		     kontenerze. Karta jest teraz zawsze w pełni widoczna,
		     a płynność przejścia zapewnia istniejący wrapper
		     fade-in-panel w MainWindow.axaml. -->

		<!-- Hover effect dla Launch -->
		<Style Selector="Button.primary-button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="Button.primary-button:pressed">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		</Style>

		<!-- Hover effect dla Add DLL -->
		<Style Selector="Button.secondary-button:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
		</Style>
	</UserControl.Styles>

	<StackPanel Spacing="20" VerticalAlignment="Center" Margin="30">

			<!-- Ikona sukcesu -->
			<Border HorizontalAlignment="Center">
				<TextBlock Text="✅" FontSize="48"/>
			</Border>

			<!-- Tytuł -->
			<TextBlock FontSize="22"
			           FontWeight="Bold"
			           Foreground="{DynamicResource TextPrimaryBrush}"
			           TextAlignment="Center"
			           TextWrapping="Wrap"
			           Text="{Binding TitleWithName}"/>

			<!-- Wiadomość -->
			<TextBlock FontSize="14"
			           Foreground="{DynamicResource TextSecondaryBrush}"
			           TextAlignment="Center"
			           TextWrapping="Wrap"
			           Margin="0,0,0,10"
			           Text="{Binding Message}"/>

		<Border Background="{DynamicResource ModCardBackgroundBrush}"
				BorderBrush="{DynamicResource AccentBrush}"
				BorderThickness="1"
				CornerRadius="10"
				Padding="14"
				MaxWidth="520"
				HorizontalAlignment="Center">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
				<StackPanel Spacing="3" VerticalAlignment="Center">
					<TextBlock Text="{Binding DiscordHubCtaTitle}"
							   FontSize="14"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimaryBrush}"
							   TextWrapping="Wrap"/>
					<TextBlock Text="{Binding DiscordHubCtaDescription}"
							   FontSize="12"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   TextWrapping="Wrap"/>
				</StackPanel>

				<Button Grid.Column="1"
						Content="{Binding DiscordHubCtaButton}"
						Command="{Binding OpenDiscordHubCommand}"
						Padding="12,8"
						CornerRadius="7"
						Background="{DynamicResource AccentBrush}"
						Foreground="White"
						FontWeight="SemiBold"
						VerticalAlignment="Center"/>
			</Grid>
		</Border>

			<!-- Przyciski -->
			<StackPanel Orientation="Horizontal"
			            HorizontalAlignment="Center"
			            Spacing="15">
				<Button Command="{Binding LaunchCommand}"
				        Classes="primary-button"
				        FontSize="16"
				        FontWeight="SemiBold"
				        Padding="20,12"
				        CornerRadius="8"
				        Background="{DynamicResource AccentBrush}"
				        Foreground="White"
				        BorderThickness="0"
				        Content="{Binding LaunchButton}"/>

				<Button Command="{Binding AddDllCommand}"
				        Classes="secondary-button"
				        FontSize="16"
				        FontWeight="SemiBold"
				        Padding="20,12"
				        CornerRadius="8"
				        Background="{DynamicResource SecondaryBackgroundBrush}"
				        BorderBrush="{DynamicResource AccentBrush}"
				        BorderThickness="1"
				        Foreground="{DynamicResource TextPrimaryBrush}"
				        Content="{Binding AddDllButton}"/>
			</StackPanel>

		<!-- Przycisk changeloga -->
		<Button Content="{Binding ShowChangelogButton}"
		        Classes="secondary-button"
		        FontSize="14"
		        Padding="15,8"
		        CornerRadius="6"
		        Background="Transparent"
		        BorderBrush="{DynamicResource BorderMediumBrush}"
		        BorderThickness="0.5"
		        Foreground="{DynamicResource TextSecondaryBrush}"
		        HorizontalAlignment="Center"
		        Command="{Binding ShowChangelogCommand}"/>

		<!-- Checkbox auto-aktualizacji -->
		<CheckBox IsChecked="{Binding AutoUpdateEnabled}"
		          IsVisible="{Binding IsAutoUpdateCheckboxVisible}"
		          HorizontalAlignment="Center"
		          FontSize="12"
		          Foreground="{DynamicResource TextSecondaryBrush}"
		          Content="{Binding AutoUpdateCheckbox}"/>

		<!-- Checkbox "Nie pokazuj więcej" -->
		<CheckBox IsChecked="{Binding DontShowAgain}"
		          HorizontalAlignment="Center"
		          FontSize="12"
		          Foreground="{DynamicResource TextSecondaryBrush}"
		          Content="{Binding DontShowAgainCheckbox}"/>

	</StackPanel>
</UserControl>
