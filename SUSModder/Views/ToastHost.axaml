<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:local="using:SUSModder.Views"
             x:Class="SUSModder.Views.ToastHost"
             x:DataType="vm:ToastService"
             IsVisible="{Binding HasActiveToasts}">
    <!-- E5: kotwica top-right pod dymkiem czatu (makiety 03/04); z-order nad wszystkim (ostatni w MainWindow). -->
    <Border Margin="0,66,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding ActiveToasts}"
                      Background="Transparent"
                      BorderThickness="0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"
                                Spacing="0"
                                Margin="0,0,0,8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToastNotification">
                    <local:ToastNotificationView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
