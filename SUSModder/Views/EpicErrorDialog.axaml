<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.EpicErrorDialog"
        x:DataType="vm:EpicErrorDialogViewModel"
        Title="{local:Localize Errors.EpicLaunchError.Title}"
        Width="640" Height="480"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nagłówek (E6: ikona danger + tytuł) -->
		<StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,15">
			<Border Classes="modal-icon danger">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Warning}"/>
			</Border>
			<TextBlock Text="{local:Localize Errors.EpicLaunchError.Header}"
                       Classes="modal-title"
                       TextWrapping="Wrap"/>
		</StackPanel>

		<!-- Log content -->
		<Border Grid.Row="1"
                Classes="modal-info-row"
                Padding="0"
                Margin="0,0,0,15">
			<ScrollViewer Classes="content-scroll">
				<TextBox Name="LogTextBox"
                         Text="{Binding LogContent}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Classes="log-textbox"
                         AcceptsReturn="True"
                         AcceptsTab="True"/>
			</ScrollViewer>
		</Border>

		<!-- Instrukcja -->
		<StackPanel Grid.Row="2" Margin="0,0,0,15">
			<TextBlock TextWrapping="Wrap" Classes="instruction-text">
				<Run Text="{local:Localize Errors.EpicLaunchError.InstructionPrefix}"/>
				<Run Text="{Binding ModName}" Classes="mod-name-highlight"/>
				<Run Text="{local:Localize Errors.EpicLaunchError.InstructionSuffix}"/>
			</TextBlock>
		</StackPanel>

		<!-- Przyciski -->
		<StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
			<Button Content="{local:Localize Errors.EpicLaunchError.CopyLogButton}"
                    Command="{Binding CopyLogCommand}"
                    Classes="modal-secondary"/>
			<Button Content="{local:Localize Errors.EpicLaunchError.CloseButton}"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"
                    IsCancel="True"
                    Classes="modal-primary"/>
		</StackPanel>
	</Grid>

	<Window.Styles>
		<Style Selector="ScrollViewer.content-scroll">
			<Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		</Style>

		<Style Selector="TextBox.log-textbox">
			<Setter Property="FontFamily" Value="Consolas, Monaco, 'Courier New', monospace"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<Style Selector="TextBox.log-textbox:focus">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="TextBlock.instruction-text">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="LineHeight" Value="18"/>
		</Style>

		<Style Selector="Run.mod-name-highlight">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
		</Style>
	</Window.Styles>
</Window>
