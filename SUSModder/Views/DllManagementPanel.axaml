<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             xmlns:local="using:SUSModder.Views"
             xmlns:loc="using:SUSModder.Services.Localization"
             xmlns:converters="using:SUSModder.Converters"
             x:Class="SUSModder.Views.DllManagementPanel"
             x:CompileBindings="False">
	<UserControl.Resources>
		<converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
	</UserControl.Resources>
	<Grid x:Name="Root">
		<!-- Panel modyfikacji DLL -->
		<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllModificationsVisible}">
			<Panel.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<Binding Path="IsDllModificationsVisible"/>
					<Binding Path="IsDllInstallDialogVisible" Converter="{x:Static BoolConverters.Not}"/>
				</MultiBinding>
			</Panel.IsVisible>

			<ScrollViewer Padding="0,0,10,0">
				<StackPanel>
					<!-- Lista modów DLL -->
					<ItemsControl ItemsSource="{Binding DllMods}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="{DynamicResource ModCardBackgroundBrush}"
										BorderBrush="{DynamicResource ModCardBorderBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Margin="0,0,0,10"
										Padding="15">
									<Grid ColumnDefinitions="Auto,*,Auto">
										<!-- Ikona -->
										<Image Grid.Column="0"
											   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
											   Width="48" Height="48"
											   Margin="0,0,15,0"/>

										<!-- Informacje -->
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="{Binding Name}"
													   FontSize="16" FontWeight="Bold"
													   Foreground="{DynamicResource TextPrimaryBrush}"/>
											<TextBlock Text="{Binding Description}"
													   FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextWrapping="Wrap"
													   MaxWidth="200"/>
											<TextBlock FontSize="11"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   Text="{Binding ModVersion, StringFormat='Wersja: {0}'}"/>
										</StackPanel>
										<!-- Przycisk wyboru -->
										<Button Grid.Column="2"
												Content="{loc:Localize UI.Buttons.Select}"
												Background="{DynamicResource AccentBrush}"
												Foreground="White"
												Padding="15,8"
												CornerRadius="6"
												FontSize="12"
												FontWeight="SemiBold"
												Command="{Binding #Root.DataContext.SelectDllModCommand}"
												CommandParameter="{Binding}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</Panel>

		<!-- Dialog instalacji/odinstalowania DLL -->
		<Panel Classes="fade-in-panel" IsVisible="{Binding IsDllInstallDialogVisible}">
			<Grid RowDefinitions="*,Auto">
				<ScrollViewer Grid.Row="0" Padding="0,0,10,0">
					<StackPanel>
					<Border Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="12"
							Margin="0,0,0,12">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Image Source="{Binding SelectedDllModPngFileName, Converter={StaticResource StringToBitmapConverter}, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
								   Width="32" Height="32"/>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="{Binding SelectedDllModName, FallbackValue=''}"
										   FontSize="15" FontWeight="SemiBold"
										   Foreground="{DynamicResource TextPrimaryBrush}"/>
								<TextBlock Text="{loc:Localize UI.DllManager.ManageInstallation}"
										   FontSize="11"
										   Foreground="{DynamicResource TextSecondaryBrush}"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Sekcja: Zainstaluj -->
					<Border Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="8"
							Margin="0,0,0,15"
							Padding="15"
							IsVisible="{Binding ModsWithoutDllInstalled.Count}">
						<StackPanel>
							<TextBlock Text="{loc:Localize UI.DllManager.InstallIn}"
									   FontSize="16" FontWeight="Bold"
									   Foreground="{DynamicResource AccentBrush}"
									   Margin="0,0,0,10"/>

							<ItemsControl ItemsSource="{Binding ModsWithoutDllInstalled}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="{DynamicResource SecondaryBackgroundBrush}"
												BorderBrush="{DynamicResource BorderBrush}"
												BorderThickness="1"
												CornerRadius="6"
												Margin="0,0,0,8"
												Padding="12">
											<Grid ColumnDefinitions="Auto,*,Auto">
												<!-- Ikona -->
												<Image Grid.Column="0"
													   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
													   Width="32" Height="32"
													   Margin="0,0,10,0"/>

												<!-- Informacje -->
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}"
															   FontSize="13" FontWeight="SemiBold"
															   Foreground="{DynamicResource TextPrimaryBrush}"/>
												</StackPanel>

												<!-- Przycisk Instaluj -->
												<Button Grid.Column="2"
														Content="{loc:Localize UI.Buttons.Install}"
														Background="{DynamicResource AccentBrush}"
														Foreground="White"
														Padding="10,5"
														CornerRadius="4"
														FontSize="11"
														FontWeight="SemiBold"
														Command="{Binding #Root.DataContext.InstallDllToModCommand}"
														CommandParameter="{Binding}"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- Sekcja: Odinstaluj -->
					<Border Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="8"
							Margin="0,0,0,15"
							Padding="15"
							IsVisible="{Binding ModsWithDllInstalled.Count}">
						<StackPanel>
							<TextBlock Text="{loc:Localize UI.DllManager.UninstallFrom}"
									   FontSize="16" FontWeight="Bold"
									   Foreground="{DynamicResource DangerBrush}"
									   Margin="0,0,0,10"/>

							<ItemsControl ItemsSource="{Binding ModsWithDllInstalled}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="{DynamicResource SecondaryBackgroundBrush}"
												BorderBrush="{DynamicResource BorderBrush}"
												BorderThickness="1"
												CornerRadius="6"
												Margin="0,0,0,8"
												Padding="12">
											<Grid ColumnDefinitions="Auto,*,Auto">
												<!-- Ikona -->
												<Image Grid.Column="0"
													   Source="{Binding PngFileName, Converter={StaticResource StringToBitmapConverter}}"
													   Width="32" Height="32"
													   Margin="0,0,10,0"/>

												<!-- Informacje -->
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}"
															   FontSize="13" FontWeight="SemiBold"
															   Foreground="{DynamicResource TextPrimaryBrush}"/>
												</StackPanel>

												<!-- Przycisk Usuń -->
												<Button Grid.Column="2"
														Content="{loc:Localize UI.Buttons.Delete}"
														Background="{DynamicResource DangerBrush}"
														Foreground="White"
														Padding="10,5"
														CornerRadius="4"
														FontSize="11"
														FontWeight="SemiBold"
														Command="{Binding #Root.DataContext.UninstallDllFromModCommand}"
														CommandParameter="{Binding}"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- Komunikat gdy brak modów -->
					<Border Background="{DynamicResource ModCardBackgroundBrush}"
							BorderBrush="{DynamicResource ModCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="8"
							Margin="0,0,0,15"
							Padding="20">
						<Border.IsVisible>
							<MultiBinding Converter="{x:Static BoolConverters.And}">
								<Binding Path="ModsWithDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
								<Binding Path="ModsWithoutDllInstalled.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
							</MultiBinding>
						</Border.IsVisible>

						<StackPanel HorizontalAlignment="Center">
							<TextBlock Text="🤷‍♂️"
									   FontSize="32"
									   HorizontalAlignment="Center"
									   Margin="0,0,0,10"/>
							<TextBlock Text="{loc:Localize UI.DllManager.NoModsInstalled}"
									   FontSize="14"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   TextAlignment="Center"/>
							<TextBlock Text="{loc:Localize UI.DllManager.InstallFullModFirst}"
									   FontSize="12"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   TextAlignment="Center"/>
						</StackPanel>
					</Border>

					</StackPanel>
				</ScrollViewer>

				<!-- Przycisk powrotu -->
				<Button Grid.Row="1"
						Content="{loc:Localize UI.DllManager.BackToList}"
						HorizontalAlignment="Center"
						Margin="0,10,0,0"
						Background="{DynamicResource ModCardBackgroundBrush}"
						Foreground="{DynamicResource TextPrimaryBrush}"
						BorderBrush="{DynamicResource ModCardBorderBrush}"
						BorderThickness="1"
						Padding="15,10"
						CornerRadius="6"
						Command="{Binding CloseDllDialogCommand}"/>
			</Grid>
		</Panel>
	</Grid>
</UserControl>
