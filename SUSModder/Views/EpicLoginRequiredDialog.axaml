<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SUSModder.Views.EpicLoginRequiredDialog"
        Title="Logowanie Epic Games"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Border CornerRadius="12"
            ClipToBounds="True"
            Background="#1A1A2E"
            BorderBrush="#FF6B35"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#FF6B35"
                            BlurRadius="20"
                            OffsetX="0"
                            OffsetY="0"
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto" Margin="30">

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                <!-- Warning Icon -->
                <TextBlock Text="⚠"
                          FontSize="36"
                          HorizontalAlignment="Center"
                          Foreground="#FF6B35"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Wymagane logowanie do Epic Games"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Epic Games login required"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="#AAAAAA"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Nie można potwierdzić zalogowania do konta Epic Games. Bez aktywnej sesji aplikacja nie będzie działać poprawnie w trybie Epic."
                          FontSize="13"
                          Foreground="#CCCCCC"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,0,0,8"/>
                <TextBlock Text="Could not verify Epic Games login. Without an active session the app will not work correctly in Epic mode."
                          FontSize="11"
                          Foreground="#888888"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          TextAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  Margin="10,12,10,0">

                <!-- Zaloguj się -->
                <Button Grid.Column="0"
                        Name="LoginButton"
                        Height="54"
                        HorizontalAlignment="Stretch"
                        Padding="8,6"
                        Background="#00AA6E"
                        BorderBrush="#00FFAA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand"
                        Classes="actionButton">
                    <Button.Styles>
                        <Style Selector="Button.actionButton:pointerover">
                            <Setter Property="Background" Value="#00CC88"/>
                        </Style>
                        <Style Selector="Button.actionButton:pressed">
                            <Setter Property="Background" Value="#009960"/>
                        </Style>
                    </Button.Styles>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Zaloguj się"
                                  FontSize="13"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Log in"
                                  FontSize="11"
                                  Foreground="#CCFFEE"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Zmień na Steam -->
                <Button Grid.Column="1"
                        Name="SwitchToSteamButton"
                        Height="54"
                        HorizontalAlignment="Stretch"
                        Padding="8,6"
                        Background="#2A2A3E"
                        BorderBrush="#00FFAA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand"
                        Classes="actionButton2">
                    <Button.Styles>
                        <Style Selector="Button.actionButton2:pointerover">
                            <Setter Property="Background" Value="#3A3A5E"/>
                        </Style>
                        <Style Selector="Button.actionButton2:pressed">
                            <Setter Property="Background" Value="#4A4A6E"/>
                        </Style>
                    </Button.Styles>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Zmień na Steam"
                                  FontSize="13"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Switch to Steam"
                                  FontSize="11"
                                  Foreground="#CCCCCC"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Zamknij -->
                <Button Grid.Column="2"
                        Name="CloseButton"
                        Height="54"
                        HorizontalAlignment="Stretch"
                        Padding="8,6"
                        Background="#3A1A1A"
                        BorderBrush="#FF4444"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand"
                        Classes="actionButton3">
                    <Button.Styles>
                        <Style Selector="Button.actionButton3:pointerover">
                            <Setter Property="Background" Value="#5A2A2A"/>
                        </Style>
                        <Style Selector="Button.actionButton3:pressed">
                            <Setter Property="Background" Value="#6A3A3A"/>
                        </Style>
                    </Button.Styles>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Zamknij"
                                  FontSize="13"
                                  FontWeight="Bold"
                                  Foreground="#FF8888"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Close"
                                  FontSize="11"
                                  Foreground="#FF6666"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
