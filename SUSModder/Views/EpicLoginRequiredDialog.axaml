<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.EpicLoginRequiredDialog"
        Title="{loc:Localize Dialogs.EpicLoginRequired.Title}"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <!-- E6: karta wg wspólnego wzorca (bez neonu). GOLD logowanie + outlined alternatywy. -->
    <Border Classes="modal-card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto" Margin="30">

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,16" Spacing="12">
                <Border Classes="modal-icon danger">
                    <ic:SymbolIcon Symbol="{x:Static fic:Symbol.Warning}"/>
                </Border>

                <TextBlock Text="{loc:Localize Dialogs.EpicLoginRequired.Header}"
                          Classes="modal-title"
                          MaxWidth="460"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="{loc:Localize Dialogs.EpicLoginRequired.Message}"
                          Classes="modal-message"/>
            </StackPanel>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  Margin="10,12,10,0">

                <Button Grid.Column="0"
                        Name="LoginButton"
                        HorizontalAlignment="Stretch"
                        Classes="modal-primary"
                        Content="{loc:Localize Dialogs.EpicLoginRequired.LoginButton}"/>

                <Button Grid.Column="1"
                        Name="SwitchToSteamButton"
                        HorizontalAlignment="Stretch"
                        Classes="modal-secondary"
                        Content="{loc:Localize Dialogs.EpicLoginRequired.SwitchToSteamButton}"/>

                <Button Grid.Column="2"
                        Name="CloseButton"
                        HorizontalAlignment="Stretch"
                        Classes="modal-secondary"
                        IsCancel="True"
                        Content="{loc:Localize Dialogs.EpicLoginRequired.CloseButton}"/>
            </Grid>

        </Grid>
    </Border>
</Window>
