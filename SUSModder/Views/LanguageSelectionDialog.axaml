<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SUSModder.ViewModels"
        xmlns:local="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.LanguageSelectionDialog"
        x:DataType="vm:LanguageSelectionViewModel"
        Title="{local:Localize LanguageSelection.WindowTitle}"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <!-- E6: karta wg wspólnego wzorca (bez neonu). Dialog przed wyborem języka,
         więc nagłówek i stopka pozostają dwujęzyczne (PL + EN). -->
    <Border Classes="modal-card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto" Margin="30">
            <!-- Header with bilingual text -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
                <TextBlock Text="Wybierz język"
                          FontSize="22"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Choose language"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Language Selection Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,20,*" HorizontalAlignment="Center">
                <!-- Polish Button -->
                <Button Grid.Column="0"
                        Width="180"
                        Height="170"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Command="{Binding SelectPolishCommand}"
                        Cursor="Hand"
                        Classes="languageButton">
                    <Button.Styles>
                        <Style Selector="Button.languageButton:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                        </Style>
                        <Style Selector="Button.languageButton:pressed">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style Selector="Button.languageButton:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Styles>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- Polish Flag -->
                        <Border Width="120"
                                Height="80"
                                CornerRadius="8"
                                ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="*,*">
                                <Rectangle Grid.Row="0" Fill="White"/>
                                <Rectangle Grid.Row="1" Fill="#DC143C"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Polski"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- English Button -->
                <Button Grid.Column="2"
                        Width="180"
                        Height="170"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Command="{Binding SelectEnglishCommand}"
                        Cursor="Hand"
                        Classes="languageButton">
                    <Button.Styles>
                        <Style Selector="Button.languageButton:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}"/>
                        </Style>
                        <Style Selector="Button.languageButton:pressed">
                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style Selector="Button.languageButton:focus">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Style>
                    </Button.Styles>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                        <!-- UK Flag -->
                        <Border Width="120"
                                Height="80"
                                CornerRadius="8"
                                ClipToBounds="True"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <!-- Blue background -->
                                <Rectangle Fill="#012169"/>

                                <!-- White diagonals -->
                                <Path Fill="White"
                                      Data="M 0,0 L 120,80 M 120,0 L 0,80"
                                      StrokeThickness="20"
                                      Stroke="White"/>

                                <!-- Red diagonals -->
                                <Path Fill="#C8102E"
                                      Data="M 0,0 L 120,80 M 120,0 L 0,80"
                                      StrokeThickness="12"
                                      Stroke="#C8102E"/>

                                <!-- White cross -->
                                <Rectangle Fill="White" Width="120" Height="20" VerticalAlignment="Center"/>
                                <Rectangle Fill="White" Width="20" Height="80" HorizontalAlignment="Center"/>

                                <!-- Red cross -->
                                <Rectangle Fill="#C8102E" Width="120" Height="12" VerticalAlignment="Center"/>
                                <Rectangle Fill="#C8102E" Width="12" Height="80" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="English"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Footer text -->
            <TextBlock Grid.Row="2"
                      Text="Możesz zmienić język później w ustawieniach / You can change language later in settings"
                      FontSize="11"
                      Foreground="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>
