<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SUSModder.Services.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="SUSModder.Views.SUStatsConfirmDialog"
        Title="{local:Localize SUStatsConfirm.WindowTitle}"
        Width="600" Height="355"
        MinWidth="550" MinHeight="325"
        MaxWidth="700" MaxHeight="425"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        Icon="/Assets/icon.ico">

	<!-- E6: wspólny wzorzec (ikona + tytuł + zdanie; GOLD / DANGER / outlined). -->
	<Border Background="{DynamicResource WindowBackgroundBrush}" Padding="25">
		<StackPanel Spacing="16">

			<Border Classes="modal-icon">
				<ic:SymbolIcon Symbol="{x:Static fic:Symbol.Info}"/>
			</Border>

			<TextBlock Text="{local:Localize SUStatsConfirm.Header}" Classes="modal-title"/>
			<TextBlock Text="{local:Localize SUStatsConfirm.Subtitle}" Classes="modal-message"/>

			<!-- Treść pytania -->
			<StackPanel Spacing="10">
				<TextBlock Text="{local:Localize SUStatsConfirm.DetectedConfig}"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"/>

				<Border Classes="modal-info-row" HorizontalAlignment="Center" MinWidth="280">
					<TextBlock x:Name="ServerNameText"
                               Text="[Nazwa serwera]"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextAlignment="Center"/>
				</Border>

				<TextBlock Text="{local:Localize SUStatsConfirm.Question}"
                           Classes="modal-message"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
			</StackPanel>

			<!-- Przyciski - wyśrodkowane -->
			<StackPanel Classes="modal-actions" Margin="0,6,0,0">
				<Button Content="{local:Localize SUStatsConfirm.YesButton}"
                        Classes="modal-primary"
                        Click="YesButton_Click"/>
				<Button Content="{local:Localize SUStatsConfirm.NoButton}"
                        Classes="modal-danger"
                        Click="NoButton_Click"/>
				<Button Content="{local:Localize SUStatsConfirm.CancelButton}"
                        Classes="modal-secondary"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
