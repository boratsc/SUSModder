<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SUSModder.ViewModels"
             x:Class="SUSModder.Views.ModPackResultView"
             x:DataType="vm:ModPackResultViewModel"
             Background="{DynamicResource CardBackgroundBrush}">

	<UserControl.Styles>
		<Style Selector="UserControl">
			<Style.Animations>
				<Animation Duration="0:0:0.3" FillMode="Forward">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>

	<Grid Margin="24" RowDefinitions="Auto,Auto,Auto">
		<StackPanel Grid.Row="0" Spacing="8">
			<TextBlock Text="{Binding PackCodeLabel}" FontWeight="SemiBold"/>
			<TextBox Text="{Binding PackCode}" IsReadOnly="True" FontSize="16"/>
			<TextBlock Text="{Binding ShareLinkLabel}" FontWeight="SemiBold"/>
			<TextBox Text="{Binding ShareUrl}" IsReadOnly="True"/>
		</StackPanel>

		<StackPanel Grid.Row="1"
		            Orientation="Horizontal"
		            HorizontalAlignment="Center"
		            Spacing="10"
		            Margin="0,16,0,0">
			<Button Content="{Binding CopyCodeButton}" Command="{Binding CopyCodeCommand}"/>
			<Button Content="{Binding CopyLinkButton}" Command="{Binding CopyLinkCommand}"/>
		</StackPanel>

		<Button Grid.Row="2"
		        Content="{Binding CloseButton}"
		        HorizontalAlignment="Center"
		        MinWidth="120"
		        Margin="0,20,0,0"
		        Padding="16,10"
		        CornerRadius="8"
		        Background="{DynamicResource AccentBrush}"
		        Foreground="White"
		        BorderThickness="0"
		        Command="{Binding CloseCommand}"/>
	</Grid>
</UserControl>
