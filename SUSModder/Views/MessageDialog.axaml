<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SUSModder.Services.Localization"
        x:Class="SUSModder.Views.MessageDialog"
        Width="380" Height="210"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

	<Window.Styles>
		<FluentTheme />
	</Window.Styles>

	<!-- E6: wspólny wzorzec komunikatu (zdanie + GOLD OK). -->
	<StackPanel Margin="24" Spacing="15" VerticalAlignment="Center">
		<TextBlock x:Name="MessageText"
                   Classes="modal-message"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

		<Button Classes="modal-primary"
                Content="{loc:Localize UI.Buttons.OK}"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Margin="0,10,0,0"
                Click="OkButton_Click"/>
	</StackPanel>
</Window>
