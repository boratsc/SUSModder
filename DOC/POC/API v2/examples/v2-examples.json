{
  "description": "Example payloads for SUSModder API v2 endpoints. No real tokens or secrets.",
  "examples": {
    "GET /api/v2/catalog": {
      "request": "GET /api/v2/catalog?modType=full&offset=0&limit=50",
      "response": {
        "data": [
          {
            "id": 1,
            "name": "Town of Us",
            "type": "full",
            "currentVersion": "5.4.0",
            "description": "The original Among Us mod with 50+ roles",
            "iconUrl": "/icons/tou.png",
            "installPath": "BepInEx/plugins/",
            "gitHubProjectUrl": "https://github.com/townofus/TownOfUs",
            "lastUpdated": "2026-06-01T12:00:00Z",
            "amongVersion": {
              "dbValue": "2026-3-31",
              "label": "2026-3-31",
              "releaseDate": "2026-03-31"
            }
          }
        ],
        "meta": {
          "total": 42,
          "offset": 0,
          "limit": 50
        }
      }
    },
    "GET /api/v2/catalog-meta": {
      "request": "GET /api/v2/catalog-meta",
      "response": {
        "data": {
          "catalogRevision": "2026-06-05T12:00:00.000Z",
          "compatibilityRevision": "2026-06-05T11:45:00.000Z",
          "versionsRevision": "2026-05-20T08:00:00.000Z",
          "serverTimeUtc": "2026-06-05T12:30:00.000Z"
        }
      }
    },
    "error: VALIDATION_ERROR": {
      "response": {
        "error": {
          "code": "VALIDATION_ERROR",
          "message": "Invalid request parameters",
          "details": [
            { "field": "modId", "message": "must be a positive integer" }
          ]
        }
      }
    },
    "error: UNAUTHORIZED": {
      "response": {
        "error": {
          "code": "UNAUTHORIZED",
          "message": "Valid bearer token required"
        }
      }
    },
    "error: NOT_FOUND": {
      "response": {
        "error": {
          "code": "NOT_FOUND",
          "message": "Mod with id 999 not found"
        }
      }
    },
    "error: RATE_LIMITED": {
      "response": {
        "error": {
          "code": "RATE_LIMITED",
          "message": "Too many requests",
          "details": { "retryAfter": 60 }
        }
      },
      "headers": {
        "Retry-After": "60"
      }
    }
  }
}
