# Normalize line endings
* text=auto

# C# project files
*.cs text diff=csharp
*.csproj text
*.sln text

# Avalonia UI
*.axaml text

# Configuration
*.json text
*.xml text
*.config text

# Scripts
*.ps1 text eol=crlf
*.sh text eol=lf

# Docs
*.md text
*.txt text

# Binary files
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.7z binary

# Build artifacts
bin/ -text
obj/ -text
