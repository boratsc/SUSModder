{
  // VS Code tasks to build, clean, and run the solution
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Debug",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SUSModder.sln",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build Release",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SUSModder.sln",
        "-c",
        "Release",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "rebuild Debug",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SUSModder.sln",
        "-c",
        "Debug",
        "--no-incremental",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/SUSModder.sln"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "publish App (Release)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/Updater/Updater.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "publish SUSModder (Release)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/SUSModder/SUSModder.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": ["$msCompile"]
    }
  ]
}
